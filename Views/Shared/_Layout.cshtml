@{
    string activeModule = ViewData["ActiveModule"]?.ToString() ?? "dashboard";
    string userName = ViewData["UserName"]?.ToString() ?? "Admin Usuario";
    string userRole = ViewData["UserRole"]?.ToString() ?? "Coordinador TI";
    string userInitials = string.Join("", userName.Split(' ').Take(2).Select(s => s[0].ToString().ToUpper()));
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMT — @ViewData["Title"]</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --navy:          #002366;
            --navy-dark:     #001540;
            --accent:        #4a90d9;
            --accent-bright: #5ba3f5;
            --bg:            #f0f3f8;
            --bg-card:       #ffffff;
            --sidebar-w:     260px;
            --navbar-h:      64px;
            --text-primary:  #0d1b3e;
            --text-secondary:#4a5568;
            --text-muted:    #8492a6;
            --border:        #e2e8f0;
            --shadow-sm:     0 1px 3px rgba(0,35,102,.07);
            --radius:        12px;
            --radius-sm:     8px;
            --transition:    all .22s cubic-bezier(.4,0,.2,1);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg);
            color: var(--text-primary);
            font-size: 14px;
            overflow-x: hidden;
        }

        /* Sidebar Styles */
        .gmt-sidebar {
            width: var(--sidebar-w);
            height: 100vh;
            position: fixed;
            top: 0; left: 0;
            background: var(--navy-dark);
            display: flex;
            flex-direction: column;
            z-index: 1000;
            transition: var(--transition);
        }

        .sidebar-brand {
            padding: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: #fff;
        }

        .brand-icon {
            width: 38px; height: 38px;
            background: var(--accent);
            border-radius: var(--radius-sm);
            display: flex; align-items: center; justify-content: center;
            font-size: 20px;
        }

        .brand-name { font-weight: 800; font-size: 20px; letter-spacing: 1px; }
        .brand-sub { display: block; font-size: 10px; opacity: .6; text-transform: uppercase; }

        .sidebar-nav { flex: 1; padding: 0 12px; overflow-y: auto; }
        .nav-section-label {
            padding: 20px 16px 8px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            color: rgba(255,255,255,.3);
            letter-spacing: 1px;
        }

        .nav-link-gmt {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            color: rgba(255,255,255,.7);
            text-decoration: none;
            border-radius: var(--radius-sm);
            transition: var(--transition);
            margin-bottom: 4px;
        }

        .nav-link-gmt:hover, .nav-link-gmt.active {
            background: rgba(255,255,255,.08);
            color: #fff;
        }

        .nav-link-gmt.active { background: var(--accent); }

        .nav-icon { width: 20px; text-align: center; font-size: 16px; }

        .nav-collapse { padding-left: 12px; margin-bottom: 10px; }
        .nav-sub-link {
            display: block;
            padding: 8px 16px 8px 32px;
            color: rgba(255,255,255,.5);
            text-decoration: none;
            font-size: 13px;
            transition: var(--transition);
        }
        .nav-sub-link:hover { color: #fff; }

        .nav-badge {
            margin-left: auto;
            background: #e74c3c;
            color: #fff;
            font-size: 10px;
            padding: 2px 7px;
            border-radius: 10px;
            font-weight: 700;
        }

        /* Navbar Styles */
        .gmt-navbar {
            position: fixed;
            top: 0; left: var(--sidebar-w); right: 0;
            height: var(--navbar-h);
            background: #fff;
            display: flex;
            align-items: center;
            padding: 0 24px;
            z-index: 900;
            border-bottom: 1px solid var(--border);
        }

        .navbar-search { flex: 1; max-width: 400px; position: relative; }
        .search-input {
            width: 100%;
            padding: 8px 16px 8px 38px;
            background: var(--bg);
            border: none;
            border-radius: 20px;
            font-size: 13px;
        }
        .search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); }

        .navbar-actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
        .action-btn {
            width: 38px; height: 38px;
            border-radius: 50%;
            border: none; background: transparent;
            color: var(--text-secondary);
            position: relative;
        }
        .action-btn:hover { background: var(--bg); }
        .notif-dot {
            position: absolute; top: 10px; right: 10px;
            width: 8px; height: 8px; background: #e74c3c;
            border: 2px solid #fff; border-radius: 50%;
        }

        .profile-area {
            display: flex; align-items: center; gap: 10px;
            padding: 6px 12px; border-radius: 30px; cursor: pointer;
        }
        .profile-area:hover { background: var(--bg); }
        .user-avatar {
            width: 32px; height: 32px; background: var(--navy);
            color: #fff; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 12px;
        }

        .gmt-main { margin-left: var(--sidebar-w); margin-top: var(--navbar-h); padding: 30px; }

        @@media (max-width: 991px) {
            .gmt-sidebar { transform: translateX(-100%); }
            .gmt-navbar, .gmt-main { left: 0; margin-left: 0; }
            .gmt-sidebar.open { transform: translateX(0); }
        }
    </style>

    <!-- ESTA LÍNEA ES VITAL PARA EL ERROR DE STYLES -->
    @RenderSection("Styles", required: false)

</head>
<body>

    <!-- ═══ SIDEBAR ═══ -->
    <aside class="gmt-sidebar" id="gmtSidebar">
        <div class="sidebar-brand">
            <div class="brand-icon"><i class="fas fa-layer-group"></i></div>
            <div class="brand-text">
                <span class="brand-name">GMT</span>
                <span class="brand-sub">Gestor Modular</span>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section-label">Principal</div>
            <div class="nav-item">
                <a href="/Dashboard/Alumno" class="nav-link-gmt @(activeModule == "dashboard" ? "active" : "")">
                    <span class="nav-icon"><i class="fas fa-chart-line"></i></span>
                    <span>Dashboard</span>
                </a>
            </div>

            <div class="nav-section-label">Módulos</div>

            <div class="nav-item">
                <a href="#vinculacionMenu" class="nav-link-gmt @(activeModule == "vinculacion" ? "active" : "")" 
                   data-bs-toggle="collapse" aria-expanded="false">
                    <span class="nav-icon"><i class="fas fa-handshake"></i></span>
                    <span>Vinculación</span>
                    <i class="fas fa-chevron-down ms-auto" style="font-size:10px; opacity:.5;"></i>
                </a>
                <div class="collapse nav-collapse" id="vinculacionMenu">
                    <a href="#" class="nav-sub-link">Residencias Profesionales</a>
                    <a href="#" class="nav-sub-link">Servicio Social</a>
                </div>
            </div>

            <div class="nav-item">
                <a href="#" class="nav-link-gmt">
                    <span class="nav-icon"><i class="fas fa-graduation-cap"></i></span>
                    <span>Titulación</span>
                    <span class="nav-badge">3</span>
                </a>
            </div>

            <div class="nav-item">
                <a href="/Dashboard/Peticiones" class="nav-link-gmt">
                    <span class="nav-icon"><i class="fas fa-file-circle-plus"></i></span>
                    <span>Peticiones</span>
                </a>
            </div>

            <div class="nav-item">
                <a href="/Dashboard/PerfilAcademico" class="nav-link-gmt">
                    <span class="nav-icon"><i class="fas fa-user-graduate"></i></span>
                    <span>Perfil Académico</span>
                </a>
            </div>

            <div class="nav-item" style="margin-top: 10px; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 10px;">
                <a href="#" class="nav-link-gmt">
                    <span class="nav-icon"><i class="fas fa-sliders"></i></span>
                    <span>Configuración</span>
                </a>
            </div>
        </nav>

        <div class="sidebar-footer" style="padding: 20px; border-top: 1px solid rgba(255,255,255,0.08);">
            <div class="d-flex align-items-center gap-2">
                <div class="user-avatar" style="width:30px; height:30px; font-size:10px;">@userInitials</div>
                <div class="overflow-hidden">
                    <div style="color:#fff; font-size:12px; font-weight:600; white-space:nowrap; text-overflow:ellipsis;">@userName</div>
                    <div style="color:rgba(255,255,255,0.4); font-size:10px;">@userRole</div>
                </div>
            </div>
        </div>
    </aside>

    <!-- ═══ NAVBAR ═══ -->
    <header class="gmt-navbar">
        <button class="navbar-toggle d-lg-none btn" id="sidebarToggle"><i class="fas fa-bars"></i></button>

        <div class="navbar-search">
            <i class="fas fa-search search-icon"></i>
            <input type="text" class="search-input" placeholder="Buscar expediente, alumno…" />
        </div>

        <div class="navbar-actions">
            <button class="action-btn" title="Notificaciones">
                <i class="fas fa-bell"></i>
                <span class="notif-dot"></span>
            </button>
            
            <div style="width:1px; height:24px; background:var(--border); margin:0 8px;"></div>

            <div class="profile-area">
                <div class="user-avatar">@userInitials</div>
                <div class="d-none d-md-block">
                    <div class="profile-name" style="font-size:13px; font-weight:600;">@userName</div>
                    <div class="profile-role" style="font-size:11px; color:var(--text-muted);">@userRole</div>
                </div>
                <i class="fas fa-chevron-down ms-1" style="font-size:10px; color:var(--text-muted);"></i>
            </div>
        </div>
    </header>

    <!-- ═══ MAIN CONTENT ═══ -->
    <main class="gmt-main">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ESTA LÍNEA ES VITAL PARA EL ERROR DE SCRIPTS[cite: 14] -->
    @RenderSection("Scripts", required: false)

</body>
</html>