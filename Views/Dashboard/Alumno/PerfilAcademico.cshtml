@using GMT.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"]        = "Perfil Académico";
    ViewData["ActiveModule"] = "perfil";

    var alumno    = ViewBag.Alumno    as Alumno;
    var documentos = ViewBag.Documentos as List<DocumentoAlumno> ?? new();

    if (alumno != null)
    {
        ViewData["UserName"] = alumno.NombreCompleto ?? alumno.Login?.CorreoInstitucional ?? "Alumno";
        ViewData["UserRole"] = $"Alumno · {alumno.Carrera ?? "—"}";
    }

    string initials  = string.Join("", (alumno?.NombreCompleto ?? "AL").Split(' ').Take(2).Select(s => s.Length > 0 ? s[0].ToString().ToUpper() : ""));
    int    alumnoId  = alumno?.Id ?? 0;

    var docCv          = documentos.FirstOrDefault(d => d.TipoDocumento == "cv");
    var docConstancia  = documentos.FirstOrDefault(d => d.TipoDocumento == "constancia_estudios");
}

@section Styles {
<style>
    /* ─── Profile Hero ────────────────────────────────── */
    .profile-hero {
        background: var(--bg-card); border-radius: var(--radius);
        border: 1px solid var(--border); box-shadow: var(--shadow-sm);
        padding: 32px; display: flex; align-items: center;
        gap: 28px; position: relative; overflow: hidden;
    }
    .profile-hero::before {
        content: ''; position: absolute; top: 0; left: 0; right: 0;
        height: 4px; background: linear-gradient(90deg, var(--navy), var(--accent));
    }

    .profile-avatar-wrap { position: relative; flex-shrink: 0; }
    .profile-avatar-lg {
        width: 100px; height: 100px; border-radius: 50%;
        background: linear-gradient(135deg, var(--navy), var(--accent));
        display: flex; align-items: center; justify-content: center;
        font-size: 36px; font-weight: 800; color: #fff;
        box-shadow: 0 6px 24px rgba(0,35,102,.2); overflow: hidden;
        cursor: pointer; border: 3px solid #fff;
        outline: 3px solid var(--accent); transition: var(--transition);
    }
    .profile-avatar-lg img { width: 100%; height: 100%; object-fit: cover; }
    .profile-avatar-lg:hover { opacity: .85; }

    .avatar-edit-btn {
        position: absolute; bottom: 2px; right: 2px;
        width: 28px; height: 28px; background: var(--accent);
        border-radius: 50%; border: 2px solid #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 11px; color: #fff; cursor: pointer; transition: var(--transition);
    }
    .avatar-edit-btn:hover { background: var(--navy); }

    .profile-name-lg { font-size: 22px; font-weight: 800; color: var(--text-primary); margin-bottom: 4px; }
    .profile-meta { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 10px; }
    .meta-item { display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--text-muted); }
    .meta-item i { color: var(--accent); font-size: 12px; width: 14px; text-align: center; }
    .hero-badge {
        padding: 5px 14px; border-radius: 20px; font-size: 12px; font-weight: 700;
        background: #dcfce7; color: #16a34a; display: inline-flex;
        align-items: center; gap: 5px; margin-top: 10px;
    }
    .hero-badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #22c55e; }

    /* ─── Info Cards ──────────────────────────────────── */
    .info-card { background: var(--bg-card); border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow-sm); overflow: hidden; transition: var(--transition); }
    .info-card:hover { box-shadow: var(--shadow-md); }
    .info-card-header { padding: 16px 22px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px; background: var(--bg); }
    .info-card-header-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 13px; background: rgba(0,35,102,.08); color: var(--navy); }
    .info-card-title { font-size: 13.5px; font-weight: 700; color: var(--text-primary); }
    .info-card-body { padding: 20px 22px; }
    .data-row { display: flex; align-items: flex-start; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--border); }
    .data-row:last-child { border-bottom: none; padding-bottom: 0; }
    .data-row:first-child { padding-top: 0; }
    .data-label { font-size: 11.5px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: .4px; min-width: 130px; flex-shrink: 0; margin-top: 2px; }
    .data-value { font-size: 13.5px; color: var(--text-primary); font-weight: 500; flex: 1; }

    /* ─── Documentos ──────────────────────────────────── */
    .drop-zone {
        border: 2px dashed var(--border); border-radius: var(--radius);
        padding: 36px 24px; text-align: center; cursor: pointer;
        transition: var(--transition); background: var(--bg);
    }
    .drop-zone:hover, .drop-zone.drag-over { border-color: var(--accent); background: rgba(74,144,217,.05); }
    .drop-zone i { font-size: 2.2rem; color: var(--accent); opacity: .5; display: block; margin-bottom: 10px; }

    .doc-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
    .doc-item {
        display: flex; align-items: center; gap: 14px;
        background: var(--bg-card); border: 1px solid var(--border);
        border-radius: var(--radius-sm); padding: 14px 18px;
        transition: var(--transition);
    }
    .doc-item:hover { box-shadow: var(--shadow-sm); }
    .doc-icon { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
    .doc-icon.pdf { background: rgba(220,38,38,.1); color: #dc2626; }
    .doc-name  { font-size: 13.5px; font-weight: 600; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 260px; }
    .doc-size  { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
    .doc-type-badge { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; padding: 2px 8px; border-radius: 4px; }
    .doc-type-cv          { background: rgba(0,35,102,.08);  color: var(--navy); }
    .doc-type-constancia  { background: rgba(13,148,136,.1); color: #0d9488; }

    .doc-status { padding: 3px 10px; border-radius: 20px; font-size: 11.5px; font-weight: 600; white-space: nowrap; }
    .doc-status.verified  { background: #dcfce7; color: #16a34a; }
    .doc-status.pending   { background: #fef3c7; color: #92400e; }
    .doc-status.rejected  { background: #fee2e2; color: #991b1b; }

    .doc-action { width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--border); background: none; display: flex; align-items: center; justify-content: center; color: var(--text-muted); cursor: pointer; transition: var(--transition); text-decoration: none; }
    .doc-action:hover { background: var(--bg); color: var(--navy); }

    /* ─── Upload progress ─────────────────────────────── */
    .upload-progress-wrap { display: none; background: var(--bg); border-radius: var(--radius-sm); padding: 12px 16px; margin-top: 10px; }
    .upload-progress-wrap.active { display: block; }
    .progress-bar-bg { height: 6px; background: var(--border); border-radius: 3px; overflow: hidden; }
    .progress-bar-fill { height: 100%; background: var(--accent); border-radius: 3px; width: 0%; transition: width .2s; }
    .progress-info { display: flex; justify-content: space-between; font-size: 12px; color: var(--text-muted); margin-top: 6px; }

    /* ─── Toast ───────────────────────────────────────── */
    .gmt-toast { position: fixed; bottom: 28px; right: 28px; z-index: 9999; background: var(--navy-dark, #001540); color: #fff; padding: 14px 20px; border-radius: 10px; font-size: 13.5px; font-weight: 500; display: flex; align-items: center; gap: 10px; box-shadow: 0 8px 32px rgba(0,0,0,.25); transform: translateY(80px); opacity: 0; transition: all .35s cubic-bezier(.4,0,.2,1); max-width: 340px; }
    .gmt-toast.show { transform: translateY(0); opacity: 1; }
    .gmt-toast.toast-ok  i { color: #4ade80; }
    .gmt-toast.toast-err i { color: #f87171; }

    /* ─── Modal tipo documento ────────────────────────── */
    .tipo-btn { border: 2px solid var(--border); border-radius: 10px; padding: 14px 16px; cursor: pointer; transition: var(--transition); background: var(--bg); text-align: center; }
    .tipo-btn:hover { border-color: var(--accent); background: rgba(74,144,217,.06); }
    .tipo-btn.selected { border-color: var(--accent); background: rgba(74,144,217,.1); }
    .tipo-btn i { font-size: 1.6rem; display: block; margin-bottom: 6px; }

    @@media (max-width: 767.98px) {
        .profile-hero { flex-direction: column; align-items: flex-start; gap: 16px; }
        .data-label { min-width: 110px; }
    }
</style>
}

<!-- Page Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 style="font-size:22px;font-weight:800;margin:0;">Perfil Académico</h4>
        <p style="color:var(--text-muted);font-size:13px;margin:0;">Consulta y administra tu información</p>
    </div>
</div>

<!-- ── Hero ──────────────────────────────────────────────────────────── -->
<div class="profile-hero mb-4">
    <div class="profile-avatar-wrap">
        <div class="profile-avatar-lg" id="avatarDisplay"
             onclick="document.getElementById('inputFoto').click()"
             title="Cambiar foto de perfil">
            @if (!string.IsNullOrEmpty(alumno?.FotoPerfilUrl))
            {
                <img src="@alumno!.FotoPerfilUrl" alt="Foto de perfil" id="avatarImg" />
            }
            else
            {
                <span id="avatarInitials">@initials</span>
            }
        </div>
        <div class="avatar-edit-btn" onclick="document.getElementById('inputFoto').click()">
            <i class="fas fa-camera"></i>
        </div>
        <input type="file" id="inputFoto" accept=".jpg,.jpeg,.png,.webp" style="display:none" />
    </div>

    <div style="flex:1;min-width:0;">
        <div class="profile-name-lg">@(alumno?.NombreCompleto ?? "—")</div>
        <div style="font-size:13px;color:var(--text-muted);margin-top:2px;">
            @(alumno?.Carrera ?? "—")
        </div>
        <div class="profile-meta">
            <div class="meta-item"><i class="fas fa-id-card"></i><span>N° Control: <strong>@(alumno?.NumeroControl ?? "—")</strong></span></div>
            <div class="meta-item"><i class="fas fa-layer-group"></i><span>Semestre: <strong>@(alumno?.Semestre?.ToString() ?? "—")°</strong></span></div>
            @if (!string.IsNullOrEmpty(alumno?.Telefono))
            {
                <div class="meta-item"><i class="fas fa-phone"></i><span>@alumno!.Telefono</span></div>
            }
            @if (!string.IsNullOrEmpty(alumno?.Login?.CorreoInstitucional))
            {
                <div class="meta-item"><i class="fas fa-envelope"></i><span>@alumno!.Login!.CorreoInstitucional</span></div>
            }
        </div>
        <div class="hero-badge">Activo</div>
    </div>
</div>

<!-- ── Grid datos personales + académicos ────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-12 col-lg-6">
        <div class="info-card">
            <div class="info-card-header">
                <div class="info-card-header-icon"><i class="fas fa-user"></i></div>
                <span class="info-card-title">Datos Personales</span>
            </div>
            <div class="info-card-body">
                <div class="data-row">
                    <span class="data-label">Nombre completo</span>
                    <span class="data-value">@(alumno?.NombreCompleto ?? "—")</span>
                </div>
                <div class="data-row">
                    <span class="data-label">Teléfono</span>
                    <span class="data-value">@(alumno?.Telefono ?? "—")</span>
                </div>
                <div class="data-row">
                    <span class="data-label">Correo</span>
                    <span class="data-value" style="color:var(--accent);">@(alumno?.Login?.CorreoInstitucional ?? "—")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="info-card">
            <div class="info-card-header">
                <div class="info-card-header-icon"><i class="fas fa-graduation-cap"></i></div>
                <span class="info-card-title">Datos Académicos</span>
            </div>
            <div class="info-card-body">
                <div class="data-row">
                    <span class="data-label">N° de Control</span>
                    <span class="data-value" style="font-family:monospace;">@(alumno?.NumeroControl ?? "—")</span>
                </div>
                <div class="data-row">
                    <span class="data-label">Carrera</span>
                    <span class="data-value">@(alumno?.Carrera ?? "—")</span>
                </div>
                <div class="data-row">
                    <span class="data-label">Semestre</span>
                    <span class="data-value">@(alumno?.Semestre?.ToString() ?? "—")° semestre</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Documentos ─────────────────────────────────────────────────────── -->
<div class="info-card">
    <div class="info-card-header">
        <div class="info-card-header-icon"><i class="fas fa-folder-open"></i></div>
        <span class="info-card-title">Documentos Requeridos</span>
        <span style="font-size:12px;color:var(--text-muted);margin-left:auto;">
            <i class="fas fa-circle-info me-1"></i>Solo CV y Constancia de Estudios · PDF · Máx. 5 MB
        </span>
    </div>
    <div class="info-card-body">

        <!-- Zona de arrastre -->
        <div class="drop-zone mb-4" id="dropZone">
            <i class="fas fa-file-arrow-up"></i>
            <div style="font-size:15px;font-weight:700;margin-bottom:4px;">Arrastra tus PDFs aquí</div>
            <div style="font-size:13px;color:var(--text-muted);">
                o <span style="color:var(--accent);cursor:pointer;font-weight:600;"
                         onclick="document.getElementById('inputPdf').click()">haz clic para seleccionar</span>
                · PDF · Máx. 5 MB
            </div>
            <input type="file" id="inputPdf" accept=".pdf" style="display:none" multiple />
        </div>

        <!-- Barra de progreso -->
        <div class="upload-progress-wrap" id="uploadProgressWrap">
            <div class="progress-info mb-1">
                <span id="uploadFileName" style="font-weight:600;"></span>
                <span id="uploadPct">0%</span>
            </div>
            <div class="progress-bar-bg">
                <div class="progress-bar-fill" id="uploadFill"></div>
            </div>
        </div>

        <!-- Lista de documentos con datos reales -->
        <ul class="doc-list" id="docList">
            <!-- CV -->
            @if (docCv != null)
            {
                var statusClass = docCv.Estado switch { "aprobado" => "verified", "rechazado" => "rejected", _ => "pending" };
                var statusLabel = docCv.Estado switch { "aprobado" => "Verificado", "rechazado" => "Rechazado", _ => "Pendiente" };
                var tamStr = docCv.TamañoBytes >= 1024*1024 ? $"{docCv.TamañoBytes/1024.0/1024:F1} MB" : $"{docCv.TamañoBytes/1024.0:F0} KB";
                <li class="doc-item" id="doc-cv-row">
                    <div class="doc-icon pdf"><i class="fas fa-file-pdf"></i></div>
                    <div style="flex:1;min-width:0;">
                        <div class="doc-name">@docCv.NombreArchivo</div>
                        <div class="doc-size">@tamStr · <span class="doc-type-badge doc-type-cv">CV</span></div>
                    </div>
                    <span class="doc-status @statusClass">@statusLabel</span>
                    <a class="doc-action" href="/Admin/VerDocumento/@docCv.Id" target="_blank" title="Ver"><i class="fas fa-eye"></i></a>
                </li>
            }
            else
            {
                <li class="doc-item" id="doc-cv-row" style="border:2px dashed var(--border);background:var(--bg);">
                    <div class="doc-icon pdf" style="opacity:.4;"><i class="fas fa-file-pdf"></i></div>
                    <div style="flex:1;">
                        <div class="doc-name" style="color:var(--text-muted);">CV / Currículum Vitae</div>
                        <div class="doc-size">No subido aún</div>
                    </div>
                    <span class="doc-status pending">Pendiente</span>
                </li>
            }

            <!-- Constancia de estudios -->
            @if (docConstancia != null)
            {
                var statusClass = docConstancia.Estado switch { "aprobado" => "verified", "rechazado" => "rejected", _ => "pending" };
                var statusLabel = docConstancia.Estado switch { "aprobado" => "Verificado", "rechazado" => "Rechazado", _ => "Pendiente" };
                var tamStr = docConstancia.TamañoBytes >= 1024*1024 ? $"{docConstancia.TamañoBytes/1024.0/1024:F1} MB" : $"{docConstancia.TamañoBytes/1024.0:F0} KB";
                <li class="doc-item" id="doc-constancia-row">
                    <div class="doc-icon pdf"><i class="fas fa-file-pdf"></i></div>
                    <div style="flex:1;min-width:0;">
                        <div class="doc-name">@docConstancia.NombreArchivo</div>
                        <div class="doc-size">@tamStr · <span class="doc-type-badge doc-type-constancia">Constancia</span></div>
                    </div>
                    <span class="doc-status @statusClass">@statusLabel</span>
                    <a class="doc-action" href="/Admin/VerDocumento/@docConstancia.Id" target="_blank" title="Ver"><i class="fas fa-eye"></i></a>
                </li>
            }
            else
            {
                <li class="doc-item" id="doc-constancia-row" style="border:2px dashed var(--border);background:var(--bg);">
                    <div class="doc-icon pdf" style="opacity:.4;"><i class="fas fa-file-pdf"></i></div>
                    <div style="flex:1;">
                        <div class="doc-name" style="color:var(--text-muted);">Constancia de Estudios</div>
                        <div class="doc-size">No subida aún</div>
                    </div>
                    <span class="doc-status pending">Pendiente</span>
                </li>
            }
        </ul>

    </div>
</div>

<!-- Toast -->
<div class="gmt-toast" id="gmtToast">
    <i class="fas fa-circle-check" id="toastIcon"></i>
    <span id="toastMsg">Operación completada</span>
</div>

<!-- ═══ MODAL — Tipo de documento ═══ -->
<div class="modal fade" id="modalTipoDoc" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
        <div class="modal-content" style="border-radius:14px;border:none;">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-700" style="font-size:16px;">¿Qué tipo de documento es?</h5>
            </div>
            <div class="modal-body px-4 pb-4">
                <p style="font-size:13px;color:var(--text-muted);margin-bottom:16px;" id="modalDocNombre"></p>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="tipo-btn" id="btn-tipo-cv" onclick="seleccionarTipo('cv')">
                            <i class="fas fa-id-card" style="color:var(--navy);"></i>
                            <div style="font-size:13px;font-weight:700;margin-bottom:2px;">CV</div>
                            <div style="font-size:11.5px;color:var(--text-muted);">Currículum Vitae</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="tipo-btn" id="btn-tipo-constancia" onclick="seleccionarTipo('constancia_estudios')">
                            <i class="fas fa-file-lines" style="color:#0d9488;"></i>
                            <div style="font-size:13px;font-weight:700;margin-bottom:2px;">Constancia</div>
                            <div style="font-size:11.5px;color:var(--text-muted);">Constancia de estudios</div>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-light fw-600 flex-fill" style="border-radius:9px;" onclick="cancelarModalTipo()">Cancelar</button>
                    <button class="btn fw-600 flex-fill" id="btnConfirmarTipo" disabled
                            style="background:var(--navy);color:#fff;border-radius:9px;"
                            onclick="confirmarTipoYSubir()">
                        <i class="fas fa-upload me-1"></i> Subir
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const ALUMNO_ID  = @alumnoId;
    const API_PHOTO  = `/api/Upload/${ALUMNO_ID}/photo`;
    const API_DOC    = `/api/Upload/${ALUMNO_ID}/document`;

    // ── Toast ─────────────────────────────────────────────────────────────
    function showToast(msg, tipo = 'ok') {
        const t = document.getElementById('gmtToast');
        document.getElementById('toastMsg').textContent = msg;
        document.getElementById('toastIcon').className =
            tipo === 'ok' ? 'fas fa-circle-check' : 'fas fa-circle-xmark';
        t.className = `gmt-toast toast-${tipo}`;
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 3500);
    }

    // ── FOTO DE PERFIL ────────────────────────────────────────────────────
    document.getElementById('inputFoto').addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;

        // Vista previa inmediata
        const reader = new FileReader();
        reader.onload = ev => {
            document.getElementById('avatarDisplay').innerHTML =
                `<img src="${ev.target.result}" alt="Foto" style="width:100%;height:100%;object-fit:cover;">`;
        };
        reader.readAsDataURL(file);

        const fd = new FormData();
        fd.append('file', file);
        try {
            const res  = await fetch(API_PHOTO, { method: 'PUT', body: fd });
            const data = await res.json();
            showToast(res.ok ? 'Foto actualizada ✓' : (data.error ?? 'Error al subir foto'), res.ok ? 'ok' : 'err');
        } catch {
            showToast('Error de conexión', 'err');
        }
    });

    // ── DRAG & DROP PDF ───────────────────────────────────────────────────
    const dropZone = document.getElementById('dropZone');

    dropZone.addEventListener('dragover',  e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
    dropZone.addEventListener('dragleave', ()=> dropZone.classList.remove('drag-over'));
    dropZone.addEventListener('dragend',   ()=> dropZone.classList.remove('drag-over'));

    dropZone.addEventListener('drop', e => {
        e.preventDefault();
        dropZone.classList.remove('drag-over');
        procesarArchivos(e.dataTransfer.files);
    });

    document.getElementById('inputPdf').addEventListener('change', e => {
        procesarArchivos(e.target.files);
        e.target.value = '';
    });

    // ── MODAL TIPO DE DOCUMENTO ───────────────────────────────────────────
    let _pendingFile = null;
    let _selectedTipo = null;
    let _modalInstance = null;

    function procesarArchivos(files) {
        for (const file of files) {
            if (!file.name.toLowerCase().endsWith('.pdf')) {
                showToast(`"${file.name}" no es un PDF`, 'err'); continue;
            }
            if (file.size > 5 * 1024 * 1024) {
                showToast(`"${file.name}" supera los 5 MB`, 'err'); continue;
            }
            abrirModalTipo(file);
            break; // Una a la vez para no confundir
        }
    }

    function abrirModalTipo(file) {
        _pendingFile   = file;
        _selectedTipo  = null;
        document.getElementById('modalDocNombre').textContent = `Archivo: ${file.name}`;
        document.getElementById('btn-tipo-cv').classList.remove('selected');
        document.getElementById('btn-tipo-constancia').classList.remove('selected');
        document.getElementById('btnConfirmarTipo').disabled = true;
        _modalInstance = new bootstrap.Modal(document.getElementById('modalTipoDoc'));
        _modalInstance.show();
    }

    function seleccionarTipo(tipo) {
        _selectedTipo = tipo;
        document.getElementById('btn-tipo-cv').classList.toggle('selected', tipo === 'cv');
        document.getElementById('btn-tipo-constancia').classList.toggle('selected', tipo === 'constancia_estudios');
        document.getElementById('btnConfirmarTipo').disabled = false;
    }

    function cancelarModalTipo() {
        _pendingFile  = null;
        _selectedTipo = null;
        _modalInstance?.hide();
    }

    async function confirmarTipoYSubir() {
        if (!_pendingFile || !_selectedTipo) return;
        const file = _pendingFile;
        const tipo = _selectedTipo;
        _modalInstance?.hide();
        await subirPdf(file, tipo);
    }

    // ── UPLOAD CON PROGRESO ───────────────────────────────────────────────
    async function subirPdf(file, tipoDocumento) {
        const wrap = document.getElementById('uploadProgressWrap');
        const fill = document.getElementById('uploadFill');
        const pct  = document.getElementById('uploadPct');
        const name = document.getElementById('uploadFileName');

        wrap.classList.add('active');
        name.textContent = file.name;

        return new Promise(resolve => {
            const fd = new FormData();
            fd.append('file', file);
            fd.append('tipoDocumento', tipoDocumento);

            const xhr = new XMLHttpRequest();
            xhr.open('POST', API_DOC);

            xhr.upload.onprogress = e => {
                if (e.lengthComputable) {
                    const p = Math.round((e.loaded / e.total) * 100);
                    fill.style.width = p + '%';
                    pct.textContent  = p + '%';
                }
            };

            xhr.onload = () => {
                wrap.classList.remove('active');
                fill.style.width = '0%';

                if (xhr.status === 200 || xhr.status === 201) {
                    const data = JSON.parse(xhr.responseText);
                    actualizarFilaDoc(tipoDocumento, file.name, file.size);
                    showToast(`"${file.name}" subido correctamente`, 'ok');
                } else {
                    try {
                        const err = JSON.parse(xhr.responseText);
                        showToast(err.error ?? `Error al subir "${file.name}"`, 'err');
                    } catch {
                        showToast(`Error al subir "${file.name}"`, 'err');
                    }
                }
                resolve();
            };

            xhr.onerror = () => {
                wrap.classList.remove('active');
                showToast('Error de red al subir el documento', 'err');
                resolve();
            };

            xhr.send(fd);
        });
    }

    // Actualiza la fila del documento en la lista sin recargar página
    function actualizarFilaDoc(tipo, nombre, bytes) {
        const rowId = tipo === 'cv' ? 'doc-cv-row' : 'doc-constancia-row';
        const row   = document.getElementById(rowId);
        const tamStr = bytes >= 1024*1024 ? `${(bytes/1024/1024).toFixed(1)} MB` : `${Math.round(bytes/1024)} KB`;
        const typeLabel = tipo === 'cv'
            ? '<span class="doc-type-badge doc-type-cv">CV</span>'
            : '<span class="doc-type-badge doc-type-constancia">Constancia</span>';

        if (row) {
            row.style.border = '';
            row.style.background = '';
            row.innerHTML = `
                <div class="doc-icon pdf"><i class="fas fa-file-pdf"></i></div>
                <div style="flex:1;min-width:0;">
                    <div class="doc-name">${nombre}</div>
                    <div class="doc-size">${tamStr} · ${typeLabel}</div>
                </div>
                <span class="doc-status pending">Pendiente</span>
                <span class="doc-action" title="Subido"><i class="fas fa-check" style="color:#22c55e;"></i></span>`;
        }
    }

    function formatBytes(b) {
        if (b < 1024) return b + ' B';
        if (b < 1024*1024) return Math.round(b/1024) + ' KB';
        return (b/1024/1024).toFixed(1) + ' MB';
    }
</script>
}
