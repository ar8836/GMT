@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Perfil Académico";
    ViewData["ActiveModule"] = "perfil";
    ViewData["UserName"] = "Ariel Rubio Morales";
    ViewData["UserRole"] = "Alumno - ISC";
}

@* ══════════════════════════════════════════════════════════
   PERFILACADEMICO.CSHTML — Perfil del Alumno
   GMT | Gestor Modular Tecnológico
   ══════════════════════════════════════════════════════════ *@

@section Styles {
<style>
    /* ─── Profile Hero ────────────────────────────────── */
    .profile-hero {
        background: var(--bg-card);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
        padding: 32px;
        display: flex;
        align-items: center;
        gap: 28px;
        position: relative;
        overflow: hidden;
    }

    /* Franja decorativa superior */
    .profile-hero::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--navy), var(--accent));
    }

    .profile-avatar-wrap {
        position: relative;
        flex-shrink: 0;
    }

    .profile-avatar-lg {
        width: 100px; height: 100px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--navy), var(--accent));
        display: flex; align-items: center; justify-content: center;
        font-size: 36px;
        font-weight: 800;
        color: #fff;
        letter-spacing: 1px;
        box-shadow: 0 6px 24px rgba(0,35,102,.2);
        overflow: hidden;
        cursor: pointer;
        border: 3px solid #fff;
        outline: 3px solid var(--accent);
        transition: var(--transition);
    }

    .profile-avatar-lg img {
        width: 100%; height: 100%;
        object-fit: cover;
    }

    .profile-avatar-lg:hover { opacity: .85; }

    /* Botón cámara sobre avatar */
    .avatar-edit-btn {
        position: absolute;
        bottom: 2px; right: 2px;
        width: 28px; height: 28px;
        background: var(--accent);
        border-radius: 50%;
        border: 2px solid #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 11px;
        color: #fff;
        cursor: pointer;
        transition: var(--transition);
    }

    .avatar-edit-btn:hover { background: var(--navy); }

    .profile-info-main { flex: 1; min-width: 0; }

    .profile-name-lg {
        font-size: 22px;
        font-weight: 800;
        color: var(--text-primary);
        letter-spacing: -.3px;
        margin-bottom: 4px;
    }

    .profile-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-top: 10px;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12.5px;
        color: var(--text-muted);
    }

    .meta-item i {
        color: var(--accent);
        font-size: 12px;
        width: 14px;
        text-align: center;
    }

    /* Status badge en el hero */
    .hero-badge {
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        background: #dcfce7;
        color: #16a34a;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-top: 10px;
    }

    .hero-badge::before {
        content: '';
        width: 6px; height: 6px;
        border-radius: 50%;
        background: #22c55e;
    }

    /* ─── Info Cards Grid ─────────────────────────────── */
    .info-card {
        background: var(--bg-card);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        transition: var(--transition);
    }

    .info-card:hover { box-shadow: var(--shadow-md); }

    .info-card-header {
        padding: 16px 22px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--bg);
    }

    .info-card-header-icon {
        width: 32px; height: 32px;
        border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        font-size: 13px;
        background: rgba(0,35,102,.08);
        color: var(--navy);
    }

    .info-card-title {
        font-size: 13.5px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .info-card-body { padding: 20px 22px; }

    /* Filas de datos */
    .data-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid var(--border);
    }

    .data-row:last-child { border-bottom: none; padding-bottom: 0; }
    .data-row:first-child { padding-top: 0; }

    .data-label {
        font-size: 11.5px;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: .4px;
        min-width: 140px;
        flex-shrink: 0;
        padding-top: 1px;
    }

    .data-value {
        font-size: 13.5px;
        font-weight: 500;
        color: var(--text-primary);
        flex: 1;
    }

    /* ─── Progress Bar (créditos) ─────────────────────── */
    .credits-wrap {
        margin-top: 4px;
    }

    .credits-bar-bg {
        height: 8px;
        background: var(--bg);
        border-radius: 20px;
        overflow: hidden;
        margin-top: 6px;
        border: 1px solid var(--border);
    }

    .credits-bar-fill {
        height: 100%;
        border-radius: 20px;
        background: linear-gradient(90deg, var(--navy), var(--accent));
        transition: width 1.2s cubic-bezier(.4,0,.2,1);
    }

    .credits-label {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        color: var(--text-muted);
        margin-top: 4px;
    }

    /* ─── Documentos / Upload ─────────────────────────── */
    .doc-card {
        background: var(--bg-card);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    /* Zona de arrastre */
    .drop-zone {
        border: 2px dashed var(--border);
        border-radius: var(--radius-sm);
        padding: 28px 20px;
        text-align: center;
        cursor: pointer;
        transition: var(--transition);
        background: var(--bg);
        position: relative;
    }

    .drop-zone.drag-over {
        border-color: var(--accent);
        background: rgba(74,144,217,.05);
    }

    .drop-zone:hover {
        border-color: var(--accent);
        background: rgba(74,144,217,.04);
    }

    .drop-zone input[type="file"] {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
        width: 100%;
        height: 100%;
    }

    .drop-icon {
        font-size: 28px;
        color: var(--accent);
        margin-bottom: 10px;
        display: block;
    }

    .drop-title {
        font-size: 14px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 4px;
    }

    .drop-sub {
        font-size: 12px;
        color: var(--text-muted);
    }

    /* Lista de documentos subidos */
    .doc-list { padding: 0; margin: 0; list-style: none; }

    .doc-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 22px;
        border-bottom: 1px solid var(--border);
        transition: background .15s;
    }

    .doc-item:last-child { border-bottom: none; }
    .doc-item:hover { background: rgba(74,144,217,.03); }

    .doc-icon {
        width: 36px; height: 36px;
        border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        font-size: 15px;
        flex-shrink: 0;
    }

    .doc-icon.pdf   { background: rgba(239,68,68,.1);   color: #ef4444; }
    .doc-icon.img   { background: rgba(74,144,217,.1);  color: var(--accent); }
    .doc-icon.other { background: rgba(107,114,128,.1); color: #6b7280; }

    .doc-meta { flex: 1; min-width: 0; }

    .doc-name {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .doc-size {
        font-size: 11px;
        color: var(--text-muted);
        margin-top: 1px;
    }

    .doc-status {
        font-size: 11px;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 20px;
        white-space: nowrap;
    }

    .doc-status.verified   { background: #dcfce7; color: #16a34a; }
    .doc-status.pending    { background: #fef3c7; color: #92400e; }
    .doc-status.uploading  { background: #dbeafe; color: #1e40af; }

    .doc-action {
        background: none;
        border: 1px solid var(--border);
        border-radius: 6px;
        color: var(--text-muted);
        font-size: 12px;
        cursor: pointer;
        padding: 4px 10px;
        transition: var(--transition);
    }

    .doc-action:hover { border-color: var(--accent); color: var(--accent); }

    /* Barra de progreso de subida */
    .upload-progress-wrap { padding: 16px 22px; display: none; }

    .upload-progress-wrap.active { display: block; }

    .upload-prog-bar {
        height: 6px;
        background: var(--bg);
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid var(--border);
        margin-top: 8px;
    }

    .upload-prog-fill {
        height: 100%;
        width: 0%;
        border-radius: 10px;
        background: linear-gradient(90deg, var(--navy), var(--accent));
        transition: width .3s ease;
    }

    .upload-prog-label {
        display: flex;
        justify-content: space-between;
        font-size: 11.5px;
        color: var(--text-muted);
        margin-bottom: 4px;
    }

    /* ─── Toast de notificación ───────────────────────── */
    .gmt-toast {
        position: fixed;
        bottom: 28px; right: 28px;
        z-index: 9999;
        background: var(--navy-dark, #001540);
        color: #fff;
        padding: 14px 20px;
        border-radius: 10px;
        font-size: 13.5px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 8px 32px rgba(0,0,0,.25);
        transform: translateY(80px);
        opacity: 0;
        transition: all .35s cubic-bezier(.4,0,.2,1);
        max-width: 340px;
    }

    .gmt-toast.show { transform: translateY(0); opacity: 1; }
    .gmt-toast.toast-ok   i { color: #4ade80; }
    .gmt-toast.toast-err  i { color: #f87171; }
    .gmt-toast.toast-info i { color: var(--accent-bright, #5ba3f5); }

    /* ─── Responsive ──────────────────────────────────── */
    @@media (max-width: 767.98px) {
        .profile-hero { flex-direction: column; align-items: flex-start; gap: 16px; }
        .data-label { min-width: 110px; }
    }
</style>
}

@* ── Datos estáticos de demo ── *@
@{
    var alumno = new {
        Nombre          = "Ariel Rubio Morales",
        Initials        = "AR",
        NumControl      = "22321145",
        Carrera         = "Ingeniería en Sistemas Computacionales",
        Especialidad    = "ISC",
        Semestre        = "8°",
        Email           = "22321145@acapulco.tecnm.mx",
        Telefono        = "+52 744 123 4567",
        CURP            = "RUMA001204HGRBRL09",
        FotoUrl         = (string?)null,          // null → muestra iniciales
        CredObtenidos   = 289,
        CredTotales     = 340,
        Promedio        = "9.1",
        Estado          = "Activo"
    };

    int pct = (int)Math.Round((double)alumno.CredObtenidos / alumno.CredTotales * 100);

    var documentos = new[] {
        new { Nombre="Carta de presentación.pdf",     Tam="312 KB", Status="Verificado",  StatusClass="verified",  Icono="pdf" },
        new { Nombre="Kardex oficial.pdf",            Tam="540 KB", Status="Verificado",  StatusClass="verified",  Icono="pdf" },
        new { Nombre="Seguro social (IMSS).pdf",      Tam="198 KB", Status="Pendiente",   StatusClass="pending",   Icono="pdf" },
        new { Nombre="Constancia de estudios.pdf",    Tam="225 KB", Status="Pendiente",   StatusClass="pending",   Icono="pdf" },
    };

    // ID del alumno actual (vendrá del claim de sesión en producción)
    int alumnoId = 1;
}

<!-- ═══ CONTENT ══════════════════════════════════════════════ -->

<!-- Page Header -->
<div class="page-header fade-up">
    <div class="breadcrumb-gmt">
        <i class="fas fa-home"></i>
        <a href="#">Inicio</a>
        <i class="fas fa-chevron-right" style="font-size:9px;"></i>
        <span>Perfil Académico</span>
    </div>
    <h1 class="page-title">Perfil Académico</h1>
    <p class="page-subtitle">Consulta y administra tu información académica y documentos</p>
</div>

<!-- ── Hero del perfil ───────────────────────────────────────── -->
<div class="profile-hero mb-4 fade-up stagger-1">

    <!-- Avatar con botón de edición -->
    <div class="profile-avatar-wrap">
        <div class="profile-avatar-lg" id="avatarDisplay"
             onclick="document.getElementById('inputFoto').click()"
             title="Cambiar foto de perfil">
            @if (!string.IsNullOrEmpty(alumno.FotoUrl)) {
                <img src="@alumno.FotoUrl" alt="Foto de perfil" id="avatarImg" />
            } else {
                <span id="avatarInitials">@alumno.Initials</span>
            }
        </div>
        <div class="avatar-edit-btn" onclick="document.getElementById('inputFoto').click()">
            <i class="fas fa-camera"></i>
        </div>
        <!-- Input oculto para foto (usa el endpoint PUT /api/Upload/{id}/photo) -->
        <input type="file" id="inputFoto" accept=".jpg,.jpeg,.png" style="display:none" />
    </div>

    <!-- Datos principales -->
    <div class="profile-info-main">
        <div class="profile-name-lg">@alumno.Nombre</div>
        <div style="font-size:13px; color:var(--text-muted); margin-top:2px;">
            @alumno.Carrera
        </div>

        <div class="profile-meta">
            <div class="meta-item">
                <i class="fas fa-id-card"></i>
                <span>N° Control: <strong>@alumno.NumControl</strong></span>
            </div>
            <div class="meta-item">
                <i class="fas fa-layer-group"></i>
                <span>Semestre: <strong>@alumno.Semestre</strong></span>
            </div>
            <div class="meta-item">
                <i class="fas fa-star"></i>
                <span>Promedio: <strong>@alumno.Promedio</strong></span>
            </div>
            <div class="meta-item">
                <i class="fas fa-envelope"></i>
                <span>@alumno.Email</span>
            </div>
        </div>

        <div class="hero-badge">@alumno.Estado</div>
    </div>
</div>

<!-- ── Grid: datos personales + académicos ───────────────────── -->
<div class="row g-3 mb-4">

    <!-- Datos personales -->
    <div class="col-12 col-lg-6 fade-up stagger-2">
        <div class="info-card">
            <div class="info-card-header">
                <div class="info-card-header-icon">
                    <i class="fas fa-user"></i>
                </div>
                <span class="info-card-title">Datos Personales</span>
            </div>
            <div class="info-card-body">
                <div class="data-row">
                    <span class="data-label">Nombre completo</span>
                    <span class="data-value">@alumno.Nombre</span>
                </div>
                <div class="data-row">
                    <span class="data-label">CURP</span>
                    <span class="data-value" style="font-family:'Space Mono',monospace; font-size:12px;">
                        @alumno.CURP
                    </span>
                </div>
                <div class="data-row">
                    <span class="data-label">Teléfono</span>
                    <span class="data-value">@alumno.Telefono</span>
                </div>
                <div class="data-row">
                    <span class="data-label">Correo</span>
                    <span class="data-value" style="color:var(--accent);">@alumno.Email</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Datos académicos -->
    <div class="col-12 col-lg-6 fade-up stagger-3">
        <div class="info-card">
            <div class="info-card-header">
                <div class="info-card-header-icon">
                    <i class="fas fa-graduation-cap"></i>
                </div>
                <span class="info-card-title">Datos Académicos</span>
            </div>
            <div class="info-card-body">
                <div class="data-row">
                    <span class="data-label">N° de Control</span>
                    <span class="data-value" style="font-family:'Space Mono',monospace;">
                        @alumno.NumControl
                    </span>
                </div>
                <div class="data-row">
                    <span class="data-label">Carrera</span>
                    <span class="data-value">@alumno.Especialidad — @alumno.Carrera</span>
                </div>
                <div class="data-row">
                    <span class="data-label">Semestre</span>
                    <span class="data-value">@alumno.Semestre semestre</span>
                </div>
                <div class="data-row">
                    <span class="data-label">Créditos</span>
                    <div class="data-value">
                        <div class="credits-wrap">
                            <span style="font-size:13px; font-weight:700; color:var(--navy);">
                                @alumno.CredObtenidos / @alumno.CredTotales
                                <span style="font-size:11px; font-weight:500; color:var(--text-muted);">
                                    (@pct%)
                                </span>
                            </span>
                            <div class="credits-bar-bg">
                                <div class="credits-bar-fill" id="credBar" style="width:0%"></div>
                            </div>
                            <div class="credits-label">
                                <span>0 créditos</span>
                                <span>@alumno.CredTotales créditos</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Documentos requeridos ─────────────────────────────────── -->
<div class="fade-up stagger-4">
    <div class="section-header">
        <span class="section-title">Documentos Requeridos</span>
        <span style="font-size:12px; color:var(--text-muted);">
            <i class="fas fa-info-circle me-1" style="color:var(--accent);"></i>
            Solo se aceptan archivos PDF · Máximo 5 MB por archivo
        </span>
    </div>

    <div class="doc-card">

        <!-- Zona de drag & drop -->
        <div style="padding:20px 22px; border-bottom:1px solid var(--border);">
            <div class="drop-zone" id="dropZone">
                <input type="file" id="inputPdf" accept=".pdf" multiple />
                <i class="fas fa-file-arrow-up drop-icon"></i>
                <div class="drop-title">Arrastra tus PDFs aquí</div>
                <div class="drop-sub">
                    o <span style="color:var(--accent); font-weight:600;">haz clic para seleccionar</span>
                    · PDF · Máx. 5 MB
                </div>
            </div>

            <!-- Barra de progreso (oculta hasta que inicia la subida) -->
            <div class="upload-progress-wrap" id="uploadProgressWrap">
                <div class="upload-prog-label">
                    <span id="uploadFileName">Subiendo archivo…</span>
                    <span id="uploadPct">0%</span>
                </div>
                <div class="upload-prog-bar">
                    <div class="upload-prog-fill" id="uploadFill"></div>
                </div>
            </div>
        </div>

        <!-- Lista de documentos existentes -->
        <ul class="doc-list" id="docList">
            @foreach (var doc in documentos) {
                <li class="doc-item">
                    <div class="doc-icon @doc.Icono">
                        <i class="fas fa-file-pdf"></i>
                    </div>
                    <div class="doc-meta">
                        <div class="doc-name">@doc.Nombre</div>
                        <div class="doc-size">@doc.Tam</div>
                    </div>
                    <span class="doc-status @doc.StatusClass">@doc.Status</span>
                    <button class="doc-action" title="Descargar">
                        <i class="fas fa-download"></i>
                    </button>
                </li>
            }
        </ul>

    </div>
</div>

<!-- Toast de notificación -->
<div class="gmt-toast" id="gmtToast">
    <i class="fas fa-circle-check" id="toastIcon"></i>
    <span id="toastMsg">Operación completada</span>
</div>

@section Scripts {
<script>
    // ── Constantes ────────────────────────────────────────────
    const ALUMNO_ID   = @alumnoId;
    const API_PHOTO   = `/api/Upload/${ALUMNO_ID}/photo`;
    const API_PDF     = `/api/Upload/${ALUMNO_ID}/document`;

    // ── Animación créditos ────────────────────────────────────
    document.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => {
            document.getElementById('credBar').style.width = '@pct%';
        }, 400);
    });

    // ── Toast helper ──────────────────────────────────────────
    function showToast(msg, tipo = 'ok') {
        const t   = document.getElementById('gmtToast');
        const ico = document.getElementById('toastIcon');
        document.getElementById('toastMsg').textContent = msg;
        t.className = `gmt-toast toast-${tipo}`;
        ico.className = tipo === 'ok'   ? 'fas fa-circle-check'
                      : tipo === 'err'  ? 'fas fa-circle-xmark'
                      : 'fas fa-circle-info';
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 3500);
    }

    // ═══════════════════════════════════════════════════════════
    // SUBIDA DE FOTO DE PERFIL
    // Llama al endpoint existente: PUT /api/Upload/{id}/photo
    // ═══════════════════════════════════════════════════════════
    document.getElementById('inputFoto').addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;

        // Vista previa inmediata
        const reader = new FileReader();
        reader.onload = ev => {
            const disp = document.getElementById('avatarDisplay');
            disp.innerHTML = `<img src="${ev.target.result}" alt="Foto" id="avatarImg" style="width:100%;height:100%;object-fit:cover;">`;
        };
        reader.readAsDataURL(file);

        // Enviar al servidor
        const fd = new FormData();
        fd.append('file', file);

        try {
            const res  = await fetch(API_PHOTO, { method: 'PUT', body: fd });
            const data = await res.json();
            if (res.ok) {
                showToast('Foto actualizada correctamente', 'ok');
            } else {
                showToast(data.error ?? 'Error al subir la foto', 'err');
            }
        } catch {
            showToast('Error de conexión al subir la foto', 'err');
        }
    });

    // ═══════════════════════════════════════════════════════════
    // SUBIDA DE PDFs
    // Llama a: POST /api/Upload/{id}/document
    // ═══════════════════════════════════════════════════════════

    // Drag & drop visual
    const dropZone = document.getElementById('dropZone');

    dropZone.addEventListener('dragover', e => {
        e.preventDefault();
        dropZone.classList.add('drag-over');
    });

    ['dragleave', 'dragend'].forEach(ev =>
        dropZone.addEventListener(ev, () => dropZone.classList.remove('drag-over'))
    );

    dropZone.addEventListener('drop', e => {
        e.preventDefault();
        dropZone.classList.remove('drag-over');
        handlePdfFiles(e.dataTransfer.files);
    });

    document.getElementById('inputPdf').addEventListener('change', e => {
        handlePdfFiles(e.target.files);
        e.target.value = ''; // reset para poder subir el mismo archivo de nuevo
    });

    async function handlePdfFiles(files) {
        for (const file of files) {
            // Validaciones client-side
            if (!file.name.toLowerCase().endsWith('.pdf')) {
                showToast(`"${file.name}" no es un PDF`, 'err');
                continue;
            }
            if (file.size > 5 * 1024 * 1024) {
                showToast(`"${file.name}" supera los 5 MB`, 'err');
                continue;
            }
            await uploadPdf(file);
        }
    }

    async function uploadPdf(file) {
        // Mostrar barra de progreso
        const wrap = document.getElementById('uploadProgressWrap');
        const fill = document.getElementById('uploadFill');
        const pct  = document.getElementById('uploadPct');
        const name = document.getElementById('uploadFileName');

        wrap.classList.add('active');
        name.textContent = file.name;

        // Simular progreso con XMLHttpRequest para poder leer el progreso real
        return new Promise((resolve) => {
            const fd  = new FormData();
            fd.append('file', file);

            const xhr = new XMLHttpRequest();
            xhr.open('POST', API_PDF);

            xhr.upload.onprogress = (e) => {
                if (e.lengthComputable) {
                    const p = Math.round((e.loaded / e.total) * 100);
                    fill.style.width = p + '%';
                    pct.textContent  = p + '%';
                }
            };

            xhr.onload = () => {
                wrap.classList.remove('active');
                fill.style.width = '0%';

                if (xhr.status === 200 || xhr.status === 201) {
                    const data = JSON.parse(xhr.responseText);
                    addDocToList(file.name, formatBytes(file.size), data.url);
                    showToast(`"${file.name}" subido correctamente`, 'ok');
                } else {
                    showToast(`Error al subir "${file.name}"`, 'err');
                }
                resolve();
            };

            xhr.onerror = () => {
                wrap.classList.remove('active');
                showToast('Error de red al subir el documento', 'err');
                resolve();
            };

            xhr.send(fd);
        });
    }

    // Agrega una fila nueva a la lista de documentos tras subir
    function addDocToList(fileName, fileSize, url) {
        const li = document.createElement('li');
        li.className = 'doc-item';
        li.innerHTML = `
            <div class="doc-icon pdf"><i class="fas fa-file-pdf"></i></div>
            <div class="doc-meta">
                <div class="doc-name">${fileName}</div>
                <div class="doc-size">${fileSize}</div>
            </div>
            <span class="doc-status uploading">Subido</span>
            <a class="doc-action" href="${url}" target="_blank" title="Ver / Descargar">
                <i class="fas fa-download"></i>
            </a>`;
        document.getElementById('docList').prepend(li);
    }

    function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(0) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }
</script>
}
