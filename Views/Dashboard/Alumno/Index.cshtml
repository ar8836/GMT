@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveModule"] = "dashboard";
    ViewData["UserName"] = "Ariel Rubio Morales";
    ViewData["UserRole"] = "Alumno - ISC";
}

@* ══════════════════════════════════════════════════════════
   INDEX.CSHTML — Dashboard Principal (Vista Alumno)
   GMT | Gestor Modular Tecnológico
   ══════════════════════════════════════════════════════════ *@

@* 
   ===========================================================
   ¡ATENCIÓN! CAMBIOS A REALIZAR EN Views/Shared/_Layout.cshtml
   ===========================================================
   1. HEADER: Busca el tag <i> o <a> que contiene "fa-envelope" o el icono de correo y ELIMÍNALO.
   2. SIDEBAR: Busca y elimina la etiqueta de texto que dice "SISTEMA" o "Sistema".
   3. SIDEBAR: Agrega un nuevo enlace de menú llamado "Peticiones".
   4. SIDEBAR: Agrega un nuevo enlace de menú llamado "Perfil Académico".
   5. SIDEBAR: Mueve el elemento "Configuración" hacia abajo de los dos nuevos menús.
   ===========================================================
*@

@section Styles {
<style>
    /* ─── Stat Cards ──────────────────────────────────── */
    .stat-card {
        background: var(--bg-card);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        padding: 22px 24px;
        display: flex;
        align-items: flex-start;
        gap: 16px;
        box-shadow: var(--shadow-sm);
        transition: var(--transition);
        position: relative;
        overflow: hidden;
    }

    .stat-card::before {
        content: '';
        position: absolute;
        bottom: 0; left: 0;
        height: 3px;
        width: 100%;
        opacity: 0;
        transition: opacity .3s;
    }

    .stat-card:hover {
        box-shadow: var(--shadow-md);
        transform: translateY(-2px);
    }

    .stat-card:hover::before { opacity: 1; }

    .stat-card.card-blue::before   { background: linear-gradient(90deg, var(--navy), var(--accent)); }
    .stat-card.card-green::before  { background: linear-gradient(90deg, #0d9488, #34d399); }
    .stat-card.card-purple::before { background: linear-gradient(90deg, #7c3aed, #a78bfa); }

    .stat-icon {
        width: 50px; height: 50px;
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .stat-icon.blue   { background: rgba(0,35,102,.08);  color: var(--navy); }
    .stat-icon.green  { background: rgba(13,148,136,.1);  color: #0d9488; }
    .stat-icon.purple { background: rgba(124,58,237,.1);  color: #7c3aed; }

    .stat-body { flex: 1; min-width: 0; }

    .stat-label {
        font-size: 11.5px;
        font-weight: 600;
        color: var(--text-muted);
        letter-spacing: .5px;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .stat-value {
        font-size: 30px;
        font-weight: 800;
        color: var(--text-primary);
        line-height: 1;
        letter-spacing: -1px;
    }

    .stat-value.text-value {
        font-size: 20px; /* Letra más pequeña para que quepa el nombre de la empresa */
        letter-spacing: 0;
        margin-top: 4px;
    }

    .stat-footer {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-top: 8px;
        font-size: 12px;
        color: var(--text-muted);
    }

    .stat-badge {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        font-size: 11px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 20px;
    }

    .badge-up   { background: #dcfce7; color: #16a34a; }
    .badge-down { background: #fef2f2; color: #dc2626; }

    /* ─── Section Header ──────────────────────────────── */
    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }

    .section-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .section-title::before {
        content: '';
        width: 3px; height: 18px;
        background: var(--accent);
        border-radius: 2px;
        display: inline-block;
    }

    .btn-view-all {
        font-size: 12px;
        font-weight: 600;
        color: var(--accent);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: var(--transition);
    }

    .btn-view-all:hover { color: var(--navy); }

    /* ─── Table ───────────────────────────────────────── */
    .gmt-table-wrapper {
        background: var(--bg-card);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    .gmt-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
    }

    .gmt-table thead th {
        padding: 13px 18px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
        color: var(--text-muted);
        background: var(--bg);
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
    }

    .gmt-table tbody tr {
        border-bottom: 1px solid var(--border);
        transition: background .15s;
    }

    .gmt-table tbody tr:last-child { border-bottom: none; }
    .gmt-table tbody tr:hover { background: rgba(74,144,217,.03); }

    .gmt-table tbody td {
        padding: 14px 18px;
        color: var(--text-primary);
        vertical-align: middle;
    }

    .student-cell {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .student-avatar {
        width: 32px; height: 32px;
        border-radius: 50%;
        font-size: 11.5px;
        font-weight: 700;
        color: #fff;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
        letter-spacing: .3px;
    }

    .student-name {
        font-weight: 600;
        color: var(--text-primary);
        font-size: 13.5px;
    }

    .student-id {
        font-size: 11.5px;
        color: var(--text-muted);
        font-family: 'Space Mono', monospace;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11.5px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-pill::before {
        content: '';
        width: 5px; height: 5px;
        border-radius: 50%;
    }

    .pill-open     { background: #dcfce7; color: #166534; }
    .pill-open::before { background: #22c55e; }
    .pill-closed   { background: #fee2e2; color: #991b1b; }
    .pill-closed::before { background: #ef4444; }

    .module-tag {
        font-size: 11.5px;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    .type-residencia {
        background: #1e3a8a;
        color: #ffffff;
    }

    .type-servicio {
        background: #38bdf8;
        color: #0f172a;
    }

    /* ─── Chart Placeholder ───────────────────────────── */
    .chart-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 22px 24px;
        box-shadow: var(--shadow-sm);
    }

    .chart-bars {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 10px;
        height: 120px;
        padding-top: 8px;
    }

    .chart-bar-group {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
    }

    .chart-bars-inner {
        display: flex;
        gap: 3px;
        align-items: flex-end;
        width: 100%;
        max-width: 40px;
    }

    .c-bar {
        flex: 1;
        border-radius: 4px 4px 0 0;
        transition: opacity .2s;
    }

    .c-bar:hover { opacity: .75; }

    .c-bar.navy  { background: var(--navy); }
    .c-bar.blue  { background: var(--accent); }

    .chart-label {
        font-size: 10px;
        color: var(--text-muted);
        font-family: 'Space Mono', monospace;
        white-space: nowrap;
    }

    .chart-legend {
        display: flex;
        gap: 16px;
        margin-top: 14px;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        color: var(--text-secondary);
    }

    .legend-dot {
        width: 8px; height: 8px;
        border-radius: 2px;
    }

    /* ─── Fade-up stagger ─────────────────────────────── */
    .stagger-1 { animation-delay: .05s; }
    .stagger-2 { animation-delay: .10s; }
    .stagger-3 { animation-delay: .15s; }
    .stagger-4 { animation-delay: .20s; }
    .stagger-5 { animation-delay: .25s; }

    /* ─── Responsive ──────────────────────────────────── */
    @@media (max-width: 575.98px) {
        .stat-value { font-size: 24px; }
        .gmt-table thead { display: none; }
        .gmt-table tbody tr { display: block; padding: 10px 0; border-bottom: 1px solid var(--border); }
        .gmt-table tbody td { display: flex; padding: 5px 16px; align-items: center; }
        .gmt-table tbody td::before {
            content: attr(data-label);
            font-weight: 700;
            color: var(--text-muted);
            font-size: 11px;
            min-width: 120px;
            text-transform: uppercase;
        }
        .chart-bars { overflow-x: auto; padding-bottom: 10px; }
    }
</style>
}

@* ── Datos estáticos (Demo) ── *@
@{
    // Ajustado a 3 tarjetas como se solicitó
    var stats = new[] {
        new { Icon = "fas fa-list-check",       Color = "blue",   Label = "Peticiones activas",                 Value = "142",              ShowBadge = true,  Badge = "+12%",  BadgeType = "up", BgClass = "card-blue",   IsTextValue = false },
        new { Icon = "fas fa-user-graduate",    Color = "green",  Label = "Residencias en curso",               Value = "Microsoft México", ShowBadge = false, Badge = "",      BadgeType = "",   BgClass = "card-green",  IsTextValue = true  },
        new { Icon = "fas fa-graduation-cap",   Color = "purple", Label = "Porcentaje de creditos en reticula", Value = "85%",              ShowBadge = false, Badge = "",      BadgeType = "",   BgClass = "card-purple", IsTextValue = false }
    };

    var requests = new[] {
        new { Initials="MS", CompanyName="Microsoft México", RFC="MSM010101XX1", Type="Residencias",    TypeClass="type-residencia", Status="Abierta", StatusClass="pill-open",   Applicants=12, Task="Programación", Color="#002366" },
        new { Initials="ST", CompanyName="Softtek",          RFC="SOF980202YY2", Type="Servicio Social",TypeClass="type-servicio",   Status="Cerrada", StatusClass="pill-closed", Applicants=5,  Task="Soporte Técnico", Color="#0d9488" },
        new { Initials="IB", CompanyName="IBM Guadalajara",  RFC="IBM120303ZZ3", Type="Residencias",    TypeClass="type-residencia", Status="Abierta", StatusClass="pill-open",   Applicants=8,  Task="Análisis de Datos", Color="#7c3aed" },
        new { Initials="CX", CompanyName="Cemex",            RFC="CEM450404AA4", Type="Servicio Social",TypeClass="type-servicio",   Status="Abierta", StatusClass="pill-open",   Applicants=2,  Task="Redes y Comunicaciones", Color="#e11d48" },
    };
}

<!-- ═══ CONTENT ══════════════════════════════════════════════ -->

<!-- Page Header -->
<div class="page-header fade-up">
    <div class="breadcrumb-gmt">
        <i class="fas fa-home"></i>
        <a href="#">Inicio</a>
        <i class="fas fa-chevron-right" style="font-size:9px;"></i>
        <span>Dashboard</span>
    </div>
    <h1 class="page-title">Panel de Control</h1>
    <p class="page-subtitle">Resumen general del día de hoy</p>
</div>

<!-- ── Stat Cards ──────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    @for (int i = 0; i < stats.Length; i++) {
        var s = stats[i];
        <!-- Cambiado a col-md-4 para que las 3 tarjetas ocupen todo el ancho de forma uniforme -->
        <div class="col-12 col-md-4 fade-up stagger-@(i+1)">
            <div class="stat-card @s.BgClass">
                <div class="stat-icon @s.Color">
                    <i class="@s.Icon"></i>
                </div>
                <div class="stat-body">
                    <div class="stat-label">@s.Label</div>
                    <div class="stat-value @(s.IsTextValue ? "text-value" : "")">@s.Value</div>
                    
                    @if(s.ShowBadge) {
                        <div class="stat-footer">
                            <span class="stat-badge @(s.BadgeType == "up" ? "badge-up" : "badge-down")">
                                <i class="fas fa-arrow-@(s.BadgeType == "up" ? "up" : "down")"></i>
                                @s.Badge
                            </span>
                            vs. mes anterior
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- ── Main Grid (tabla + gráfica) ───────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-12 fade-up stagger-4">
        <div class="chart-card h-100">
            <div class="section-header">
                <span class="section-title" style="font-size:14px;">Peticiones / Mes</span>
            </div>

            <!-- Gráfica de 12 meses (Abreviaturas en Español) -->
            <div class="chart-bars">
                @{
                    var months = new[] {
                        new { Label="Jun 25", V1=45, V2=30 },
                        new { Label="Jul 25", V1=30, V2=40 },
                        new { Label="Ago 25", V1=80, V2=60 },
                        new { Label="Sep 25", V1=65, V2=50 },
                        new { Label="Oct 25", V1=55, V2=45 },
                        new { Label="Nov 25", V1=40, V2=35 },
                        new { Label="Dic 25", V1=20, V2=25 },
                        new { Label="Ene 26", V1=55, V2=40 },
                        new { Label="Feb 26", V1=68, V2=50 },
                        new { Label="Mar 26", V1=45, V2=60 },
                        new { Label="Abr 26", V1=72, V2=55 },
                        new { Label="May 26", V1=88, V2=70 },
                    };
                }
                @foreach (var m in months) {
                    <div class="chart-bar-group">
                        <div class="chart-bars-inner">
                            <div class="c-bar navy" style="height:@(m.V1)px;" title="Residencias: @m.V1"></div>
                            <div class="c-bar blue"  style="height:@(m.V2)px;" title="Servicio Social: @m.V2"></div>
                        </div>
                        <span class="chart-label">@m.Label</span>
                    </div>
                }
            </div>

            <div class="chart-legend">
                <div class="legend-item">
                    <div class="legend-dot" style="background:var(--navy);"></div>
                    Residencias
                </div>
                <div class="legend-item">
                    <div class="legend-dot" style="background:var(--accent);"></div>
                    Servicio Social
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Tabla de Peticiones Recientes ────────────────────────── -->
<div class="fade-up stagger-5">
    <div class="section-header">
        <span class="section-title">Peticiones Recientes</span>
        <a href="#" class="btn-view-all">
            Ver todo <i class="fas fa-arrow-right"></i>
        </a>
    </div>

    <div class="gmt-table-wrapper">
        <div class="table-responsive">
            <table class="gmt-table">
                <thead>
                    <tr>
                        <th>Empresa</th>
                        <th>Tipo de Petición</th>
                        <th style="text-align:center;">Aplicantes</th>
                        <th>Estado</th>
                        <th>Tareas</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in requests) {
                        <tr>
                            <td data-label="Empresa">
                                <div class="student-cell">
                                    <div class="student-avatar" style="background:@row.Color;">@row.Initials</div>
                                    <div>
                                        <div class="student-name">@row.CompanyName</div>
                                        <div class="student-id">@row.RFC</div>
                                    </div>
                                </div>
                            </td>
                            <td data-label="Tipo de Petición">
                                <span class="module-tag @row.TypeClass">@row.Type</span>
                            </td>
                            <td data-label="Aplicantes" style="text-align:center; font-weight:700; color:var(--navy);">
                                @row.Applicants
                            </td>
                            <td data-label="Estado">
                                <span class="status-pill @row.StatusClass">@row.Status</span>
                            </td>
                            <td data-label="Tareas">
                                <span style="font-size:13px; font-weight:500; color:var(--text-secondary);">
                                    <i class="fas fa-clipboard-check me-1" style="color:var(--accent);"></i> @row.Task
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer de la tabla -->
        <div style="padding: 14px 20px; background:var(--bg); border-top:1px solid var(--border);
                    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;">
            <span style="font-size:12px; color:var(--text-muted);">
                Mostrando <strong>@requests.Length</strong> de <strong>45</strong> peticiones
            </span>
            <div style="display:flex; gap:4px;">
                @for (int p = 1; p <= 3; p++) {
                    <button class="btn btn-sm"
                            style="min-width:30px; height:30px; padding:0; font-size:12px; font-weight:600;
                                   border-radius:6px; border:1px solid @(p==1 ? "var(--accent)" : "var(--border)");
                                   background:@(p==1 ? "var(--accent)" : "var(--bg)");
                                   color:@(p==1 ? "#fff" : "var(--text-muted)");">
                        @p
                    </button>
                }
                <button class="btn btn-sm"
                        style="height:30px; padding:0 10px; font-size:12px; font-weight:600;
                               border-radius:6px; border:1px solid var(--border);
                               background:var(--bg); color:var(--text-muted);">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Animar las barras del chart al cargar
    document.addEventListener('DOMContentLoaded', () => {
        const bars = document.querySelectorAll('.c-bar');
        bars.forEach((bar, i) => {
            const finalH = bar.style.height;
            bar.style.height = '0px';
            bar.style.transition = `height .5s cubic-bezier(.4,0,.2,1) ${i * 15}ms`;
            requestAnimationFrame(() => {
                requestAnimationFrame(() => { bar.style.height = finalH; });
            });
        });
    });
</script>
}