<!-- ═══ CONTENT ══════════════════════════════════════════════ -->

<!-- Page Header -->
<div class="page-header fade-up">
    <div class="breadcrumb-gmt">
        <i class="fas fa-home"></i>
        <a href="#">Inicio</a>
        <i class="fas fa-chevron-right" style="font-size:9px;"></i>
        <span>Peticiones</span>
    </div>
    <h1 class="page-title">Peticiones de Empresas</h1>
    <p class="page-subtitle">Convocatorias abiertas para Residencias Profesionales y Servicio Social</p>
</div>

<!-- ── Summary chips ─────────────────────────────────────────── -->
@{
    int totalOpen    = peticiones.Count(p => p.Estado == "Abierta");
    int totalClosed  = peticiones.Count(p => p.Estado == "Cerrada");
    int totalProcess = peticiones.Count(p => p.Estado == "En Proceso");
}
<div class="summary-chips mb-4 fade-up stagger-1">
    <div class="chip all" data-filter="all">
        <div class="chip-dot" style="background:var(--navy);"></div>
        Todas
        <span class="chip-count">@peticiones.Length</span>
    </div>
    <div class="chip open" data-filter="Abierta">
        <div class="chip-dot" style="background:#22c55e;"></div>
        Abiertas
        <span class="chip-count">@totalOpen</span>
    </div>
    <div class="chip process" data-filter="En Proceso">
        <div class="chip-dot" style="background:#3b82f6;"></div>
        En Proceso
        <span class="chip-count">@totalProcess</span>
    </div>
    <div class="chip closed" data-filter="Cerrada">
        <div class="chip-dot" style="background:#ef4444;"></div>
        Cerradas
        <span class="chip-count">@totalClosed</span>
    </div>
</div>

<!-- ── Filter bar ─────────────────────────────────────────────── -->
<div class="filter-bar mb-4 fade-up stagger-2">
    <span class="filter-label">Filtrar:</span>

    <select class="filter-select" id="filterTipo">
        <option value="">Todos los tipos</option>
        <option value="Residencias">Residencias</option>
        <option value="Servicio Social">Servicio Social</option>
    </select>

    <select class="filter-select" id="filterEstado">
        <option value="">Todos los estados</option>
        <option value="Abierta">Abierta</option>
        <option value="En Proceso">En Proceso</option>
        <option value="Cerrada">Cerrada</option>
    </select>

    <div class="filter-search">
        <i class="fas fa-search"></i>
        <input type="text" id="searchInput" placeholder="Buscar empresa, ciudad, tarea…" />
    </div>
</div>

<!-- ── Tabla de peticiones ───────────────────────────────────── -->
<div class="fade-up stagger-3">
    <div class="section-header">
        <span class="section-title">Listado de Peticiones</span>
        <span style="font-size:12px; color:var(--text-muted);" id="countLabel">
            Mostrando <strong id="visibleCount">@peticiones.Length</strong> de
            <strong>@peticiones.Length</strong> peticiones
        </span>
    </div>

    <div class="gmt-table-wrapper">
        <div class="table-responsive">
            <table class="gmt-table" id="peticionesTable">
                <thead>
                    <tr>
                        <th class="sortable">Empresa <i class="fas fa-sort" style="opacity:.4; font-size:9px;"></i></th>
                        <th>Tipo</th>
                        <th>Ciudad</th>
                        <th style="text-align:center;">Aplicantes</th>
                        <th>Estado</th>
                        <th>Duración</th>
                        <th style="text-align:center;">Acción</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @foreach (var p in peticiones) {
                        int appPct = (int)Math.Round((double)p.Aplicantes / p.MaxAplicantes * 100);
                        <tr data-tipo="@p.Tipo" data-estado="@p.Estado"
                            data-search="@p.Empresa.ToLower() @p.Ciudad.ToLower() @p.Tarea.ToLower()"
                            onclick="openModal(@p.Id)">
                            <td>
                                <div class="company-cell">
                                    <div class="company-avatar" style="background:@p.Color;">@p.Initials</div>
                                    <div>
                                        <div class="company-name">@p.Empresa</div>
                                        <div class="company-rfc">@p.RFC</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="type-pill @p.TipoClass">
                                    <i class="fas @(p.Tipo == "Residencias" ? "fa-briefcase" : "fa-hands-helping")"></i>
                                    @p.Tipo
                                </span>
                            </td>
                            <td style="font-size:13px; color:var(--text-secondary);">
                                <i class="fas fa-location-dot me-1" style="color:var(--accent); font-size:11px;"></i>
                                @p.Ciudad
                            </td>
                            <td>
                                <div class="applicants-bar" style="justify-content:center;">
                                    <div class="app-bar-bg">
                                        <div class="app-bar-fill" style="width:@appPct%;"></div>
                                    </div>
                                    <span class="app-count">@p.Aplicantes</span>
                                </div>
                            </td>
                            <td>
                                <span class="status-pill @p.EstadoClass">@p.Estado</span>
                            </td>
                            <td style="font-size:13px; color:var(--text-secondary);">
                                <i class="fas fa-clock me-1" style="color:var(--accent); font-size:11px;"></i>
                                @p.Duracion
                            </td>
                            <td style="text-align:center;" onclick="event.stopPropagation()">
                                <button class="row-btn" onclick="openModal(@p.Id)">
                                    Ver detalle
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Empty state (oculto por defecto) -->
        <div class="empty-state" id="emptyState" style="display:none;">
            <i class="fas fa-filter-circle-xmark"></i>
            <p>No se encontraron peticiones con los filtros seleccionados.</p>
        </div>

        <!-- Footer de la tabla -->
        <div style="padding:14px 20px; background:var(--bg); border-top:1px solid var(--border);
                    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;">
            <span style="font-size:12px; color:var(--text-muted);">
                Total de convocatorias activas: <strong>@totalOpen</strong>
            </span>
            <div style="display:flex; gap:4px;">
                <button class="btn btn-sm"
                        style="height:30px; padding:0 12px; font-size:12px; font-weight:600;
                               border-radius:6px; border:1px solid var(--accent);
                               background:var(--accent); color:#fff;">1</button>
                @for (int p = 2; p <= 3; p++) {
                    <button class="btn btn-sm"
                            style="height:30px; padding:0 12px; font-size:12px; font-weight:600;
                                   border-radius:6px; border:1px solid var(--border);
                                   background:var(--bg); color:var(--text-muted);">@p</button>
                }
                <button class="btn btn-sm"
                        style="height:30px; padding:0 10px; font-size:12px;
                               border-radius:6px; border:1px solid var(--border);
                               background:var(--bg); color:var(--text-muted);">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══ MODAL DE DETALLE ═══════════════════════════════════════ -->
<div class="detail-modal-backdrop" id="detailBackdrop" onclick="closeModalOnBackdrop(event)">
    <div class="detail-modal" id="detailModal">

        <div class="modal-header-gmt">
            <div class="modal-avatar" id="mAvatar"></div>
            <div class="modal-title-block">
                <div class="modal-title-gmt" id="mEmpresa"></div>
                <div class="modal-sub" id="mRFC"></div>
            </div>
            <button class="modal-close-btn" onclick="closeModal()">
                <i class="fas fa-xmark"></i>
            </button>
        </div>

        <div class="modal-body-gmt">
            <div class="modal-row">
                <span class="modal-row-label">Tipo</span>
                <span class="modal-row-value" id="mTipo"></span>
            </div>
            <div class="modal-row">
                <span class="modal-row-label">Estado</span>
                <span class="modal-row-value" id="mEstado"></span>
            </div>
            <div class="modal-row">
                <span class="modal-row-label">Ciudad</span>
                <span class="modal-row-value" id="mCiudad"></span>
            </div>
            <div class="modal-row">
                <span class="modal-row-label">Duración</span>
                <span class="modal-row-value" id="mDuracion"></span>
            </div>
            <div class="modal-row">
                <span class="modal-row-label">Compensación</span>
                <span class="modal-row-value" id="mCompensacion"></span>
            </div>
            <div class="modal-row">
                <span class="modal-row-label">Actividad</span>
                <span class="modal-row-value" id="mTarea"></span>
            </div>
            <div class="modal-row">
                <span class="modal-row-label">Requisitos</span>
                <span class="modal-row-value" id="mRequisitos"></span>
            </div>
            <div class="modal-row">
                <span class="modal-row-label">Aplicantes</span>
                <span class="modal-row-value" id="mAplicantes"></span>
            </div>
        </div>

        <div class="modal-footer-gmt">
            <button class="btn-modal-secondary" onclick="closeModal()">Cerrar</button>
            <button class="btn-modal-primary" id="mBtnAplicar">
                <i class="fas fa-paper-plane me-2"></i>Aplicar ahora
            </button>
        </div>

    </div>
</div>

@section Scripts {
<script>
    // ── Dataset de peticiones (espejo del C# para el modal) ────
    const PETICIONES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(peticiones.Select(p => new {
        id           = p.Id,
        initials     = p.Initials,
        color        = p.Color,
        empresa      = p.Empresa,
        rfc          = p.RFC,
        ciudad       = p.Ciudad,
        tipo         = p.Tipo,
        tipoClass    = p.TipoClass,
        estado       = p.Estado,
        estadoClass  = p.EstadoClass,
        aplicantes   = p.Aplicantes,
        maxAplicantes= p.MaxAplicantes,
        tarea        = p.Tarea,
        duracion     = p.Duracion,
        compensacion = p.Compensacion,
        requisitos   = p.Requisitos
    })));

    // ── Filtros ───────────────────────────────────────────────
    const rows       = document.querySelectorAll('#tableBody tr');
    const emptyState = document.getElementById('emptyState');
    const visCount   = document.getElementById('visibleCount');

    function applyFilters() {
        const tipo    = document.getElementById('filterTipo').value.toLowerCase();
        const estado  = document.getElementById('filterEstado').value.toLowerCase();
        const search  = document.getElementById('searchInput').value.toLowerCase().trim();

        let visible = 0;

        rows.forEach(row => {
            const rTipo   = (row.dataset.tipo   || '').toLowerCase();
            const rEstado = (row.dataset.estado || '').toLowerCase();
            const rSearch = (row.dataset.search || '').toLowerCase();

            const ok = (!tipo   || rTipo.includes(tipo))
                    && (!estado || rEstado.includes(estado))
                    && (!search || rSearch.includes(search));

            row.style.display = ok ? '' : 'none';
            if (ok) visible++;
        });

        visCount.textContent = visible;
        emptyState.style.display = visible === 0 ? 'block' : 'none';
    }

    document.getElementById('filterTipo').addEventListener('change', applyFilters);
    document.getElementById('filterEstado').addEventListener('change', applyFilters);
    document.getElementById('searchInput').addEventListener('input', applyFilters);

    // ── Filtro por chip ───────────────────────────────────────
    document.querySelectorAll('.chip').forEach(chip => {
        chip.addEventListener('click', () => {
            const filter = chip.dataset.filter;
            const sel    = document.getElementById('filterEstado');
            sel.value    = filter === 'all' ? '' : filter;
            applyFilters();
        });
    });

    // ── Modal ─────────────────────────────────────────────────
    function openModal(id) {
        const p = PETICIONES.find(x => x.id === id);
        if (!p) return;

        document.getElementById('mAvatar').style.background = p.color;
        document.getElementById('mAvatar').textContent       = p.initials;
        document.getElementById('mEmpresa').textContent      = p.empresa;
        document.getElementById('mRFC').textContent          = `RFC: ${p.rfc}`;
        document.getElementById('mCiudad').textContent       = p.ciudad;
        document.getElementById('mDuracion').textContent     = p.duracion;
        document.getElementById('mCompensacion').textContent = p.compensacion;
        document.getElementById('mTarea').textContent        = p.tarea;
        document.getElementById('mRequisitos').textContent   = p.requisitos;
        document.getElementById('mAplicantes').textContent   =
            `${p.aplicantes} / ${p.maxAplicantes} lugares`;

        // Tipo
        document.getElementById('mTipo').innerHTML =
            `<span class="type-pill ${p.tipoClass}" style="display:inline-flex;">${p.tipo}</span>`;

        // Estado
        document.getElementById('mEstado').innerHTML =
            `<span class="status-pill ${p.estadoClass}" style="display:inline-flex;">${p.estado}</span>`;

        // Deshabilitar botón si cerrada
        const btn = document.getElementById('mBtnAplicar');
        if (p.estado === 'Cerrada') {
            btn.disabled = true;
            btn.style.opacity = '.5';
            btn.style.cursor  = 'not-allowed';
        } else {
            btn.disabled = false;
            btn.style.opacity = '1';
            btn.style.cursor  = 'pointer';
        }

        document.getElementById('detailBackdrop').classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        document.getElementById('detailBackdrop').classList.remove('open');
        document.body.style.overflow = '';
    }

    function closeModalOnBackdrop(e) {
        if (e.target === document.getElementById('detailBackdrop')) closeModal();
    }

    // Tecla Escape cierra el modal
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') closeModal();
    });
</script>
}
