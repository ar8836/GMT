@using GMT.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"]        = "Mis Peticiones";
    ViewData["ActiveModule"] = "peticiones";

    var solicitudes      = ViewBag.Solicitudes      as List<SolicitudPractica> ?? new();
    var plazasDisponibles = ViewBag.PlazasDisponibles as List<PlazaPractica>    ?? new();
    var alumnoId         = (int)(ViewBag.AlumnoId ?? 0);
    var docCv            = ViewBag.DocsCv        as DocumentoAlumno;
    var docConstancia    = ViewBag.DocsConstancia as DocumentoAlumno;
    var mensaje          = TempData["Mensaje"]   as string;
}

@section Styles {
<style>
    .page-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; }
    .page-title  { font-size:22px; font-weight:800; margin:0; }

    /* Tabs */
    .tab-bar { display:flex; gap:4px; background:var(--bg); border-radius:10px; padding:4px; margin-bottom:24px; width:fit-content; }
    .tab-item { padding:7px 16px; border-radius:8px; font-size:13px; font-weight:600; color:var(--text-muted); cursor:pointer; border:none; background:none; transition:var(--transition); }
    .tab-item.active { background:#fff; color:var(--navy); box-shadow:0 1px 4px rgba(0,0,0,.1); }

    /* Plaza card */
    .plaza-card {
        background:var(--bg-card); border:1px solid var(--border);
        border-radius:var(--radius); padding:20px 22px;
        transition:var(--transition); cursor:pointer;
    }
    .plaza-card:hover { box-shadow:var(--shadow-md); transform:translateY(-2px); border-color:var(--accent); }
    .plaza-titulo { font-size:15px; font-weight:700; margin-bottom:4px; }
    .plaza-empresa { font-size:13px; font-weight:600; color:var(--navy); margin-bottom:8px; }
    .plaza-meta { display:flex; flex-wrap:wrap; gap:10px; font-size:12px; color:var(--text-muted); }
    .plaza-meta-item { display:flex; align-items:center; gap:4px; }

    /* Estado pills solicitud */
    .estado-pill { display:inline-flex; align-items:center; gap:5px; padding:4px 10px; border-radius:20px; font-size:11.5px; font-weight:600; }
    .estado-pill::before { content:''; width:5px; height:5px; border-radius:50%; }
    .pill-solicitado { background:#fef3c7; color:#92400e; } .pill-solicitado::before { background:#f59e0b; }
    .pill-aceptado   { background:#dcfce7; color:#166534; } .pill-aceptado::before   { background:#22c55e; }
    .pill-rechazado  { background:#fee2e2; color:#991b1b; } .pill-rechazado::before  { background:#ef4444; }
    .pill-en_curso   { background:#dbeafe; color:#1e40af; } .pill-en_curso::before   { background:#3b82f6; }
    .pill-concluido  { background:#f3f4f6; color:#374151; } .pill-concluido::before  { background:#9ca3af; }

    /* Tabla mis peticiones */
    .gmt-table-wrapper { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; box-shadow:var(--shadow-sm); }
    .gmt-table { width:100%; border-collapse:collapse; font-size:13.5px; }
    .gmt-table thead th { padding:13px 18px; font-size:11px; font-weight:700; letter-spacing:.8px; text-transform:uppercase; color:var(--text-muted); background:var(--bg); border-bottom:1px solid var(--border); }
    .gmt-table tbody tr { border-bottom:1px solid var(--border); transition:background .15s; }
    .gmt-table tbody tr:last-child { border-bottom:none; }
    .gmt-table tbody tr:hover { background:rgba(0,35,102,.02); }
    .gmt-table tbody td { padding:14px 18px; vertical-align:middle; }

    /* Empresa mini logo */
    .emp-mini-logo { width:36px; height:36px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:12px; color:#fff; flex-shrink:0; }

    /* Toast */
    .toast-msg { position:fixed; top:20px; right:20px; background:var(--navy); color:#fff; padding:12px 20px; border-radius:10px; font-weight:600; font-size:13px; z-index:9999; box-shadow:0 4px 16px rgba(0,0,0,.2); animation:slideIn .3s ease; }
    @@keyframes slideIn { from { transform:translateX(120%); opacity:0; } to { transform:translateX(0); opacity:1; } }

    /* Modal */
    .modal-section-title { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.6px; color:var(--text-muted); margin-bottom:10px; }
    .doc-preview-item { display:flex; align-items:center; gap:10px; background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:10px 14px; }
    .doc-preview-item .doc-name { font-size:13px; font-weight:600; flex:1; }
    .badge-tipo { font-size:10px; font-weight:700; text-transform:uppercase; padding:2px 7px; border-radius:4px; }
    .empty-state { text-align:center; padding:50px 20px; color:var(--text-muted); }
    .empty-state i { font-size:2.5rem; opacity:.2; display:block; margin-bottom:14px; }

    /* Alerta sin documentos */
    .docs-alert { background:rgba(217,119,6,.07); border:1px solid rgba(217,119,6,.25); border-radius:var(--radius-sm); padding:12px 16px; font-size:13px; color:#92400e; margin-bottom:16px; display:flex; gap:10px; }
</style>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="toast-msg" id="toastMsg">@mensaje</div>
    <script>setTimeout(() => document.getElementById('toastMsg')?.remove(), 4000);</script>
}

<div class="page-header">
    <div>
        <h4 class="page-title">Mis Peticiones</h4>
        <p style="color:var(--text-muted);font-size:13px;margin:0;">Convocatorias abiertas y tus solicitudes activas</p>
    </div>
</div>

<!-- Tabs -->
<div class="tab-bar mb-4">
    <button class="tab-item active" data-tab="convocatorias">
        Convocatorias <span style="opacity:.6;">(@plazasDisponibles.Count)</span>
    </button>
    <button class="tab-item" data-tab="mis-solicitudes">
        Mis Solicitudes <span style="opacity:.6;">(@solicitudes.Count)</span>
    </button>
</div>

<!-- ══ CONVOCATORIAS ════════════════════════════════════════════════════ -->
<div id="tab-convocatorias">
    @if (!plazasDisponibles.Any())
    {
        <div class="empty-state">
            <i class="fas fa-briefcase"></i>
            <div style="font-size:15px;font-weight:700;margin-bottom:6px;">No hay convocatorias disponibles</div>
            <div style="font-size:13px;">Las empresas verificadas publicarán plazas pronto</div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var plaza in plazasDisponibles)
            {
                var yaAplicó = solicitudes.Any(s => s.PlazaId == plaza.Id);
                var empInitials = string.Join("", (plaza.Empresa?.NombreEmpresa ?? "??").Split(' ').Take(2).Select(s => s.Length > 0 ? s[0].ToString() : ""));
                var colorIdx = Math.Abs((plaza.Empresa?.NombreEmpresa ?? "").GetHashCode()) % 5;
                var colors = new[] { "#002366","#7c3aed","#0d9488","#d97706","#dc2626" };
                var empColor = colors[colorIdx];

                <div class="col-12 col-lg-6">
                    <div class="plaza-card" onclick="abrirDetalle(@plaza.Id)">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            @if (!string.IsNullOrEmpty(plaza.Empresa?.FotoPerfilUrl))
                            {
                                <img src="@plaza.Empresa!.FotoPerfilUrl" style="width:40px;height:40px;border-radius:10px;object-fit:cover;flex-shrink:0;" />
                            }
                            else
                            {
                                <div class="emp-mini-logo" style="background:@empColor;">@empInitials</div>
                            }
                            <div style="flex:1;min-width:0;">
                                <div class="plaza-titulo">@plaza.Titulo</div>
                                <div class="plaza-empresa">@(plaza.Empresa?.NombreEmpresa ?? "—")</div>
                            </div>
                            @if (yaAplicó)
                            {
                                <span class="estado-pill pill-solicitado" style="font-size:11px;">Ya aplicaste</span>
                            }
                        </div>
                        <div class="plaza-meta mb-3">
                            @if (!string.IsNullOrEmpty(plaza.Area))
                            {
                                <span class="plaza-meta-item"><i class="fas fa-layer-group"></i> @plaza.Area</span>
                            }
                            <span class="plaza-meta-item">
                                <i class="fas @(plaza.Modalidad == "remoto" ? "fa-wifi" : "fa-building")"></i>
                                @(plaza.Modalidad[0].ToString().ToUpper() + plaza.Modalidad[1..])
                            </span>
                            @if (plaza.SemestreMinimo.HasValue)
                            {
                                <span class="plaza-meta-item"><i class="fas fa-graduation-cap"></i> Desde @(plaza.SemestreMinimo)° sem.</span>
                            }
                            <span class="plaza-meta-item">
                                <i class="fas fa-users"></i>
                                @(plaza.CuposDisponibles - plaza.CuposOcupados) lugar@(plaza.CuposDisponibles - plaza.CuposOcupados != 1 ? "es" : "") disponible@(plaza.CuposDisponibles - plaza.CuposOcupados != 1 ? "s" : "")
                            </span>
                        </div>
                        <div style="font-size:12.5px;color:var(--text-secondary);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                            @plaza.Descripcion
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ══ MIS SOLICITUDES ══════════════════════════════════════════════════ -->
<div id="tab-mis-solicitudes" style="display:none;">
    @if (!solicitudes.Any())
    {
        <div class="empty-state">
            <i class="fas fa-file-circle-plus"></i>
            <div style="font-size:15px;font-weight:700;margin-bottom:6px;">Sin solicitudes aún</div>
            <div style="font-size:13px;">Explora las convocatorias y aplica a las que te interesen</div>
        </div>
    }
    else
    {
        <div class="gmt-table-wrapper">
            <table class="gmt-table">
                <thead>
                    <tr>
                        <th>Empresa</th>
                        <th>Plaza</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sol in solicitudes)
                    {
                        var empInitials = string.Join("", (sol.Empresa?.NombreEmpresa ?? "??").Split(' ').Take(2).Select(s => s.Length > 0 ? s[0].ToString() : ""));
                        var colorIdx = Math.Abs((sol.Empresa?.NombreEmpresa ?? "").GetHashCode()) % 5;
                        var colors = new[] { "#002366","#7c3aed","#0d9488","#d97706","#dc2626" };
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="emp-mini-logo" style="background:@colors[colorIdx];">@empInitials</div>
                                    <div>
                                        <div style="font-weight:600;font-size:13.5px;">@(sol.Empresa?.NombreEmpresa ?? "—")</div>
                                        <div style="font-size:11.5px;color:var(--text-muted);">@(sol.Empresa?.Ciudad ?? "")</div>
                                    </div>
                                </div>
                            </td>
                            <td style="font-size:13px;color:var(--text-secondary);">@(sol.Plaza?.Titulo ?? sol.Area ?? "—")</td>
                            <td style="font-size:12px;color:var(--text-muted);">@sol.FechaSolicitud.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="estado-pill pill-@sol.Estado">
                                    @(sol.Estado switch {
                                        "solicitado" => "Pendiente",
                                        "aceptado"   => "Aceptado",
                                        "rechazado"  => "Rechazado",
                                        "en_curso"   => "En curso",
                                        "concluido"  => "Concluido",
                                        _            => sol.Estado
                                    })
                                </span>
                            </td>
                            <td>
                                @if (sol.Estado == "aceptado")
                                {
                                    <span style="font-size:12px;color:#22c55e;font-weight:600;">
                                        <i class="fas fa-check me-1"></i>Aceptado
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ═══ MODAL DETALLE DE PLAZA + APLICAR ═══ -->
<div class="modal fade" id="modalPlaza" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:560px;">
        <div class="modal-content" style="border-radius:14px;border:none;">
            <div class="modal-body p-0">
                <!-- Header -->
                <div id="modalPlazaHeader" style="padding:24px 24px 16px;border-bottom:1px solid var(--border);">
                    <div class="d-flex align-items-center gap-3">
                        <div id="modalEmpLogo" class="emp-mini-logo" style="width:48px;height:48px;border-radius:13px;font-size:16px;"></div>
                        <div>
                            <div id="modalPlazaTitulo" style="font-size:17px;font-weight:800;"></div>
                            <div id="modalEmpNombre" style="font-size:13px;color:var(--navy);font-weight:600;"></div>
                        </div>
                        <button class="btn-close ms-auto" data-bs-dismiss="modal"></button>
                    </div>
                </div>

                <!-- Detalles -->
                <div style="padding:20px 24px;">
                    <table style="width:100%;border-collapse:collapse;font-size:13px;">
                        <tr><td style="padding:8px 0;font-weight:700;color:var(--text-muted);text-transform:uppercase;font-size:10.5px;letter-spacing:.5px;width:140px;">Modalidad</td><td id="modalModalidad" style="padding:8px 0;"></td></tr>
                        <tr><td style="padding:8px 0;font-weight:700;color:var(--text-muted);text-transform:uppercase;font-size:10.5px;letter-spacing:.5px;">Ciudad</td><td id="modalCiudad" style="padding:8px 0;"></td></tr>
                        <tr><td style="padding:8px 0;font-weight:700;color:var(--text-muted);text-transform:uppercase;font-size:10.5px;letter-spacing:.5px;">Área</td><td id="modalArea" style="padding:8px 0;"></td></tr>
                        <tr><td style="padding:8px 0;font-weight:700;color:var(--text-muted);text-transform:uppercase;font-size:10.5px;letter-spacing:.5px;">Sem. mínimo</td><td id="modalSemestre" style="padding:8px 0;"></td></tr>
                        <tr><td style="padding:8px 0;font-weight:700;color:var(--text-muted);text-transform:uppercase;font-size:10.5px;letter-spacing:.5px;">Cupos</td><td id="modalCupos" style="padding:8px 0;"></td></tr>
                    </table>
                    <div style="border-top:1px solid var(--border);margin-top:10px;padding-top:14px;">
                        <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:6px;">Descripción</div>
                        <div id="modalDescripcion" style="font-size:13.5px;color:var(--text-secondary);line-height:1.6;"></div>
                    </div>

                    <!-- Documentos que se adjuntarán -->
                    <div style="border-top:1px solid var(--border);margin-top:14px;padding-top:14px;">
                        <div class="modal-section-title">Documentos que se adjuntarán a tu solicitud</div>
                        @if (docCv == null && docConstancia == null)
                        {
                            <div class="docs-alert">
                                <i class="fas fa-triangle-exclamation mt-1" style="flex-shrink:0;"></i>
                                <div>No tienes documentos subidos. Ve a tu <a href="/Dashboard/PerfilAcademico" style="color:#92400e;font-weight:700;">Perfil Académico</a> para subir tu CV y constancia de estudios antes de aplicar.</div>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2">
                                @if (docCv != null)
                                {
                                    <div class="doc-preview-item">
                                        <i class="fas fa-file-pdf" style="color:#dc2626;font-size:18px;"></i>
                                        <div class="doc-name">@docCv.NombreArchivo</div>
                                        <span class="badge-tipo" style="background:rgba(0,35,102,.08);color:var(--navy);">CV</span>
                                        <a href="@docCv.Url" target="_blank" style="color:var(--accent);font-size:12px;text-decoration:none;"><i class="fas fa-eye"></i></a>
                                    </div>
                                }
                                @if (docConstancia != null)
                                {
                                    <div class="doc-preview-item">
                                        <i class="fas fa-file-pdf" style="color:#dc2626;font-size:18px;"></i>
                                        <div class="doc-name">@docConstancia.NombreArchivo</div>
                                        <span class="badge-tipo" style="background:rgba(13,148,136,.1);color:#0d9488;">Constancia</span>
                                        <a href="@docConstancia.Url" target="_blank" style="color:var(--accent);font-size:12px;text-decoration:none;"><i class="fas fa-eye"></i></a>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Footer con botón aplicar -->
                <div style="padding:16px 24px;border-top:1px solid var(--border);display:flex;gap:10px;justify-content:flex-end;">
                    <button class="btn btn-light fw-600" data-bs-dismiss="modal" style="border-radius:9px;">Cerrar</button>
                    <form id="formAplicar" asp-action="AplicarSolicitud" asp-controller="Dashboard" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="plazaId" id="modalPlazaId" />
                        <button type="submit" id="btnAplicar" class="btn fw-600"
                                style="background:var(--navy);color:#fff;border-radius:9px;padding:9px 22px;">
                            <i class="fas fa-paper-plane me-1"></i> Aplicar ahora
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── Datos de plazas (para el modal de detalle) ────────────────────────
    const PLAZAS = {
        @foreach (var p in plazasDisponibles)
        {
            var yaAplicó = solicitudes.Any(s => s.PlazaId == p.Id);
            <text>
            @p.Id: {
                titulo:      "@Html.Raw(p.Titulo.Replace("\"","\\\""))",
                empresa:     "@Html.Raw((p.Empresa?.NombreEmpresa ?? "").Replace("\"","\\\""))",
                ciudad:      "@Html.Raw((p.Empresa?.Ciudad ?? "—").Replace("\"","\\\""))",
                modalidad:   "@(p.Modalidad[0].ToString().ToUpper() + p.Modalidad[1..])",
                area:        "@Html.Raw((p.Area ?? "—").Replace("\"","\\\""))",
                semestre:    "@(p.SemestreMinimo.HasValue ? p.SemestreMinimo + "° semestre" : "Sin requisito")",
                cupos:       "@(p.CuposDisponibles - p.CuposOcupados) de @p.CuposDisponibles disponibles",
                descripcion: "@Html.Raw(p.Descripcion.Replace("\"","\\\"").Replace("\n","\\n"))",
                yaAplico:    @(yaAplicó ? "true" : "false"),
                color:       "@(new[]{"#002366","#7c3aed","#0d9488","#d97706","#dc2626"}[Math.Abs((p.Empresa?.NombreEmpresa??"").GetHashCode())%5])",
                initials:    "@string.Join("",((p.Empresa?.NombreEmpresa??"??").Split(' ').Take(2).Select(s=>s.Length>0?s[0].ToString():"")))"
            },
            </text>
        }
    };

    function abrirDetalle(plazaId) {
        const p = PLAZAS[plazaId];
        if (!p) return;

        document.getElementById('modalPlazaTitulo').textContent = p.titulo;
        document.getElementById('modalEmpNombre').textContent   = p.empresa;
        document.getElementById('modalModalidad').textContent   = p.modalidad;
        document.getElementById('modalCiudad').textContent      = p.ciudad;
        document.getElementById('modalArea').textContent        = p.area;
        document.getElementById('modalSemestre').textContent    = p.semestre;
        document.getElementById('modalCupos').textContent       = p.cupos;
        document.getElementById('modalDescripcion').textContent = p.descripcion;
        document.getElementById('modalPlazaId').value           = plazaId;

        const logo = document.getElementById('modalEmpLogo');
        logo.textContent = p.initials;
        logo.style.background = p.color;

        const btn = document.getElementById('btnAplicar');
        if (p.yaAplico) {
            btn.disabled = true;
            btn.textContent = '✓ Ya aplicaste';
        } else {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-paper-plane me-1"></i> Aplicar ahora';
        }

        new bootstrap.Modal(document.getElementById('modalPlaza')).show();
    }

    // ── Tabs ──────────────────────────────────────────────────────────────
    document.querySelectorAll('.tab-item').forEach(tab => {
        tab.addEventListener('click', function() {
            document.querySelectorAll('.tab-item').forEach(t => t.classList.remove('active'));
            this.classList.add('active');
            const target = this.dataset.tab;
            document.getElementById('tab-convocatorias').style.display    = target === 'convocatorias'    ? '' : 'none';
            document.getElementById('tab-mis-solicitudes').style.display  = target === 'mis-solicitudes'  ? '' : 'none';
        });
    });
</script>
}
