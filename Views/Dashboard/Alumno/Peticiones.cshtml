@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Peticiones";
    ViewData["ActiveModule"] = "peticiones";
    ViewData["UserName"] = "Ariel Rubio Morales";
    ViewData["UserRole"] = "Alumno - ISC";
}

@* ══════════════════════════════════════════════════════════
   PETICIONES.CSHTML — Listado de Peticiones de Empresas
   GMT | Gestor Modular Tecnológico
   ══════════════════════════════════════════════════════════ *@

@section Styles {
<style>
    /* ─── Filter bar ──────────────────────────────────── */
    .filter-bar {
        background: var(--bg-card);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        box-shadow: var(--shadow-sm);
    }

    .filter-label {
        font-size: 12px;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: .5px;
        white-space: nowrap;
    }

    .filter-select {
        padding: 7px 12px;
        border: 1.5px solid var(--border);
        border-radius: 8px;
        font-size: 13px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: var(--text-primary);
        background: var(--bg);
        outline: none;
        cursor: pointer;
        transition: var(--transition);
    }

    .filter-select:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(74,144,217,.1);
    }

    .filter-search {
        flex: 1;
        min-width: 180px;
        position: relative;
    }

    .filter-search i {
        position: absolute;
        left: 12px; top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        font-size: 13px;
        pointer-events: none;
    }

    .filter-search input {
        width: 100%;
        padding: 8px 12px 8px 36px;
        border: 1.5px solid var(--border);
        border-radius: 8px;
        font-size: 13px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: var(--text-primary);
        background: var(--bg);
        outline: none;
        transition: var(--transition);
    }

    .filter-search input::placeholder { color: var(--text-muted); }

    .filter-search input:focus {
        border-color: var(--accent);
        background: #fff;
        box-shadow: 0 0 0 3px rgba(74,144,217,.1);
    }

    /* ─── Summary chips ───────────────────────────────── */
    .summary-chips {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .chip {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
        border: 1.5px solid var(--border);
        background: var(--bg-card);
        box-shadow: var(--shadow-sm);
        cursor: pointer;
        transition: var(--transition);
    }

    .chip:hover { transform: translateY(-1px); box-shadow: var(--shadow-md); }

    .chip-dot {
        width: 8px; height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .chip.all     { color: var(--text-primary); }
    .chip.open    { color: #16a34a; border-color: #86efac; background: #f0fdf4; }
    .chip.closed  { color: #dc2626; border-color: #fca5a5; background: #fef2f2; }
    .chip.process { color: #1d4ed8; border-color: #93c5fd; background: #eff6ff; }

    .chip-count {
        background: rgba(0,0,0,.06);
        border-radius: 20px;
        padding: 1px 7px;
        font-size: 11px;
    }

    /* ─── Table overrides ─────────────────────────────── */
    .gmt-table-wrapper {
        background: var(--bg-card);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    .gmt-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
    }

    .gmt-table thead th {
        padding: 13px 18px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
        color: var(--text-muted);
        background: var(--bg);
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
    }

    .gmt-table thead th.sortable {
        cursor: pointer;
        user-select: none;
    }

    .gmt-table thead th.sortable:hover { color: var(--navy); }

    .gmt-table tbody tr {
        border-bottom: 1px solid var(--border);
        transition: background .15s;
        cursor: pointer;
    }

    .gmt-table tbody tr:last-child { border-bottom: none; }

    .gmt-table tbody tr:hover { background: rgba(74,144,217,.04); }

    .gmt-table tbody td {
        padding: 14px 18px;
        color: var(--text-primary);
        vertical-align: middle;
    }

    /* Company cell */
    .company-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .company-avatar {
        width: 36px; height: 36px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 13px;
        font-weight: 800;
        color: #fff;
        flex-shrink: 0;
        letter-spacing: .5px;
    }

    .company-name {
        font-weight: 600;
        color: var(--text-primary);
        font-size: 13.5px;
        line-height: 1.2;
    }

    .company-rfc {
        font-size: 11px;
        color: var(--text-muted);
        font-family: 'Space Mono', monospace;
    }

    /* Pills de tipo */
    .type-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11.5px;
        font-weight: 600;
        white-space: nowrap;
    }

    .type-residencia { background: rgba(0,35,102,.08);   color: var(--navy); }
    .type-servicio   { background: rgba(13,148,136,.1);  color: #0d9488; }

    /* Pills de estado */
    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11.5px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-pill::before {
        content: '';
        width: 5px; height: 5px;
        border-radius: 50%;
    }

    .pill-open    { background: #dcfce7; color: #166534; }
    .pill-open::before    { background: #22c55e; }
    .pill-closed  { background: #fee2e2; color: #991b1b; }
    .pill-closed::before  { background: #ef4444; }
    .pill-process { background: #dbeafe; color: #1e40af; }
    .pill-process::before { background: #3b82f6; }

    /* Barra de aplicantes */
    .applicants-bar {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .app-bar-bg {
        width: 60px; height: 5px;
        background: var(--bg);
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid var(--border);
    }

    .app-bar-fill {
        height: 100%;
        border-radius: 10px;
        background: linear-gradient(90deg, var(--navy), var(--accent));
    }

    .app-count {
        font-size: 13px;
        font-weight: 700;
        color: var(--navy);
        min-width: 20px;
    }

    /* Botón acción de fila */
    .row-btn {
        background: none;
        border: 1px solid var(--border);
        border-radius: 6px;
        color: var(--text-muted);
        font-size: 12px;
        cursor: pointer;
        padding: 5px 12px;
        font-weight: 600;
        font-family: 'Plus Jakarta Sans', sans-serif;
        transition: var(--transition);
        white-space: nowrap;
    }

    .row-btn:hover {
        border-color: var(--accent);
        color: var(--accent);
        background: rgba(74,144,217,.05);
    }

    /* ─── Modal de detalle ────────────────────────────── */
    .detail-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        opacity: 0;
        pointer-events: none;
        transition: opacity .3s ease;
    }

    .detail-modal-backdrop.open {
        opacity: 1;
        pointer-events: all;
    }

    .detail-modal {
        background: var(--bg-card);
        border-radius: var(--radius);
        width: 100%;
        max-width: 580px;
        box-shadow: var(--shadow-lg);
        transform: scale(.95) translateY(20px);
        transition: transform .3s cubic-bezier(.4,0,.2,1);
        overflow: hidden;
    }

    .detail-modal-backdrop.open .detail-modal {
        transform: scale(1) translateY(0);
    }

    .modal-header-gmt {
        padding: 22px 26px 18px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .modal-header-gmt .modal-avatar {
        width: 44px; height: 44px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 16px;
        font-weight: 800;
        color: #fff;
        flex-shrink: 0;
    }

    .modal-title-block { flex: 1; min-width: 0; }

    .modal-title-gmt {
        font-size: 16px;
        font-weight: 800;
        color: var(--text-primary);
    }

    .modal-sub {
        font-size: 11.5px;
        color: var(--text-muted);
        margin-top: 2px;
    }

    .modal-close-btn {
        background: none;
        border: none;
        font-size: 16px;
        color: var(--text-muted);
        cursor: pointer;
        padding: 4px;
        border-radius: 6px;
        transition: var(--transition);
    }

    .modal-close-btn:hover { color: var(--navy); background: var(--bg); }

    .modal-body-gmt { padding: 22px 26px; }

    .modal-row {
        display: flex;
        gap: 10px;
        padding: 9px 0;
        border-bottom: 1px solid var(--border);
        font-size: 13.5px;
    }

    .modal-row:last-child { border-bottom: none; }

    .modal-row-label {
        font-size: 11.5px;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: .4px;
        min-width: 130px;
        flex-shrink: 0;
        padding-top: 1px;
    }

    .modal-row-value {
        color: var(--text-primary);
        font-weight: 500;
    }

    .modal-footer-gmt {
        padding: 16px 26px;
        border-top: 1px solid var(--border);
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        background: var(--bg);
    }

    .btn-modal-primary {
        padding: 9px 22px;
        background: linear-gradient(135deg, var(--navy), var(--navy-mid, #00307a));
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        font-family: 'Plus Jakarta Sans', sans-serif;
        cursor: pointer;
        transition: var(--transition);
    }

    .btn-modal-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 14px rgba(0,35,102,.3);
    }

    .btn-modal-secondary {
        padding: 9px 18px;
        background: var(--bg-card);
        color: var(--text-secondary);
        border: 1.5px solid var(--border);
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        font-family: 'Plus Jakarta Sans', sans-serif;
        cursor: pointer;
        transition: var(--transition);
    }

    .btn-modal-secondary:hover { border-color: var(--accent); color: var(--accent); }

    /* ─── Empty state ─────────────────────────────────── */
    .empty-state {
        text-align: center;
        padding: 56px 20px;
        color: var(--text-muted);
    }

    .empty-state i {
        font-size: 40px;
        margin-bottom: 14px;
        color: var(--border);
        display: block;
    }

    .empty-state p {
        font-size: 14px;
        font-weight: 500;
    }

    /* ─── Responsive ──────────────────────────────────── */
    @@media (max-width: 767.98px) {
        .filter-bar { gap: 8px; }
        .summary-chips { gap: 6px; }
        .chip { padding: 8px 12px; font-size: 12px; }
    }
</style>
}

