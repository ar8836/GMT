@using GMT.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"]        = "Perfil Empresa";
    ViewData["ActiveModule"] = "perfil";
    ViewData["PortalTipo"]   = "empresa";

    var empresa = ViewBag.Empresa as Empresa;

    // Lista de ciudades de Guerrero — definida aquí para poder usarla
    // tanto en el select como sin tener C# en atributos de <option>
    var ciudadesGuerrero = new[]
    {
        "Acapulco de Juárez", "Chilpancingo de los Bravo", "Iguala de la Independencia",
        "Zihuatanejo de Azueta", "Taxco de Alarcón", "Técpan de Galeana", "Petatlán",
        "Ayutla de los Libres", "Tlapa de Comonfort", "Coyuca de Benítez",
        "Atoyac de Álvarez", "San Marcos", "Ometepec", "Copala", "Cuautepec",
        "Huitzuco de los Figueroa", "Arcelia", "Teloloapan", "Chilapa de Álvarez",
        "Tixtla de Guerrero", "Pungarabato", "Apaxtla de Castrejón",
        "Buenavista de Cuéllar", "La Unión de Isidoro Montes de Oca", "Otra"
    };

    string ciudadActual = empresa?.Ciudad ?? "";
}

@section Styles {
<style>
    .page-header { margin-bottom: 28px; }
    .page-title  { font-size: 22px; font-weight: 800; margin: 0; }

    .profile-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 28px;
        box-shadow: var(--shadow-sm);
    }

    .profile-banner {
        height: 80px;
        border-radius: var(--radius) var(--radius) 0 0;
        background: linear-gradient(135deg, var(--emp-primary), var(--emp-accent));
        margin: -28px -28px 0;
    }

    .profile-logo {
        width: 72px; height: 72px;
        border-radius: 18px;
        background: #fff;
        border: 3px solid #fff;
        box-shadow: 0 4px 16px rgba(0,0,0,.12);
        display: flex; align-items: center; justify-content: center;
        font-size: 28px; font-weight: 800; color: var(--emp-accent);
        margin-top: -36px; margin-bottom: 12px;
    }

    .section-divider {
        font-size: 11px; font-weight: 700; text-transform: uppercase;
        letter-spacing: .6px; color: var(--text-muted);
        border-bottom: 1px solid var(--border);
        padding-bottom: 8px; margin: 24px 0 16px;
    }

    .form-label-sm {
        font-size: 12px; font-weight: 600; color: var(--text-muted);
        text-transform: uppercase; letter-spacing: .4px;
        margin-bottom: 5px; display: block;
    }

    .form-control, .form-select {
        border-radius: var(--radius-sm);
        border: 1px solid var(--border);
        font-size: 13.5px;
        padding: 9px 13px;
        transition: var(--transition);
    }
    .form-control:focus, .form-select:focus {
        border-color: var(--emp-accent);
        box-shadow: 0 0 0 3px rgba(124,58,237,.12);
    }

    .badge-verificado {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600;
    }
    .badge-verificado.si { background: #dcfce7; color: #166534; }
    .badge-verificado.no { background: #fef3c7; color: #92400e; }

    .btn-save {
        background: var(--emp-accent); color: #fff; border: none;
        border-radius: 10px; padding: 10px 26px;
        font-size: 14px; font-weight: 700; cursor: pointer;
        transition: var(--transition);
    }
    .btn-save:hover { background: var(--emp-primary); }
</style>
}

<div class="page-header">
    <h4 class="page-title">Perfil de la Empresa</h4>
    <p class="mb-0" style="color:var(--text-muted); font-size:13px;">
        Mantén actualizada la información de tu empresa
    </p>
</div>

<div class="row g-4">

    <!-- ── Columna izquierda: tarjeta resumen ─────────────────────────── -->
    <div class="col-12 col-lg-4">
        <div class="profile-card">
            <div class="profile-banner"></div>
            <div class="profile-logo">
                @(string.Join("",
                    (empresa?.NombreEmpresa ?? "E")
                    .Split(' ')
                    .Take(2)
                    .Select(s => s.Length > 0 ? s[0].ToString().ToUpper() : "")))
            </div>

            <h5 class="fw-800 mb-1" style="font-size:17px;">
                @(empresa?.NombreEmpresa ?? "—")
            </h5>
            <div style="font-size:12.5px; color:var(--text-muted); margin-bottom:12px;">
                @(empresa?.RazonSocial ?? "")
            </div>

            <div class="mb-3">
                @if (empresa?.EstaVerificado == true)
                {
                    <span class="badge-verificado si">
                        <i class="fas fa-circle-check"></i> Verificada
                    </span>
                }
                else
                {
                    <span class="badge-verificado no">
                        <i class="fas fa-clock"></i> Pendiente de verificación
                    </span>
                }
            </div>

            <div style="font-size:12.5px; color:var(--text-secondary);">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="fas fa-id-badge" style="color:var(--emp-accent); width:14px;"></i>
                    <span>RFC: <strong>@(empresa?.RFC ?? "—")</strong></span>
                </div>

                @if (!string.IsNullOrEmpty(empresa?.Sector))
                {
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="fas fa-industry" style="color:var(--emp-accent); width:14px;"></i>
                        <span>@empresa!.Sector</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(empresa?.Giro))
                {
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="fas fa-briefcase" style="color:var(--emp-accent); width:14px;"></i>
                        <span>@empresa!.Giro</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(empresa?.Ciudad))
                {
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="fas fa-location-dot" style="color:var(--emp-accent); width:14px;"></i>
                        <span>@empresa!.Ciudad, Guerrero</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(empresa?.TelefonoContacto))
                {
                    <div class="d-flex align-items-center gap-2">
                        <i class="fas fa-phone" style="color:var(--emp-accent); width:14px;"></i>
                        <span>@empresa!.TelefonoContacto</span>
                    </div>
                }
            </div>

            <div style="border-top:1px solid var(--border); margin-top:20px; padding-top:16px; font-size:12px; color:var(--text-muted);">
                Registrada el @(empresa?.FechaRegistro.ToString(
                    "dd 'de' MMMM 'de' yyyy",
                    new System.Globalization.CultureInfo("es-MX")) ?? "—")
            </div>
        </div>
    </div>

    <!-- ── Columna derecha: formulario ───────────────────────────────── -->
    <div class="col-12 col-lg-8">
        <div class="profile-card">
            <form asp-action="GuardarPerfilEmpresa" asp-controller="Dashboard" method="post">
                @Html.AntiForgeryToken()

                <!-- Datos generales -->
                <div class="section-divider">
                    <i class="fas fa-building me-2"></i>Datos de la empresa
                </div>
                <div class="row g-3">

                    <div class="col-12">
                        <label class="form-label-sm">Nombre comercial *</label>
                        <input type="text" name="NombreEmpresa" class="form-control"
                               value="@empresa?.NombreEmpresa" required />
                    </div>

                    <div class="col-12">
                        <label class="form-label-sm">Razón social</label>
                        <input type="text" name="RazonSocial" class="form-control"
                               value="@empresa?.RazonSocial" />
                    </div>

                    <div class="col-md-5">
                        <label class="form-label-sm">RFC</label>
                        <input type="text" name="RFC" class="form-control"
                               value="@empresa?.RFC" maxlength="13"
                               style="text-transform:uppercase;" />
                    </div>

                    <div class="col-md-7">
                        <label class="form-label-sm">Ciudad / Municipio</label>
                        <select name="Ciudad" class="form-select">
                            <option value="">— Selecciona —</option>
                            @foreach (var ciudad in ciudadesGuerrero)
                            {
                                // ── FIX RZ1031: usar @if para emitir el atributo selected,
                                //    nunca ternarios C# dentro de un atributo HTML.
                                if (ciudad == ciudadActual)
                                {
                                    <option value="@ciudad" selected>@ciudad</option>
                                }
                                else
                                {
                                    <option value="@ciudad">@ciudad</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label-sm">Sector</label>
                        <input type="text" name="Sector" class="form-control"
                               value="@empresa?.Sector"
                               placeholder="ej. Tecnologías de la información" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label-sm">Giro / Actividad</label>
                        <input type="text" name="Giro" class="form-control"
                               value="@empresa?.Giro"
                               placeholder="ej. Desarrollo de software a la medida" />
                    </div>

                    <div class="col-12">
                        <label class="form-label-sm">Dirección</label>
                        <input type="text" name="Direccion" class="form-control"
                               value="@empresa?.Direccion"
                               placeholder="Calle, número, colonia…" />
                    </div>

                </div>

                <!-- Persona de contacto -->
                <div class="section-divider mt-4">
                    <i class="fas fa-user-tie me-2"></i>Persona de contacto
                </div>
                <div class="row g-3">

                    <div class="col-12">
                        <label class="form-label-sm">Nombre del responsable de prácticas *</label>
                        <input type="text" name="NombreContacto" class="form-control"
                               value="@empresa?.NombreContacto" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label-sm">Puesto / Cargo</label>
                        <input type="text" name="PuestoContacto" class="form-control"
                               value="@empresa?.PuestoContacto" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label-sm">Teléfono de contacto</label>
                        <input type="tel" name="TelefonoContacto" class="form-control"
                               value="@empresa?.TelefonoContacto"
                               placeholder="744 330 6480" />
                    </div>

                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn-save">
                        <i class="fas fa-floppy-disk me-2"></i>Guardar cambios
                    </button>
                </div>

            </form>
        </div>
    </div>

</div>
