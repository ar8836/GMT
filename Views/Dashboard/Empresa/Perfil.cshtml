@using GMT.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"]        = "Perfil Empresa";
    ViewData["ActiveModule"] = "perfil";
    ViewData["PortalTipo"]   = "empresa";

    var empresa = ViewBag.Empresa as Empresa;

    var ciudadesGuerrero = new[]
    {
        "Acapulco de Juárez","Chilpancingo de los Bravo","Iguala de la Independencia",
        "Zihuatanejo de Azueta","Taxco de Alarcón","Técpan de Galeana","Petatlán",
        "Ayutla de los Libres","Tlapa de Comonfort","Coyuca de Benítez",
        "Atoyac de Álvarez","San Marcos","Ometepec","Copala","Cuautepec",
        "Huitzuco de los Figueroa","Arcelia","Teloloapan","Chilapa de Álvarez",
        "Tixtla de Guerrero","Pungarabato","Apaxtla de Castrejón",
        "Buenavista de Cuéllar","La Unión de Isidoro Montes de Oca","Otra"
    };

    string ciudadActual = empresa?.Ciudad ?? "";
    string empInitials  = string.Join("", (empresa?.NombreEmpresa ?? "E").Split(' ').Take(2).Select(s => s.Length > 0 ? s[0].ToString().ToUpper() : ""));
}

@section Styles {
<style>
    :root { --emp-accent:#7c3aed; --emp-primary:#4c1d95; }

    .profile-card { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:28px; box-shadow:var(--shadow-sm); }
    .profile-banner { height:80px; border-radius:var(--radius) var(--radius) 0 0; background:linear-gradient(135deg,var(--emp-primary),var(--emp-accent)); margin:-28px -28px 0; }

    /* Logo empresa con cámara */
    .logo-wrap { position:relative; width:80px; }
    .profile-logo {
        width:80px; height:80px; border-radius:18px;
        background:#fff; border:3px solid #fff;
        box-shadow:0 4px 16px rgba(0,0,0,.12);
        display:flex; align-items:center; justify-content:center;
        font-size:30px; font-weight:800; color:var(--emp-accent);
        margin-top:-40px; margin-bottom:12px;
        overflow:hidden; cursor:pointer; transition:var(--transition);
    }
    .profile-logo:hover { opacity:.85; }
    .profile-logo img { width:100%; height:100%; object-fit:cover; }
    .logo-edit-btn {
        position:absolute; bottom:16px; right:0;
        width:26px; height:26px; background:var(--emp-accent);
        border-radius:50%; border:2px solid #fff;
        display:flex; align-items:center; justify-content:center;
        font-size:10px; color:#fff; cursor:pointer; transition:var(--transition);
    }
    .logo-edit-btn:hover { background:var(--emp-primary); }

    .section-divider { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.6px; color:var(--text-muted); border-bottom:1px solid var(--border); padding-bottom:8px; margin:24px 0 16px; }
    .form-label-sm { font-size:12px; font-weight:600; color:var(--text-muted); text-transform:uppercase; letter-spacing:.4px; margin-bottom:5px; display:block; }
    .form-control, .form-select { border-radius:var(--radius-sm); border:1px solid var(--border); font-size:13.5px; padding:9px 13px; transition:var(--transition); }
    .form-control:focus, .form-select:focus { border-color:var(--emp-accent); box-shadow:0 0 0 3px rgba(124,58,237,.12); }

    .badge-verificado { display:inline-flex; align-items:center; gap:5px; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600; }
    .badge-verificado.si { background:#dcfce7; color:#166534; }
    .badge-verificado.no { background:#fef3c7; color:#92400e; }

    .btn-save { background:var(--emp-accent); color:#fff; border:none; border-radius:10px; padding:10px 26px; font-size:14px; font-weight:700; cursor:pointer; transition:var(--transition); }
    .btn-save:hover { background:var(--emp-primary); }

    .gmt-toast { position:fixed; bottom:28px; right:28px; z-index:9999; background:#1e293b; color:#fff; padding:14px 20px; border-radius:10px; font-size:13.5px; font-weight:500; display:flex; align-items:center; gap:10px; box-shadow:0 8px 32px rgba(0,0,0,.25); transform:translateY(80px); opacity:0; transition:all .35s cubic-bezier(.4,0,.2,1); }
    .gmt-toast.show { transform:translateY(0); opacity:1; }
    .gmt-toast.ok i { color:#4ade80; }
    .gmt-toast.err i { color:#f87171; }
</style>
}

<div class="mb-4">
    <h4 style="font-size:22px;font-weight:800;margin:0;">Perfil de la Empresa</h4>
    <p style="color:var(--text-muted);font-size:13px;margin:0;">Edita la información de tu empresa</p>
</div>

<div class="row g-4">

    <!-- Tarjeta resumen -->
    <div class="col-12 col-lg-4">
        <div class="profile-card">
            <div class="profile-banner"></div>

            <!-- Logo con botón de cámara -->
            <div class="logo-wrap">
                <div class="profile-logo" id="logoDisplay"
                     onclick="document.getElementById('inputLogoEmp').click()"
                     title="Cambiar logo">
                    @if (!string.IsNullOrEmpty(empresa?.FotoPerfilUrl))
                    {
                        <img src="@empresa!.FotoPerfilUrl" alt="Logo" id="logoImg" />
                    }
                    else
                    {
                        <span id="logoInitials">@empInitials</span>
                    }
                </div>
                <div class="logo-edit-btn" onclick="document.getElementById('inputLogoEmp').click()">
                    <i class="fas fa-camera"></i>
                </div>
            </div>
            <input type="file" id="inputLogoEmp" accept=".jpg,.jpeg,.png,.webp" style="display:none;" />

            <h5 class="fw-800 mb-1" style="font-size:17px;">@(empresa?.NombreEmpresa ?? "—")</h5>
            <div style="font-size:12.5px;color:var(--text-muted);margin-bottom:12px;">@(empresa?.RazonSocial ?? "")</div>

            <div class="mb-3">
                @if (empresa?.EstaVerificado == true)
                {
                    <span class="badge-verificado si"><i class="fas fa-circle-check"></i> Verificada</span>
                }
                else
                {
                    <span class="badge-verificado no"><i class="fas fa-clock"></i> Pendiente de verificación</span>
                }
            </div>

            <div style="font-size:12.5px;color:var(--text-secondary);">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="fas fa-id-badge" style="color:var(--emp-accent);width:14px;"></i>
                    <span>RFC: <strong>@(empresa?.RFC ?? "—")</strong></span>
                </div>
                @if (!string.IsNullOrEmpty(empresa?.Sector))
                {
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="fas fa-industry" style="color:var(--emp-accent);width:14px;"></i>
                        <span>@empresa!.Sector</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(empresa?.Ciudad))
                {
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="fas fa-location-dot" style="color:var(--emp-accent);width:14px;"></i>
                        <span>@empresa!.Ciudad, Guerrero</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(empresa?.TelefonoContacto))
                {
                    <div class="d-flex align-items-center gap-2">
                        <i class="fas fa-phone" style="color:var(--emp-accent);width:14px;"></i>
                        <span>@empresa!.TelefonoContacto</span>
                    </div>
                }
            </div>

            <div style="border-top:1px solid var(--border);margin-top:20px;padding-top:14px;font-size:12px;color:var(--text-muted);">
                Registrada el @(empresa?.FechaRegistro.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-MX")) ?? "—")
            </div>
        </div>
    </div>

    <!-- Formulario -->
    <div class="col-12 col-lg-8">
        <div class="profile-card">
            <form asp-action="GuardarPerfilEmpresa" asp-controller="Dashboard" method="post">
                @Html.AntiForgeryToken()

                <div class="section-divider"><i class="fas fa-building me-2"></i>Datos de la empresa</div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label-sm">Nombre comercial *</label>
                        <input type="text" name="NombreEmpresa" class="form-control" value="@empresa?.NombreEmpresa" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label-sm">Razón social</label>
                        <input type="text" name="RazonSocial" class="form-control" value="@empresa?.RazonSocial" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label-sm">RFC</label>
                        <input type="text" name="RFC" class="form-control" value="@empresa?.RFC" maxlength="13" style="text-transform:uppercase;" />
                    </div>
                    <div class="col-md-7">
                        <label class="form-label-sm">Ciudad / Municipio</label>
                        <select name="Ciudad" class="form-select">
                            <option value="">— Selecciona —</option>
                            @foreach (var ciudad in ciudadesGuerrero)
                            {
                                if (ciudad == ciudadActual)
                                {
                                    <option value="@ciudad" selected>@ciudad</option>
                                }
                                else
                                {
                                    <option value="@ciudad">@ciudad</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-sm">Sector</label>
                        <input type="text" name="Sector" class="form-control" value="@empresa?.Sector" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-sm">Giro / Actividad</label>
                        <input type="text" name="Giro" class="form-control" value="@empresa?.Giro" />
                    </div>
                    <div class="col-12">
                        <label class="form-label-sm">Dirección</label>
                        <input type="text" name="Direccion" class="form-control" value="@empresa?.Direccion" placeholder="Calle, número, colonia…" />
                    </div>
                </div>

                <div class="section-divider mt-4"><i class="fas fa-user-tie me-2"></i>Persona de contacto</div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label-sm">Nombre del responsable *</label>
                        <input type="text" name="NombreContacto" class="form-control" value="@empresa?.NombreContacto" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-sm">Puesto / Cargo</label>
                        <input type="text" name="PuestoContacto" class="form-control" value="@empresa?.PuestoContacto" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-sm">Teléfono</label>
                        <input type="tel" name="TelefonoContacto" class="form-control" value="@empresa?.TelefonoContacto" placeholder="744 330 6480" />
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn-save">
                        <i class="fas fa-floppy-disk me-2"></i>Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="gmt-toast" id="gmtToast">
    <i class="fas fa-circle-check" id="toastIcon"></i>
    <span id="toastMsg">Operación completada</span>
</div>

@section Scripts {
<script>
    function showToast(msg, tipo = 'ok') {
        const t = document.getElementById('gmtToast');
        document.getElementById('toastMsg').textContent = msg;
        document.getElementById('toastIcon').className  = tipo === 'ok' ? 'fas fa-circle-check' : 'fas fa-circle-xmark';
        t.className = `gmt-toast ${tipo}`;
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 3500);
    }

    // Subir logo/foto empresa
    document.getElementById('inputLogoEmp').addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;

        // Vista previa
        const reader = new FileReader();
        reader.onload = ev => {
            document.getElementById('logoDisplay').innerHTML =
                `<img src="${ev.target.result}" alt="Logo" style="width:100%;height:100%;object-fit:cover;">`;
        };
        reader.readAsDataURL(file);

        const fd = new FormData();
        fd.append('file', file);
        try {
            const res  = await fetch('/api/Upload/empresa/photo', { method: 'PUT', body: fd });
            const data = await res.json();
            showToast(res.ok ? 'Logo/foto actualizado ✓' : (data.error ?? 'Error al subir foto'), res.ok ? 'ok' : 'err');
        } catch {
            showToast('Error de conexión', 'err');
        }
    });
</script>
}
