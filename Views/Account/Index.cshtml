<script>
// ══════════════════════════════════════════════════════════
//  UTILIDADES CONTRASEÑA
// ══════════════════════════════════════════════════════════
function togglePw(id, btn) {
    const el = document.getElementById(id);
    const icon = btn.querySelector('i');
    if (el.type === 'password') {
        el.type = 'text';
        icon.className = 'fas fa-eye-slash';
    } else {
        el.type = 'password';
        icon.className = 'fas fa-eye';
    }
}

const PW_RULES = {
    len:   v => v.length >= 8 && v.length <= 16,
    upper: v => /[A-Z]/.test(v),
    lower: v => /[a-z]/.test(v),
    num:   v => /[0-9]/.test(v),
    spec:  v => /[^A-Za-z0-9]/.test(v)
};

function pwValid(v) {
    return Object.values(PW_RULES).every(fn => fn(v));
}

function setRule(id, ok) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.toggle('ok', ok);
    const i = el.querySelector('i');
    i.className = ok ? 'fas fa-circle-check' : 'fas fa-circle-xmark';
}

function checkPwRules(val, prefix) {
    setRule(prefix + '-len',   PW_RULES.len(val));
    setRule(prefix + '-upper', PW_RULES.upper(val));
    setRule(prefix + '-lower', PW_RULES.lower(val));
    setRule(prefix + '-num',   PW_RULES.num(val));
    setRule(prefix + '-spec',  PW_RULES.spec(val));
}

function checkConfirm(pw1Id, pw2Id, msgId, submitId) {
    const v1 = document.getElementById(pw1Id).value;
    const v2 = document.getElementById(pw2Id).value;
    const msg = document.getElementById(msgId);
    const el2 = document.getElementById(pw2Id);
    const btn = document.getElementById(submitId);

    if (!v2) { msg.textContent = ''; el2.classList.remove('pw-match-ok','pw-match-err'); if(btn) btn.disabled = true; return; }

    const valid1 = pwValid(v1);
    const match  = v1 === v2;

    el2.classList.toggle('pw-match-ok',  match);
    el2.classList.toggle('pw-match-err', !match);
    msg.className = 'pw-match-msg mb-reg ' + (match ? 'ok' : 'err');
    msg.textContent = match ? '✓ Las contraseñas coinciden' : '✗ Las contraseñas no coinciden';
    if (btn) btn.disabled = !(valid1 && match); 
}

// Sugerir contraseña aleatoria que cumple todos los requisitos
function suggestPassword(pwId, pw2Id) {
    const upper  = 'ABCDEFGHJKLMNPQRSTUVWXYZ';
    const lower  = 'abcdefghjkmnpqrstuvwxyz';
    const nums   = '23456789';
    const spec   = '!@@#$%^&*-_=+?';
    const all    = upper + lower + nums + spec;
    let pw = '';
    // Garantizar al menos 1 de cada categoría
    pw += upper[Math.floor(Math.random()*upper.length)];
    pw += lower[Math.floor(Math.random()*lower.length)];
    pw += nums[Math.floor(Math.random()*nums.length)];
    pw += spec[Math.floor(Math.random()*spec.length)];
    // Rellenar hasta 12 caracteres
    for (let i = 4; i < 12; i++) pw += all[Math.floor(Math.random()*all.length)];
    // Barajar
    pw = pw.split('').sort(() => Math.random() - 0.5).join('');

    const el1 = document.getElementById(pwId);
    const el2 = document.getElementById(pw2Id);
    el1.value = pw;
    el2.value = pw;
    el1.type = 'text'; // mostrar temporalmente
    el2.type = 'text';
    setTimeout(() => { el1.type = 'password'; el2.type = 'password'; }, 2000);
    el1.dispatchEvent(new Event('input'));
    el2.dispatchEvent(new Event('input'));
}

// ══════════════════════════════════════════════════════════
//  FORMATO TELÉFONO  (XXX XXX XXXX)
// ══════════════════════════════════════════════════════════
function formatPhone(el) {
    let v = el.value.replace(/\D/g, '').slice(0, 10);
    if (v.length > 6)      v = v.slice(0,3) + ' ' + v.slice(3,6) + ' ' + v.slice(6);
    else if (v.length > 3) v = v.slice(0,3) + ' ' + v.slice(3);
    el.value = v;
}

// ══════════════════════════════════════════════════════════
//  GIRO AUTOCOMPLETE
// ══════════════════════════════════════════════════════════
const GIROS = Array.from(document.querySelectorAll('#giro-dropdown .giro-opt')).map(o => o.dataset.val);

document.getElementById('giro-input').addEventListener('input', function() {
    const q = this.value.trim().toLowerCase();
    const dd = document.getElementById('giro-dropdown');
    const opts = dd.querySelectorAll('.giro-opt');
    let anyVisible = false;
    opts.forEach(o => {
        const match = !q || o.dataset.val.toLowerCase().includes(q);
        o.style.display = match ? '' : 'none';
        if (match) anyVisible = true;
    });
    dd.classList.toggle('open', anyVisible && q.length >= 1);
});

document.getElementById('giro-input').addEventListener('focus', function() {
    const q = this.value.trim().toLowerCase();
    if (q.length >= 1) document.getElementById('giro-dropdown').classList.add('open');
});

document.getElementById('giro-dropdown').addEventListener('click', function(e) {
    const opt = e.target.closest('.giro-opt');
    if (!opt) return;
    document.getElementById('giro-input').value = opt.dataset.val;
    this.classList.remove('open');
});

document.addEventListener('click', function(e) {
    if (!e.target.closest('.giro-wrapper')) {
        document.getElementById('giro-dropdown').classList.remove('open');
    }
});

