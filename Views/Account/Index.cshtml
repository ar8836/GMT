@model GMT.Models.LoginViewModel
@{
    ViewData["Title"] = "Portal de Acceso GMT";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-dark: #0f172a;
            --primary-medium: #1e293b;
            --accent-cyan: #06b6d4;
            --accent-violet: #7c3aed;
            --glass-bg: rgba(255, 255, 255, 0.08);
            --glass-border: rgba(255, 255, 255, 0.12);
        }

        body {
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-medium) 50%, var(--accent-violet) 100%);
            min-height: 100vh;
            overflow: visible;
            font-family: 'Segoe UI', system-ui, sans-serif;
        }

        .glass-card {
            height: auto;
        }

        select.form-control {
            color: white !important;
            background-color: rgba(255,255,255,0.07) !important;
        }

        select.form-control option {
            background: #1e293b;
            color: #f1f5f9;
            padding: 10px 14px;
        }

        select.form-control option:hover {
            background: #0f172a;
            color: white;
        }

        select.form-control option:checked {
            background: var(--accent-cyan);
            color: white;
            font-weight: 600;
        }

        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            border-radius: 1.5rem;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            padding: 1.5rem !important;
        }

        .profile-card {
            background: var(--glass-bg);
            border: 2px solid transparent;
            border-radius: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            color: white;
        }

        .profile-card:hover { border-color: var(--accent-cyan); transform: translateY(-4px); }
        .profile-card.active { border-color: var(--accent-cyan); background: rgba(6, 182, 212, 0.1); }

        .form-toggle {
            background: var(--glass-bg);
            border-radius: 2rem;
            padding: 4px;
            width: 200px;
            margin: 0 auto 1rem;
            border: 1px solid var(--glass-border);
        }

        .toggle-option {
            padding: 6px 12px;
            border-radius: 1.5rem;
            cursor: pointer;
            color: rgba(255,255,255,0.7);
            transition: all 0.3s ease;
            text-align: center;
            flex: 1;
        }

        .toggle-option.active {
            background: var(--accent-cyan);
            color: white;
            box-shadow: 0 4px 12px rgba(6, 182, 212, 0.3);
        }

        .form-section {
            display: none;
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .form-section.active {
            display: block;
            opacity: 1;
        }

        .form-control {
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--glass-border);
            color: white;
            border-radius: 0.75rem;
            padding: 8px 12px;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            background: rgba(255,255,255,0.1);
            border-color: var(--accent-cyan);
            box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.2);
            color: white;
        }

        .form-control::placeholder { color: rgba(255,255,255,0.5); }

        .btn-gradient {
            background: linear-gradient(90deg, var(--accent-cyan), var(--accent-violet));
            border: none;
            border-radius: 0.75rem;
            padding: 12px 24px;
            color: white;
            font-weight: 600;
            transition: all 0.3s ease;
            width: 100%;
        }

        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(124, 58, 237, 0.3);
        }

        .text-accent { color: var(--accent-cyan); }

        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .animate-fade-in-up { animation: fadeInUp 0.6s ease forwards; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center p-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 animate-fade-in-up">
                <div class="glass-card p-4 p-md-5">
                    <!-- Header -->
                    <div class="text-center mb-3">
                        <h1 class="text-white display-6 fw-bold mb-1">GMT</h1>
                        <p class="text-white-50 mb-0">Gestor Modular Tecnológico</p>
                    </div>

                    <!-- Profile Selector -->
                    <div class="row no-gutters mb-2">
                        <div class="col-6">
                            <div class="profile-card text-center p-2 active" data-profile="alumno">
                                <i class="fas fa-user-graduate fa-2x text-accent mb-1"></i>
                                <h5 class="text-white mt-0">Soy Alumno</h5>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="profile-card text-center p-2" data-profile="empresa">
                                <i class="fas fa-building fa-2x text-accent mb-1"></i>
                                <h5 class="text-white mt-0">Soy Empresa</h5>
                            </div>
                        </div>
                    </div>

                    <!-- Login/Signup Toggle -->
                    <div class="d-flex form-toggle">
                        <div class="toggle-option active" data-form="login">Iniciar Sesión</div>
                        <div class="toggle-option" data-form="register">Crear Cuenta</div>
                    </div>

                    <!-- Login Form -->
                    <div id="loginForm" class="form-section active">
                        <form asp-action="Login" asp-controller="Account" method="post">
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label text-white-50"></label>
                                <input asp-for="Email" class="form-control" placeholder="Correo electrónico" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="mb-4">
                                <label asp-for="Password" class="form-label text-white-50"></label>
                                <input asp-for="Password" class="form-control" type="password" placeholder="Contraseña" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="mb-3 form-check d-flex align-items-center gap-2" style="padding-left: 0;">
                                <input asp-for="RememberMe" type="checkbox" class="form-check-input" style="width: 18px; height: 18px; margin: 0;" />
                                <label asp-for="RememberMe" class="form-check-label text-white-50 mb-0" style="cursor: pointer;"></label>
                            </div>
                            <button type="submit" class="btn btn-gradient mb-4">
                                <i class="fas fa-sign-in-alt me-2"></i>Iniciar Sesión
                            </button>
                            <div class="text-center">
                                <a href="#" class="text-accent text-decoration-none">¿Olvidaste tu contraseña?</a>
                            </div>
                        </form>
                    </div>

                    <!-- Alumno Register Form -->
                    <div id="registerAlumnoForm" class="form-section">
                        <form asp-action="Register" asp-controller="Account" method="post">
                            <div class="mb-3">
                                <label asp-for="NombreCompleto" class="form-label text-white-50"></label>
                                <input asp-for="NombreCompleto" class="form-control" placeholder="Nombre Completo" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Institucion" class="form-label text-white-50"></label>
                                <input asp-for="Institucion" class="form-control" placeholder="Institución" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Matricula" class="form-label text-white-50"></label>
                                <input asp-for="Matricula" class="form-control" placeholder="Matrícula" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Carrera" class="form-label text-white-50"></label>
                                <input asp-for="Carrera" class="form-control" placeholder="Carrera" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label text-white-50"></label>
                                <input asp-for="Email" class="form-control" placeholder="Correo electrónico" />
                            </div>
                            <div class="mb-4">
                                <label asp-for="Password" class="form-label text-white-50"></label>
                                <input asp-for="Password" class="form-control" type="password" placeholder="Contraseña" />
                            </div>
                            <button type="submit" class="btn btn-gradient mb-4">
                                <i class="fas fa-user-plus me-2"></i>Crear Cuenta
                            </button>
                        </form>
                    </div>

                    <!-- Empresa Register Form -->
                    <div id="registerEmpresaForm" class="form-section">
                        <form asp-action="Register" asp-controller="EmpresaAuth" method="post">
                            <div class="mb-3">
                                <label asp-for="NombreEmpresa" class="form-label text-white-50"></label>
                                <input asp-for="NombreEmpresa" class="form-control" placeholder="Nombre de la Empresa" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="RFC" class="form-label text-white-50"></label>
                                <input asp-for="RFC" class="form-control" placeholder="RFC (12 caracteres)" />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Sector" class="form-label text-white-50"></label>
                                <select asp-for="Sector" class="form-control">
                                    <option value="">Selecciona un sector</option>
                                    <option value="Tecnología">Tecnología</option>
                                    <option value="Salud">Salud</option>
                                    <option value="Educación">Educación</option>
                                    <option value="Finanzas">Finanzas</option>
                                    <option value="Otro">Otro</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label text-white-50"></label>
                                <input asp-for="Email" class="form-control" placeholder="Correo electrónico" />
                            </div>
                            <div class="mb-4">
                                <label asp-for="Password" class="form-label text-white-50"></label>
                                <input asp-for="Password" class="form-control" type="password" placeholder="Contraseña" />
                            </div>
                            <button type="submit" class="btn btn-gradient mb-4">
                                <i class="fas fa-building me-2"></i>Crear Cuenta Empresarial
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Profile Selector
            $('.profile-card').click(function () {
                $('.profile-card').removeClass('active');
                $(this).addClass('active');
                const profile = $(this).data('profile');
                if (profile === 'alumno') {
                    $('#registerEmpresaForm').removeClass('active');
                    if ($('.toggle-option[data-form="register"]').hasClass('active')) {
                        $('#registerAlumnoForm').addClass('active');
                    }
                } else {
                    $('#registerAlumnoForm').removeClass('active');
                    if ($('.toggle-option[data-form="register"]').hasClass('active')) {
                        $('#registerEmpresaForm').addClass('active');
                    }
                }
            });

            // Login/Signup Toggle
            $('.toggle-option').click(function () {
                $('.toggle-option').removeClass('active');
                $(this).addClass('active');
                const formType = $(this).data('form');
                $('.form-section').removeClass('active');
                if (formType === 'login') {
                    $('#loginForm').addClass('active');
                } else {
                    const activeProfile = $('.profile-card.active').data('profile');
                    if (activeProfile === 'alumno') {
                        $('#registerAlumnoForm').addClass('active');
                    } else {
                        $('#registerEmpresaForm').addClass('active');
                    }
                }
            });
        });
    </script>
</body>
</html>