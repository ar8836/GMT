// ══════════════════════════════════════════════════════════
//  NAVEGACIÓN PERFIL / TOGGLE
// ══════════════════════════════════════════════════════════
$(document).ready(function() {
    $('.profile-card').click(function() {
        $('.profile-card').removeClass('active');
        $(this).addClass('active');
        const profile = $(this).data('profile');
        $('#login-tipo').val(profile === 'alumno' ? 'Alumno' : 'Empresa');
        if (profile === 'alumno') {
            $('#registerEmpresaForm').removeClass('active');
            if ($('.toggle-option[data-form="register"]').hasClass('active')) $('#registerAlumnoForm').addClass('active');
        } else {
            $('#registerAlumnoForm').removeClass('active');
            if ($('.toggle-option[data-form="register"]').hasClass('active')) $('#registerEmpresaForm').addClass('active');
        }
    });

    $('.toggle-option').click(function() {
        $('.toggle-option').removeClass('active');
        $(this).addClass('active');
        const formType = $(this).data('form');
        $('.form-section').removeClass('active');
        if (formType === 'login') {
            $('#loginForm').addClass('active');
        } else {
            const p = $('.profile-card.active').data('profile');
            $('#' + (p === 'alumno' ? 'registerAlumnoForm' : 'registerEmpresaForm')).addClass('active');
        }
    });

    // Auto-selección desde query params de la landing
    const params = new URLSearchParams(window.location.search);
    if (params.get('perfil') === 'empresa') $('[data-profile="empresa"]').trigger('click');
    if (params.get('modo')   === 'register') $('[data-form="register"]').trigger('click');
});

// ══════════════════════════════════════════════════════════
//  VALIDACIÓN RFC — formato SAT mexicano
//  Persona moral:  3 letras + 6 dígitos fecha + 3 alfanum = 12
//  Persona física: 4 letras + 6 dígitos fecha + 3 alfanum = 13
// ══════════════════════════════════════════════════════════
const RFC_RE = /^([A-ZÑ&]{3,4})[0-9]{6}([A-Z0-9]{3})$/i;

function validarRFC(rfc) {
    return RFC_RE.test(rfc.trim().replace(/\s/g, ''));
}

const rfcInput = document.getElementById('emp-rfc');
const rfcMsg   = document.getElementById('rfc-msg');

if (rfcInput) {
    rfcInput.addEventListener('input', function () {
        this.value = this.value.toUpperCase();
        const val  = this.value.trim();
        if (!val) { rfcMsg.style.display = 'none'; rfcInput.style.border = ''; return; }
        rfcMsg.style.display = 'block';
        if (validarRFC(val)) {
            rfcMsg.innerHTML   = '<i class="fas fa-circle-check" style="color:#4ade80;"></i> Formato válido';
            rfcMsg.style.color = '#4ade80';
            rfcInput.style.border = '';
        } else {
            const faltante = val.length < 12 ? ` (faltan ${12 - val.length}+ chars)` : '';
            rfcMsg.innerHTML   = `<i class="fas fa-circle-xmark" style="color:#f87171;"></i> Formato incorrecto${faltante}`;
            rfcMsg.style.color = '#f87171';
            rfcInput.style.border = '1px solid #f87171';
        }
        actualizarBotonEmpresa();
    });
}

// ══════════════════════════════════════════════════════════
//  VALIDACIÓN FORM EMPRESA al submit
// ══════════════════════════════════════════════════════════
function validarFormEmpresa(e) {
    const errStyle = '1px solid #f87171';
    let primerError = null;

    function check(id) {
        const el = document.getElementById(id);
        if (!el) return true;
        const empty = !el.value || !el.value.trim();
        el.style.border = empty ? errStyle : '';
        if (empty && !primerError) primerError = el;
        return !empty;
    }

    const ok = [
        check('emp-rfc'),
        check('emp-ciudad'),
        check('emp-sector'),
        check('giro-input'),
    ].every(Boolean) && validarRFC(document.getElementById('emp-rfc')?.value ?? '');

    if (!ok) { e.preventDefault(); if (primerError) primerError.focus(); return false; }
    return true;
}

// Limpiar bordes rojos al interactuar
['emp-ciudad', 'emp-sector'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('change', () => { el.style.border = ''; actualizarBotonEmpresa(); });
});

// ══════════════════════════════════════════════════════════
//  HABILITAR BOTÓN EMPRESA
//  Condiciones: pw válida + pw coinciden + RFC válido + giro
// ══════════════════════════════════════════════════════════
function actualizarBotonEmpresa() {
    const pw1  = document.getElementById('emp-pw')?.value    ?? '';
    const pw2  = document.getElementById('emp-pw2')?.value   ?? '';
    const rfc  = document.getElementById('emp-rfc')?.value   ?? '';
    const giro = document.getElementById('giro-input')?.value.trim() ?? '';
    const btn  = document.getElementById('emp-submit');
    if (!btn) return;
    btn.disabled = !(pwValid(pw1) && pw1 === pw2 && validarRFC(rfc) && giro.length > 0);
}

// Enganchar actualizarBotonEmpresa a los watchers de contraseña
['emp-pw','emp-pw2'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', actualizarBotonEmpresa);
});
document.getElementById('giro-input')?.addEventListener('input', actualizarBotonEmpresa);

// ══════════════════════════════════════════════════════════
//  VALIDACIÓN SELECTS ALUMNO (carrera y semestre)
// ══════════════════════════════════════════════════════════
function validarSelectsAlumno(e) {
    const errStyle = '1px solid #f87171';
    let ok = true;
    ['alumno-carrera','alumno-semestre'].forEach(id => {
        const el = document.getElementById(id);
        if (!el || !el.value) { if(el) el.style.border = errStyle; ok = false; }
        else el.style.border = '';
    });
    if (!ok) { e.preventDefault(); return false; }
    return true;
}
['alumno-carrera','alumno-semestre'].forEach(id => {
    document.getElementById(id)?.addEventListener('change', e => { e.target.style.border = ''; });
});

</script>
