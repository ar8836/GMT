@model GMT.Models.LoginViewModel
@{
    ViewData["Title"] = "Portal de Acceso GMT";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-dark: #0f172a;
            --primary-medium: #1e293b;
            --accent-cyan: #06b6d4;
            --accent-violet: #7c3aed;
            --glass-bg: rgba(255, 255, 255, 0.08);
            --glass-border: rgba(255, 255, 255, 0.12);
        }

        body {
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-medium) 50%, var(--accent-violet) 100%);
            min-height: 100vh;
            overflow: visible;
            font-family: 'Segoe UI', system-ui, sans-serif;
        }

        .glass-card { height: auto; }

        select.form-control {
            color: white !important;
            background-color: rgba(255,255,255,0.07) !important;
        }
        select.form-control option {
            background: #1e293b;
            color: #f1f5f9;
        }
        select.form-control option:checked {
            background: var(--accent-cyan);
            color: white;
            font-weight: 600;
        }

        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            border-radius: 1.5rem;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
            padding: 1.5rem !important;
        }

        .profile-card {
            background: var(--glass-bg);
            border: 2px solid transparent;
            border-radius: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            color: white;
        }
        .profile-card:hover { border-color: var(--accent-cyan); transform: translateY(-4px); }
        .profile-card.active { border-color: var(--accent-cyan); background: rgba(6,182,212,0.1); }

        .form-toggle {
            background: var(--glass-bg);
            border-radius: 2rem;
            padding: 4px;
            width: 200px;
            margin: 0 auto 1rem;
            border: 1px solid var(--glass-border);
        }

        .toggle-option {
            padding: 6px 12px;
            border-radius: 1.5rem;
            cursor: pointer;
            color: rgba(255,255,255,0.7);
            transition: all 0.3s ease;
            text-align: center;
            flex: 1;
        }
        .toggle-option.active {
            background: var(--accent-cyan);
            color: white;
            box-shadow: 0 4px 12px rgba(6,182,212,0.3);
        }

        .form-section { display: none; opacity: 0; transition: opacity 0.4s ease; }
        .form-section.active { display: block; opacity: 1; }

        .form-control {
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--glass-border);
            color: white;
            border-radius: 0.75rem;
            padding: 5px 10px;
            font-size: 0.875rem;
            transition: all 0.3s ease;
        }
        .form-control:focus {
            background: rgba(255,255,255,0.1);
            border-color: var(--accent-cyan);
            box-shadow: 0 0 0 3px rgba(6,182,212,0.2);
            color: white;
        }
        .form-control::placeholder { color: rgba(255,255,255,0.5); }

        .btn-gradient {
            background: linear-gradient(90deg, var(--accent-cyan), var(--accent-violet));
            border: none;
            border-radius: 0.75rem;
            padding: 10px 24px;
            color: white;
            font-weight: 600;
            transition: all 0.3s ease;
            width: 100%;
        }
        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(124,58,237,0.3);
        }

        .text-accent { color: var(--accent-cyan); }

        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in-up { animation: fadeInUp 0.6s ease forwards; }

        .form-section-label {
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--accent-cyan);
            opacity: 0.85;
            margin: 0.6rem 0 0.3rem;
        }

        .mb-reg { margin-bottom: 0.45rem !important; }

        /* ── Ojo contraseña ─────────────────────────────── */
        .pw-wrap { position: relative; }
        .pw-wrap .form-control { padding-right: 2.4rem; }
        .pw-eye {
            position: absolute;
            right: 0.65rem; top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: rgba(255,255,255,0.4);
            font-size: 0.85rem;
            transition: color 0.2s;
            z-index: 5;
            background: none; border: none; padding: 0;
        }
        .pw-eye:hover { color: var(--accent-cyan); }

        /* ── Requisitos contraseña ──────────────────────── */
        .pw-rules {
            font-size: 0.72rem;
            margin-top: 0.3rem;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.15rem 0.5rem;
        }
        .pw-rule { color: rgba(255,255,255,0.35); transition: color 0.25s; display: flex; align-items: center; gap: 0.3rem; }
        .pw-rule.ok { color: #4ade80; }
        .pw-rule i { font-size: 0.65rem; width: 10px; }

        /* ── Sugerir contraseña ─────────────────────────── */
        .btn-suggest {
            background: rgba(6,182,212,0.1);
            border: 1px solid rgba(6,182,212,0.3);
            color: var(--accent-cyan);
            border-radius: 0.5rem;
            font-size: 0.7rem;
            padding: 2px 8px;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }
        .btn-suggest:hover { background: rgba(6,182,212,0.2); }

        /* ── Código de país ─────────────────────────────── */
        .phone-wrap { display: flex; gap: 0.35rem; }
        .phone-wrap .country-code {
            background: rgba(255,255,255,0.07);
            border: 1px solid var(--glass-border);
            color: white;
            border-radius: 0.75rem;
            padding: 5px 8px;
            font-size: 0.875rem;
            width: 90px;
            flex-shrink: 0;
        }
        .phone-wrap .form-control { flex: 1; }

        /* ── Giro autocomplete ──────────────────────────── */
        .giro-wrapper { position: relative; }
        .giro-dropdown {
            position: absolute;
            top: 100%; left: 0; right: 0;
            background: #1e293b;
            border: 1px solid var(--glass-border);
            border-radius: 0 0 0.75rem 0.75rem;
            max-height: 198px;
            overflow-y: auto;
            z-index: 999;
            display: none;
        }
        .giro-dropdown.open { display: block; }
        .giro-opt {
            padding: 5px 10px;
            font-size: 0.82rem;
            color: #f1f5f9;
            cursor: pointer;
            border-bottom: 1px solid rgba(255,255,255,0.04);
        }
        .giro-opt:hover, .giro-opt.highlighted { background: rgba(6,182,212,0.15); color: var(--accent-cyan); }
        .giro-dropdown::-webkit-scrollbar { width: 5px; }
        .giro-dropdown::-webkit-scrollbar-thumb { background: rgba(6,182,212,0.3); border-radius: 3px; }

        /* ── Confirmación contraseña match ──────────────── */
        .pw-match-ok  { border-color: #4ade80 !important; }
        .pw-match-err { border-color: #f87171 !important; }
        .pw-match-msg { font-size: 0.68rem; margin-top: 2px; }
        .pw-match-msg.ok  { color: #4ade80; }
        .pw-match-msg.err { color: #f87171; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center p-4">
<div class="container">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 animate-fade-in-up">
            <div class="glass-card p-4 p-md-5">

                <!-- Header -->
                <div class="text-center mb-3">
                    <h1 class="text-white display-6 fw-bold mb-1">GMT</h1>
                    <p class="text-white-50 mb-0">Gestor Modular Tecnológico</p>
                </div>

                <!-- Selector de perfil -->
                <div class="row no-gutters mb-2">
                    <div class="col-6">
                        <div class="profile-card text-center p-2 active" data-profile="alumno">
                            <i class="fas fa-user-graduate fa-2x text-accent mb-1"></i>
                            <h5 class="text-white mt-0">Soy Alumno</h5>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="profile-card text-center p-2" data-profile="empresa">
                            <i class="fas fa-building fa-2x text-accent mb-1"></i>
                            <h5 class="text-white mt-0">Soy Empresa</h5>
                        </div>
                    </div>
                </div>

                <!-- Toggle Login / Registro -->
                <div class="d-flex form-toggle">
                    <div class="toggle-option active" data-form="login">Iniciar Sesión</div>
                    <div class="toggle-option" data-form="register">Crear Cuenta</div>
                </div>

                <!-- ══════════════════════ LOGIN ══════════════════════ -->
                <div id="loginForm" class="form-section active">
                    <form asp-action="Login" asp-controller="Account" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TipoRegistro" id="login-tipo" value="Alumno" />

                        <div class="mb-reg">
                            <input asp-for="Email" class="form-control" placeholder="Correo electrónico" autocomplete="username" />
                        </div>
                        <div class="mb-reg pw-wrap">
                            <input id="login-pw" asp-for="Password" class="form-control" type="password" placeholder="Contraseña" autocomplete="current-password" />
                            <button type="button" class="pw-eye" onclick="togglePw('login-pw',this)"><i class="fas fa-eye"></i></button>
                        </div>
                        <div class="mb-3 form-check d-flex align-items-center gap-2" style="padding-left:0;">
                            <input asp-for="RecordarCredenciales" type="checkbox" class="form-check-input" style="width:18px;height:18px;margin:0;" />
                            <label asp-for="RecordarCredenciales" class="form-check-label text-white-50 mb-0" style="cursor:pointer;"></label>
                        </div>
                        <button type="submit" class="btn btn-gradient mb-4">
                            <i class="fas fa-sign-in-alt me-2"></i>Iniciar Sesión
                        </button>
                        <div class="text-center">
                            <a href="#" class="text-accent text-decoration-none">¿Olvidaste tu contraseña?</a>
                        </div>
                    </form>
                </div>

                <!-- ══════════════════════ REGISTRO ALUMNO ══════════════════════ -->
                <div id="registerAlumnoForm" class="form-section">
                    <form asp-action="Register" asp-controller="Account" method="post">
                        <input type="hidden" name="TipoRegistro" value="Alumno" />

                        <!-- Datos personales -->
                        <p class="form-section-label"><i class="fas fa-id-card me-1"></i>Datos personales</p>

                        <div class="mb-reg">
                            <input asp-for="NombreCompleto" class="form-control" placeholder="Nombre completo" />
                        </div>

                        <div class="row g-2 mb-reg">
                            <div class="col-7">
                                <input asp-for="Matricula" class="form-control" placeholder="Número de control" />
                            </div>
                            <div class="col-5">
                                <div class="phone-wrap">
                                    <select class="form-control country-code" id="alumno-phone-code" name="TelefonoCodigoPais">
                                        <option value="+52" selected>🇲🇽 +52</option>
                                        <option value="+1">🇺🇸 +1</option>
                                        <option value="+1-CA">🇨🇦 +1</option>
                                        <option value="+34">🇪🇸 +34</option>
                                        <option value="+57">🇨🇴 +57</option>
                                        <option value="+54">🇦🇷 +54</option>
                                        <option value="+56">🇨🇱 +56</option>
                                        <option value="+51">🇵🇪 +51</option>
                                    </select>
                                    <input asp-for="Telefono" class="form-control" id="alumno-phone" placeholder="744 330 6480" maxlength="12" inputmode="numeric" />
                                </div>
                            </div>
                        </div>

                        <!-- Datos académicos -->
                        <p class="form-section-label"><i class="fas fa-graduation-cap me-1"></i>Datos académicos</p>

                        <div class="row g-2 mb-reg">
                            <div class="col-8">
                                <select asp-for="Carrera" class="form-control">
                                    <option value="" disabled selected hidden>Carrera</option>
                                    <option value="ISC">Ing. en Sistemas Computacionales</option>
                                    <option value="IIA">Ing. en Inteligencia Artificial</option>
                                    <option value="ICI">Ing. Civil</option>
                                    <option value="IElect">Ing. Eléctrica</option>
                                    <option value="IEM">Ing. Electromecánica</option>
                                    <option value="IQ">Ing. Química</option>
                                    <option value="IGE">Ing. en Gestión Empresarial</option>
                                    <option value="LA">Lic. en Administración</option>
                                    <option value="CP">Contador Público</option>
                                </select>
                            </div>
                            <div class="col-4">
                                <select asp-for="Semestre" class="form-control">
                                    <option value="" disabled selected hidden>Semestre en Curso</option>
                                    <option value="1">1°</option>
                                    <option value="2">2°</option>
                                    <option value="3">3°</option>
                                    <option value="4">4°</option>
                                    <option value="5">5°</option>
                                    <option value="6">6°</option>
                                    <option value="7">7°</option>
                                    <option value="8">8°</option>
                                    <option value="9">9°</option>
                                    <option value="10">10°</option>
                                </select>
                            </div>
                        </div>

                        <!-- Acceso -->
                        <p class="form-section-label"><i class="fas fa-lock me-1"></i>Acceso</p>

                        <div class="mb-reg">
                            <input asp-for="Email" class="form-control" id="alumno-email" placeholder="Correo institucional" autocomplete="username" />
                        </div>

                        <div class="mb-reg pw-wrap">
                            <input class="form-control" id="alumno-pw" name="Password" type="password" placeholder="Contraseña" autocomplete="new-password" />
                            <button type="button" class="pw-eye" onclick="togglePw('alumno-pw',this)"><i class="fas fa-eye"></i></button>
                        </div>
                        <div class="pw-rules mb-reg" id="alumno-pw-rules">
                            <span class="pw-rule" id="ar-len"><i class="fas fa-circle-xmark"></i>8–16 caracteres</span>
                            <span class="pw-rule" id="ar-upper"><i class="fas fa-circle-xmark"></i>Mayúscula</span>
                            <span class="pw-rule" id="ar-lower"><i class="fas fa-circle-xmark"></i>Minúscula</span>
                            <span class="pw-rule" id="ar-num"><i class="fas fa-circle-xmark"></i>Número</span>
                            <span class="pw-rule" id="ar-spec"><i class="fas fa-circle-xmark"></i>Carácter especial</span>
                            <span style="display:flex;align-items:center;">
                                <button type="button" class="btn-suggest" onclick="suggestPassword('alumno-pw','alumno-pw2')">
                                    <i class="fas fa-wand-magic-sparkles me-1"></i>Sugerir
                                </button>
                            </span>
                        </div>

                        <div class="mb-reg pw-wrap">
                            <input class="form-control" id="alumno-pw2" name="ConfirmPassword" type="password" placeholder="Confirmar contraseña" autocomplete="new-password" />
                            <button type="button" class="pw-eye" onclick="togglePw('alumno-pw2',this)"><i class="fas fa-eye"></i></button>
                        </div>
                        <div class="pw-match-msg mb-reg" id="alumno-pw-match"></div>

                        <button type="submit" class="btn btn-gradient mb-2" id="alumno-submit" disabled>
                            <i class="fas fa-user-plus me-2"></i>Crear Cuenta
                        </button>
                    </form>
                </div>

                <!-- ══════════════════════ REGISTRO EMPRESA ══════════════════════ -->
                <div id="registerEmpresaForm" class="form-section">
                    <form asp-action="Register" asp-controller="Account" method="post">
                        <input type="hidden" name="TipoRegistro" value="Empresa" />

                        <!-- Datos de la empresa -->
                        <p class="form-section-label"><i class="fas fa-building me-1"></i>Datos de la empresa</p>

                        <div class="mb-reg">
                            <input asp-for="NombreEmpresa" class="form-control" placeholder="Nombre comercial de la empresa" required />
                        </div>
                        <div class="mb-reg">
                            <input asp-for="RazonSocial" class="form-control" placeholder="Razón social" required />
                        </div>
                        <div class="row g-2 mb-reg">
                            <div class="col-5">
                                <input asp-for="RFC" class="form-control" id="emp-rfc" placeholder="RFC (12 o 13 car.)" maxlength="13" style="text-transform:uppercase;" required />
                                <div id="rfc-msg" style="font-size:0.68rem;margin-top:3px;display:none;"></div>
                            </div>
                            <div class="col-7">
                                <select asp-for="Ciudad" class="form-control" id="emp-ciudad" required>
                                    <option value="" disabled selected hidden>Ciudad / Municipio</option>
                                    <option>Acapulco de Juárez</option>
                                    <option>Chilpancingo de los Bravo</option>
                                    <option>Iguala de la Independencia</option>
                                    <option>Zihuatanejo de Azueta</option>
                                    <option>Taxco de Alarcón</option>
                                    <option>Técpan de Galeana</option>
                                    <option>Petatlán</option>
                                    <option>Ayutla de los Libres</option>
                                    <option>Tlapa de Comonfort</option>
                                    <option>Coyuca de Benítez</option>
                                    <option>Atoyac de Álvarez</option>
                                    <option>San Marcos</option>
                                    <option>Ometepec</option>
                                    <option>Copala</option>
                                    <option>Cuautepec</option>
                                    <option>Huitzuco de los Figueroa</option>
                                    <option>Arcelia</option>
                                    <option>Teloloapan</option>
                                    <option>Chilapa de Álvarez</option>
                                    <option>Mochitlán</option>
                                    <option>Tixtla de Guerrero</option>
                                    <option>Copalillo</option>
                                    <option>Benito Juárez</option>
                                    <option>La Unión de Isidoro Montes de Oca</option>
                                    <option>Pungarabato</option>
                                    <option>Apaxtla de Castrejón</option>
                                    <option>Buenavista de Cuéllar</option>
                                    <option>Cocula</option>
                                    <option>Quechultenango</option>
                                    <option>Otra</option>
                                </select>
                            </div>
                        </div>
                        <div class="row g-2 mb-reg">
                            <div class="col-6">
                                <select asp-for="Sector" class="form-control" id="emp-sector" required>
                                    <option value="" disabled selected hidden>Sector</option>
                                    <option>Comercio al por menor</option>
                                    <option>Comercio al por mayor</option>
                                    <option>Servicios de alojamiento y preparación de alimentos</option>
                                    <option>Servicios profesionales, científicos y técnicos</option>
                                    <option>Servicios de salud y asistencia social</option>
                                    <option>Servicios educativos</option>
                                    <option>Servicios de esparcimiento, culturales y deportivos</option>
                                    <option>Servicios financieros y de seguros</option>
                                    <option>Servicios inmobiliarios y de alquiler</option>
                                    <option>Servicios de transporte, logística y almacenamiento</option>
                                    <option>Servicios de reparación y mantenimiento</option>
                                    <option>Servicios de limpieza, gestión de residuos y saneamiento</option>
                                    <option>Servicios de seguridad e investigación</option>
                                    <option>Servicios de telecomunicaciones</option>
                                    <option>Servicios de publicidad, marketing y estudios de mercado</option>
                                    <option>Industrias manufactureras</option>
                                    <option>Construcción</option>
                                    <option>Agricultura, cría y explotación de animales</option>
                                    <option>Generación y distribución de energía y agua</option>
                                    <option>Tecnologías de la información y comunicación</option>
                                    <option>Servicios personales y del hogar</option>
                                    <option>Servicios religiosos y asociaciones</option>
                                </select>
                            </div>
                            <div class="col-6 giro-wrapper">
                                <input type="text" name="Giro" id="giro-input" class="form-control" placeholder="Giro / Actividad" autocomplete="off" required />
                                <div class="giro-dropdown" id="giro-dropdown">
                                    <div class="giro-opt" data-val="Abarrotes y misceláneas">Abarrotes y misceláneas</div>
                                    <div class="giro-opt" data-val="Agencia de aduanas">Agencia de aduanas</div>
                                    <div class="giro-opt" data-val="Agencia de autos usados">Agencia de autos usados</div>
                                    <div class="giro-opt" data-val="Agencia de carga y logística">Agencia de carga y logística</div>
                                    <div class="giro-opt" data-val="Agencia de cobranza">Agencia de cobranza</div>
                                    <div class="giro-opt" data-val="Agencia de eventos sociales">Agencia de eventos sociales</div>
                                    <div class="giro-opt" data-val="Agencia de festejos infantiles">Agencia de festejos infantiles</div>
                                    <div class="giro-opt" data-val="Agencia de marketing digital">Agencia de marketing digital</div>
                                    <div class="giro-opt" data-val="Agencia de modelaje y edecanes">Agencia de modelaje y edecanes</div>
                                    <div class="giro-opt" data-val="Agencia de publicidad">Agencia de publicidad</div>
                                    <div class="giro-opt" data-val="Agencia de relaciones públicas">Agencia de relaciones públicas</div>
                                    <div class="giro-opt" data-val="Agencia de seguros">Agencia de seguros</div>
                                    <div class="giro-opt" data-val="Agencia de traducción e interpretación">Agencia de traducción e interpretación</div>
                                    <div class="giro-opt" data-val="Agencia de viajes y turismo">Agencia de viajes y turismo</div>
                                    <div class="giro-opt" data-val="Agencia investigadora de mercado">Agencia investigadora de mercado</div>
                                    <div class="giro-opt" data-val="Agencia naviera y fletes marítimos">Agencia naviera y fletes marítimos</div>
                                    <div class="giro-opt" data-val="Alimentos balanceados para animales">Alimentos balanceados para animales</div>
                                    <div class="giro-opt" data-val="Alimentos procesados y conservas">Alimentos procesados y conservas</div>
                                    <div class="giro-opt" data-val="Alquiler de autos sin chofer">Alquiler de autos sin chofer</div>
                                    <div class="giro-opt" data-val="Alquiler de disfraces y vestuario">Alquiler de disfraces y vestuario</div>
                                    <div class="giro-opt" data-val="Alquiler de equipo de construcción">Alquiler de equipo de construcción</div>
                                    <div class="giro-opt" data-val="Alquiler de equipo médico">Alquiler de equipo médico</div>
                                    <div class="giro-opt" data-val="Alquiler de inflables y brincolines">Alquiler de inflables y brincolines</div>
