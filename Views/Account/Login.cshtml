@{
    Layout = null; // Vista independiente, sin layout del dashboard
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMT — Iniciar Sesión</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />

    <style>
        :root {
            --navy:      #002366;
            --navy-dark: #001540;
            --navy-mid:  #00307a;
            --accent:    #4a90d9;
            --accent-br: #5ba3f5;
            --bg:        #f0f3f8;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Background dividido ─────────────────────── */
        .login-bg {
            position: fixed;
            inset: 0;
            display: grid;
            grid-template-columns: 1fr 1fr;
            z-index: 0;
        }

        .bg-left {
            background: linear-gradient(160deg, var(--navy-dark) 0%, var(--navy) 50%, var(--navy-mid) 100%);
            position: relative;
            overflow: hidden;
        }

        /* Geometric shapes en el fondo izquierdo */
        .bg-left::before {
            content: '';
            position: absolute;
            width: 500px; height: 500px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(74,144,217,.18) 0%, transparent 65%);
            top: -100px; right: -150px;
        }

        .bg-left::after {
            content: '';
            position: absolute;
            width: 300px; height: 300px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(74,144,217,.1) 0%, transparent 65%);
            bottom: -80px; left: -60px;
        }

        .bg-right {
            background: var(--bg);
        }

        /* Grid pattern sutil */
        .bg-left .grid-pattern {
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
            background-size: 40px 40px;
        }

        /* Contenido ilustrativo izquierda */
        .brand-panel {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 48px;
            z-index: 1;
        }

        .brand-logo-lg {
            width: 72px; height: 72px;
            background: linear-gradient(135deg, var(--accent), var(--accent-br));
            border-radius: 20px;
            display: flex; align-items: center; justify-content: center;
            font-size: 30px;
            color: #fff;
            box-shadow: 0 12px 40px rgba(74,144,217,.45);
            margin-bottom: 24px;
            animation: logoFloat 4s ease-in-out infinite;
        }

        @@keyframes logoFloat {
            0%, 100% { transform: translateY(0px); }
            50%       { transform: translateY(-8px); }
        }

        .brand-tagline-main {
            font-size: 32px;
            font-weight: 800;
            color: #fff;
            text-align: center;
            line-height: 1.15;
            letter-spacing: -.5px;
            margin-bottom: 12px;
        }

        .brand-tagline-sub {
            font-size: 13px;
            color: rgba(255,255,255,.5);
            text-align: center;
            max-width: 280px;
            line-height: 1.7;
        }

        /* Pills de módulos */
        .module-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 36px;
            justify-content: center;
        }

        .module-pill {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 14px;
            border-radius: 24px;
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.12);
            color: rgba(255,255,255,.75);
            font-size: 12px;
            font-weight: 500;
            backdrop-filter: blur(8px);
        }

        .module-pill i {
            color: var(--accent-br);
            font-size: 11px;
        }

        /* Versión badge */
        .version-tag {
            position: absolute;
            bottom: 28px;
            font-size: 10.5px;
            font-family: 'Space Mono', monospace;
            color: rgba(255,255,255,.25);
            letter-spacing: 1.2px;
        }

        /* ── Login Card ──────────────────────────────── */
        .login-container {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 420px;
            padding: 24px;
            animation: cardEntry .5s cubic-bezier(.4,0,.2,1) both;
        }

        @@keyframes cardEntry {
            from { opacity: 0; transform: translateY(24px) scale(.97); }
            to   { opacity: 1; transform: translateY(0)   scale(1); }
        }

        .login-card {
            background: #fff;
            border-radius: 20px;
            padding: 44px 40px;
            box-shadow:
                0 2px 4px rgba(0,35,102,.04),
                0 8px 24px rgba(0,35,102,.08),
                0 24px 64px rgba(0,35,102,.10);
            border: 1px solid rgba(0,35,102,.06);
        }

        /* Header de la card */
        .card-header-gmt {
            margin-bottom: 32px;
        }

        .card-eyebrow {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
        }

        .eyebrow-dot {
            width: 8px; height: 8px;
            background: var(--accent);
            border-radius: 50%;
            animation: dotPulse 2s ease-in-out infinite;
        }

        @@keyframes dotPulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50%       { opacity: .5; transform: scale(.75); }
        }

        .eyebrow-text {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            color: var(--accent);
            font-family: 'Space Mono', monospace;
        }

        .card-title {
            font-size: 26px;
            font-weight: 800;
            color: var(--navy-dark);
            letter-spacing: -.4px;
            line-height: 1.15;
        }

        .card-subtitle {
            font-size: 13px;
            color: #8492a6;
            margin-top: 6px;
        }

        /* Form elements */
        .form-group-gmt {
            margin-bottom: 18px;
        }

        .form-label-gmt {
            display: block;
            font-size: 12.5px;
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 7px;
            letter-spacing: .2px;
        }

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #8492a6;
            font-size: 13px;
            pointer-events: none;
            transition: color .2s;
        }

        .form-input-gmt {
            width: 100%;
            padding: 11px 42px 11px 40px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            font-size: 14px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: var(--navy-dark);
            background: #fafbfd;
            outline: none;
            transition: all .2s;
        }

        .form-input-gmt::placeholder { color: #b0bec5; }

        .form-input-gmt:focus {
            border-color: var(--accent);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(74,144,217,.12);
        }

        .form-input-gmt:focus + .input-icon,
        .input-wrapper:focus-within .input-icon {
            color: var(--accent);
        }

        /* Toggle password */
        .toggle-password {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: #b0bec5;
            font-size: 13px;
            padding: 2px;
            border-radius: 4px;
            transition: color .2s;
        }

        .toggle-password:hover { color: var(--accent); }

        /* Recordar / Olvidé */
        .form-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
        }

        .form-check-gmt {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }

        .form-check-gmt input[type="checkbox"] {
            width: 15px; height: 15px;
            accent-color: var(--accent);
            cursor: pointer;
        }

        .form-check-gmt span {
            font-size: 12.5px;
            color: #6b7280;
        }

        .forgot-link {
            font-size: 12.5px;
            font-weight: 600;
            color: var(--accent);
            text-decoration: none;
            transition: color .2s;
        }

        .forgot-link:hover { color: var(--navy); }

        /* Submit button */
        .btn-login {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 100%);
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            font-family: 'Plus Jakarta Sans', sans-serif;
            letter-spacing: .3px;
            cursor: pointer;
            transition: all .2s;
            position: relative;
            overflow: hidden;
        }

        .btn-login::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, var(--accent), var(--navy-mid));
            opacity: 0;
            transition: opacity .25s;
        }

        .btn-login:hover { transform: translateY(-1px); box-shadow: 0 6px 24px rgba(0,35,102,.3); }
        .btn-login:hover::before { opacity: 1; }
        .btn-login:active { transform: translateY(0); }

        .btn-login span { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; gap: 8px; }

        /* Divider */
        .form-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 22px 0;
        }

        .form-divider::before, .form-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #e2e8f0;
        }

        .form-divider span {
            font-size: 11.5px;
            color: #b0bec5;
            font-weight: 500;
            white-space: nowrap;
        }

        /* Footer card */
        .card-footer-gmt {
            margin-top: 24px;
            text-align: center;
            font-size: 12px;
            color: #b0bec5;
        }

        .card-footer-gmt strong {
            color: var(--navy-dark);
            font-weight: 700;
        }

        /* Alert de error */
        .alert-login {
            padding: 10px 14px;
            border-radius: 8px;
            background: #fff5f5;
            border: 1px solid #fed7d7;
            color: #c53030;
            font-size: 12.5px;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 18px;
        }

        /* ── Responsive ──────────────────────────────── */
        @@media (max-width: 767.98px) {
            .login-bg { grid-template-columns: 1fr; }
            .bg-left { display: none; }
            .bg-right { background: linear-gradient(160deg, var(--navy-dark), var(--navy)); }
            .login-card { padding: 36px 28px; }
            .card-title { font-size: 22px; }
        }

        @@media (max-width: 400px) {
            .login-card { padding: 28px 20px; }
        }
    </style>
</head>
<body>

    <!-- Fondo dividido -->
    <div class="login-bg">
        <div class="bg-left">
            <div class="grid-pattern"></div>

            <!-- Panel de marca (solo visible en desktop) -->
            <div class="brand-panel">
                <div class="brand-logo-lg">
                    <i class="fas fa-layer-group"></i>
                </div>

                <div class="brand-tagline-main">
                    Gestión Académica<br>Centralizada
                </div>
                <p class="brand-tagline-sub">
                    Plataforma integral para la administración de residencias,
                    servicio social y titulación institucional.
                </p>

                <!-- Módulos disponibles -->
                <div class="module-pills">
                    <span class="module-pill"><i class="fas fa-handshake"></i> Residencias</span>
                    <span class="module-pill"><i class="fas fa-users"></i> Servicio Social</span>
                    <span class="module-pill"><i class="fas fa-graduation-cap"></i> Titulación</span>
                    <span class="module-pill"><i class="fas fa-chart-pie"></i> Reportes</span>
                </div>

                <div class="version-tag">GMT v1.0.0 · 2024</div>
            </div>
        </div>
        <div class="bg-right"></div>
    </div>

    <!-- ═══ LOGIN CARD ════════════════════════════════════════ -->
    <div class="login-container">
        <div class="login-card">

            <!-- Header -->
            <div class="card-header-gmt">
                <div class="card-eyebrow">
                    <div class="eyebrow-dot"></div>
                    <span class="eyebrow-text">Acceso Institucional</span>
                </div>
                <h1 class="card-title">Bienvenido de nuevo</h1>
                <p class="card-subtitle">Ingresa tus credenciales para continuar</p>
            </div>

            <!-- Alerta de error (oculta por defecto) -->
            <div class="alert-login" id="loginAlert" style="display:none;">
                <i class="fas fa-exclamation-circle"></i>
                <span>Credenciales incorrectas. Verifica e intenta de nuevo.</span>
            </div>

            <!-- Form -->
            <form id="loginForm" action="/Account/Login" method="post">
                @Html.AntiForgeryToken()

                <!-- Email -->
                <div class="form-group-gmt">
                    <label class="form-label-gmt" for="email">Correo institucional</label>
                    <div class="input-wrapper">
                        <input type="email"
                               id="email"
                               name="Email"
                               class="form-input-gmt"
                               placeholder="usuario@instituto.edu.mx"
                               autocomplete="username"
                               required />
                        <i class="fas fa-envelope input-icon"></i>
                    </div>
                </div>

                <!-- Password -->
                <div class="form-group-gmt">
                    <label class="form-label-gmt" for="password">Contraseña</label>
                    <div class="input-wrapper">
                        <input type="password"
                               id="password"
                               name="Password"
                               class="form-input-gmt"
                               placeholder="••••••••"
                               autocomplete="current-password"
                               required />
                        <i class="fas fa-lock input-icon"></i>
                        <button type="button" class="toggle-password" id="togglePwd" title="Ver contraseña">
                            <i class="fas fa-eye" id="pwdIcon"></i>
                        </button>
                    </div>
                </div>

                <!-- Meta row -->
                <div class="form-meta">
                    <label class="form-check-gmt">
                        <input type="checkbox" name="RememberMe" />
                        <span>Mantener sesión</span>
                    </label>
                    <a href="#" class="forgot-link">¿Olvidaste tu contraseña?</a>
                </div>

                <!-- Submit -->
                <button type="submit" class="btn-login" id="btnLogin">
                    <span>
                        <i class="fas fa-arrow-right-to-bracket"></i>
                        Iniciar Sesión
                    </span>
                </button>

                <div class="form-divider">
                    <span>Acceso seguro con cifrado TLS</span>
                </div>

            </form>

            <!-- Footer -->
            <div class="card-footer-gmt">
                ¿Problemas para acceder? Contacta al
                <a href="mailto:soporte@instituto.edu.mx" style="color:var(--accent); text-decoration:none; font-weight:600;">
                    Soporte TI
                </a>
                <br>
                <br>
                <strong>GMT</strong> · Gestor Modular Tecnológico &copy; @DateTime.Now.Year
            </div>

        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // ── Toggle password visibility ───────────────────────
        const toggleBtn = document.getElementById('togglePwd');
        const pwdInput  = document.getElementById('password');
        const pwdIcon   = document.getElementById('pwdIcon');

        toggleBtn?.addEventListener('click', () => {
            const isHidden = pwdInput.type === 'password';
            pwdInput.type  = isHidden ? 'text' : 'password';
            pwdIcon.classList.replace(
                isHidden ? 'fa-eye' : 'fa-eye-slash',
                isHidden ? 'fa-eye-slash' : 'fa-eye'
            );
        });

        // ── Loading state en submit ──────────────────────────
        const form    = document.getElementById('loginForm');
        const btnLog  = document.getElementById('btnLogin');

        form?.addEventListener('submit', (e) => {
            e.preventDefault(); // Quitar en producción con back-end real

            const originalHTML = btnLog.innerHTML;
            btnLog.innerHTML = `<span><i class="fas fa-circle-notch fa-spin"></i> Verificando…</span>`;
            btnLog.disabled = true;

            // Simular petición (demo)
            setTimeout(() => {
                // Para demo: ir al Dashboard
                window.location.href = '/Home/Index';
            }, 1400);
        });
    </script>
</body>
</html>
