@{
    ViewData["Title"] = "¡Cuenta Verificada!";
    // Usa un layout si tienes uno, ej: Layout = "_Layout";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-lg p-5 text-center" style="max-width: 500px; border-radius: 15px;">
        <div class="mb-4">
            <!-- Ícono de check verde -->
            <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="#28a745" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
            </svg>
        </div>
        
        <h2 class="fw-bold mb-3">¡Verificación Exitosa!</h2>
        <p class="text-muted mb-4">
            Tu dirección de correo electrónico ha sido confirmada y tus datos han sido guardados correctamente en nuestro sistema. Ya puedes iniciar sesión con tus credenciales.
        </p>
        
        <a href="@Url.Action("Index", "Account")" class="btn btn-primary btn-lg w-100 fw-bold" style="border-radius: 10px;">
            Ir a Iniciar Sesión
        </a>
    </div>
</div>