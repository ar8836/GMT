<!-- ═══ CONTENT ══════════════════════════════════════════════ -->

<!-- Page Header -->
<div class="page-header fade-up">
    <div class="breadcrumb-gmt">
        <i class="fas fa-home"></i>
        <a href="#">Inicio</a>
        <i class="fas fa-chevron-right" style="font-size:9px;"></i>
        <span>Dashboard</span>
    </div>
    <h1 class="page-title">Panel de Control</h1>
    <p class="page-subtitle">Resumen general del ciclo escolar en curso — Junio 2024</p>
</div>

<!-- ── Stat Cards ──────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    @for (int i = 0; i < stats.Length; i++) {
        var s = stats[i];
        <div class="col-12 col-sm-6 col-xl-3 fade-up stagger-@(i+1)">
            <div class="stat-card @s.BgClass">
                <div class="stat-icon @s.Color">
                    <i class="@s.Icon"></i>
                </div>
                <div class="stat-body">
                    <div class="stat-label">@s.Label</div>
                    <div class="stat-value">@s.Value</div>
                    <div class="stat-footer">
                        <span class="stat-badge @(s.BadgeType == "up" ? "badge-up" : "badge-down")">
                            <i class="fas fa-arrow-@(s.BadgeType == "up" ? "up" : "down")"></i>
                            @s.Badge
                        </span>
                        vs. mes anterior
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- ── Main Grid (tabla + gráfica) ───────────────────────── -->
<div class="row g-3 mb-4">

    <!-- Gráfica de barras (columna izquierda) -->
    <div class="col-12 col-lg-4 fade-up stagger-3">
        <div class="chart-card h-100">
            <div class="section-header">
                <span class="section-title" style="font-size:14px;">Solicitudes / Mes</span>
            </div>

            <!-- Mini bar chart (CSS) -->
            <div class="chart-bars">
                @{
                    var months = new[] {
                        new { Label="Ene", V1=55, V2=40 },
                        new { Label="Feb", V1=68, V2=50 },
                        new { Label="Mar", V1=45, V2=60 },
                        new { Label="Abr", V1=72, V2=55 },
                        new { Label="May", V1=88, V2=70 },
                        new { Label="Jun", V1=100, V2=85 },
                    };
                }
                @foreach (var m in months) {
                    <div class="chart-bar-group">
                        <div class="chart-bars-inner">
                            <div class="c-bar navy" style="height:@(m.V1)px;" title="Residencias: @m.V1"></div>
                            <div class="c-bar blue"  style="height:@(m.V2)px;" title="Serv. Social: @m.V2"></div>
                        </div>
                        <span class="chart-label">@m.Label</span>
                    </div>
                }
            </div>

            <div class="chart-legend">
                <div class="legend-item">
                    <div class="legend-dot" style="background:var(--navy);"></div>
                    Residencias
                </div>
                <div class="legend-item">
                    <div class="legend-dot" style="background:var(--accent);"></div>
                    Servicio Social
                </div>
            </div>
        </div>
    </div>

    <!-- Acciones rápidas -->
    <div class="col-12 col-lg-8 fade-up stagger-4">
        <div class="mb-3">
            <div class="section-header">
                <span class="section-title" style="font-size:14px;">Acciones Rápidas</span>
            </div>
            <div class="row g-2">
                @{
                    var actions = new[] {
                        new { Icon="fas fa-plus-circle",     BgColor="rgba(0,35,102,.08)",   TextColor="var(--navy)",   Label="Nueva Solicitud",          Desc="Crear expediente" },
                        new { Icon="fas fa-search",          BgColor="rgba(13,148,136,.1)",  TextColor="#0d9488",       Label="Buscar Alumno",             Desc="Localizar por matrícula" },
                        new { Icon="fas fa-file-export",     BgColor="rgba(217,119,6,.1)",   TextColor="#d97706",       Label="Exportar Reporte",          Desc="Excel / PDF" },
                        new { Icon="fas fa-calendar-check",  BgColor="rgba(124,58,237,.1)",  TextColor="#7c3aed",       Label="Agendar Revisión",          Desc="Calendario de citas" },
                    };
                }
                @foreach (var a in actions) {
                    <div class="col-6">
                        <a href="#" class="quick-action-card">
                            <div class="qa-icon" style="background:@a.BgColor; color:@a.TextColor;">
                                <i class="@a.Icon"></i>
                            </div>
                            <div class="qa-text">
                                <div class="qa-label">@a.Label</div>
                                <div class="qa-desc">@a.Desc</div>
                            </div>
                            <i class="fas fa-arrow-right" style="color:var(--border); font-size:11px;"></i>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

<!-- ── Tabla de Actividad Reciente ────────────────────────── -->
<div class="fade-up stagger-5">
    <div class="section-header">
        <span class="section-title">Actividad Reciente</span>
        <a href="#" class="btn-view-all">
            Ver todo <i class="fas fa-arrow-right"></i>
        </a>
    </div>

    <div class="gmt-table-wrapper">
        <div class="table-responsive">
            <table class="gmt-table">
                <thead>
                    <tr>
                        <th>Alumno</th>
                        <th>Módulo</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                        <th style="text-align:center;">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in activity) {
                        <tr>
                            <td data-label="Alumno">
                                <div class="student-cell">
                                    <div class="student-avatar" style="background:@row.Color;">@row.Initials</div>
                                    <div>
                                        <div class="student-name">@row.Name</div>
                                        <div class="student-id">@row.Id</div>
                                    </div>
                                </div>
                            </td>
                            <td data-label="Módulo">
                                <span class="module-tag">@row.Module</span>
                            </td>
                            <td data-label="Estado">
                                <span class="status-pill @row.StatusClass">@row.Status</span>
                            </td>
                            <td data-label="Fecha">
                                <span class="time-cell"><i class="fas fa-clock me-1" style="opacity:.5;"></i>@row.Date</span>
                            </td>
                            <td data-label="Acción" style="text-align:center;">
                                <button class="btn btn-sm"
                                        style="background:var(--bg); border:1px solid var(--border);
                                               color:var(--text-secondary); font-size:11.5px; font-weight:600;
                                               padding:4px 12px; border-radius:6px; transition:var(--transition);"
                                        onmouseover="this.style.borderColor='var(--accent)'; this.style.color='var(--accent)';"
                                        onmouseout="this.style.borderColor='var(--border)'; this.style.color='var(--text-secondary)';">
                                    Ver detalle
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer de la tabla -->
        <div style="padding: 14px 20px; background:var(--bg); border-top:1px solid var(--border);
                    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;">
            <span style="font-size:12px; color:var(--text-muted);">
                Mostrando <strong>@activity.Length</strong> de <strong>142</strong> registros
            </span>
            <div style="display:flex; gap:4px;">
                @for (int p = 1; p <= 5; p++) {
                    <button class="btn btn-sm"
                            style="min-width:30px; height:30px; padding:0; font-size:12px; font-weight:600;
                                   border-radius:6px; border:1px solid @(p==1 ? "var(--accent)" : "var(--border)");
                                   background:@(p==1 ? "var(--accent)" : "var(--bg)");
                                   color:@(p==1 ? "#fff" : "var(--text-muted)");">
                        @p
                    </button>
                }
                <button class="btn btn-sm"
                        style="height:30px; padding:0 10px; font-size:12px; font-weight:600;
                               border-radius:6px; border:1px solid var(--border);
                               background:var(--bg); color:var(--text-muted);">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Animar las barras del chart al cargar
    document.addEventListener('DOMContentLoaded', () => {
        const bars = document.querySelectorAll('.c-bar');
        bars.forEach((bar, i) => {
            const finalH = bar.style.height;
            bar.style.height = '0px';
            bar.style.transition = `height .5s cubic-bezier(.4,0,.2,1) ${i * 30}ms`;
            requestAnimationFrame(() => {
                requestAnimationFrame(() => { bar.style.height = finalH; });
            });
        });
    });
</script>
}
