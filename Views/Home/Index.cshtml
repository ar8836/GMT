@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveModule"] = "dashboard";
    ViewData["UserName"] = "Ing. Carlos Mendoza";
    ViewData["UserRole"] = "Coordinador de TI";
}

@* ══════════════════════════════════════════════════════════
   INDEX.CSHTML — Dashboard Principal
   GMT | Gestor Modular Tecnológico
   ══════════════════════════════════════════════════════════ *@

@section Styles {
<style>
    /* ─── Stat Cards ──────────────────────────────────── */
    .stat-card {
        background: var(--bg-card);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        padding: 22px 24px;
        display: flex;
        align-items: flex-start;
        gap: 16px;
        box-shadow: var(--shadow-sm);
        transition: var(--transition);
        position: relative;
        overflow: hidden;
    }

    .stat-card::before {
        content: '';
        position: absolute;
        bottom: 0; left: 0;
        height: 3px;
        width: 100%;
        opacity: 0;
        transition: opacity .3s;
    }

    .stat-card:hover {
        box-shadow: var(--shadow-md);
        transform: translateY(-2px);
    }

    .stat-card:hover::before { opacity: 1; }

    .stat-card.card-blue::before   { background: linear-gradient(90deg, var(--navy), var(--accent)); }
    .stat-card.card-green::before  { background: linear-gradient(90deg, #0d9488, #34d399); }
    .stat-card.card-amber::before  { background: linear-gradient(90deg, #d97706, #fbbf24); }
    .stat-card.card-purple::before { background: linear-gradient(90deg, #7c3aed, #a78bfa); }

    .stat-icon {
        width: 50px; height: 50px;
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .stat-icon.blue   { background: rgba(0,35,102,.08);  color: var(--navy); }
    .stat-icon.green  { background: rgba(13,148,136,.1);  color: #0d9488; }
    .stat-icon.amber  { background: rgba(217,119,6,.1);   color: #d97706; }
    .stat-icon.purple { background: rgba(124,58,237,.1);  color: #7c3aed; }

    .stat-body { flex: 1; min-width: 0; }

    .stat-label {
        font-size: 11.5px;
        font-weight: 600;
        color: var(--text-muted);
        letter-spacing: .5px;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .stat-value {
        font-size: 30px;
        font-weight: 800;
        color: var(--text-primary);
        line-height: 1;
        letter-spacing: -1px;
    }

    .stat-footer {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-top: 8px;
        font-size: 12px;
        color: var(--text-muted);
    }

    .stat-badge {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        font-size: 11px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 20px;
    }

    .badge-up   { background: #dcfce7; color: #16a34a; }
    .badge-down { background: #fef2f2; color: #dc2626; }

    /* ─── Section Header ──────────────────────────────── */
    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }

    .section-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .section-title::before {
        content: '';
        width: 3px; height: 18px;
        background: var(--accent);
        border-radius: 2px;
        display: inline-block;
    }

    .btn-view-all {
        font-size: 12px;
        font-weight: 600;
        color: var(--accent);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: var(--transition);
    }

    .btn-view-all:hover { color: var(--navy); }

    /* ─── Table ───────────────────────────────────────── */
    .gmt-table-wrapper {
        background: var(--bg-card);
        border-radius: var(--radius);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    .gmt-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
    }

    .gmt-table thead th {
        padding: 13px 18px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
        color: var(--text-muted);
        background: var(--bg);
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
    }

    .gmt-table tbody tr {
        border-bottom: 1px solid var(--border);
        transition: background .15s;
    }

    .gmt-table tbody tr:last-child { border-bottom: none; }
    .gmt-table tbody tr:hover { background: rgba(74,144,217,.03); }

    .gmt-table tbody td {
        padding: 14px 18px;
        color: var(--text-primary);
        vertical-align: middle;
    }

    .student-cell {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .student-avatar {
        width: 32px; height: 32px;
        border-radius: 50%;
        font-size: 11.5px;
        font-weight: 700;
        color: #fff;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
        letter-spacing: .3px;
    }

    .student-name {
        font-weight: 600;
        color: var(--text-primary);
        font-size: 13.5px;
    }

    .student-id {
        font-size: 11.5px;
        color: var(--text-muted);
        font-family: 'Space Mono', monospace;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11.5px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-pill::before {
        content: '';
        width: 5px; height: 5px;
        border-radius: 50%;
    }

    .pill-pending  { background: #fef3c7; color: #92400e; }
    .pill-pending::before  { background: #f59e0b; }
    .pill-active   { background: #dcfce7; color: #166534; }
    .pill-active::before   { background: #22c55e; }
    .pill-review   { background: #ede9fe; color: #5b21b6; }
    .pill-review::before   { background: #8b5cf6; }
    .pill-approved { background: #dbeafe; color: #1e40af; }
    .pill-approved::before { background: #3b82f6; }
    .pill-rejected { background: #fee2e2; color: #991b1b; }
    .pill-rejected::before { background: #ef4444; }

    .module-tag {
        font-size: 11.5px;
        color: var(--text-muted);
        background: var(--bg);
        border: 1px solid var(--border);
        padding: 3px 9px;
        border-radius: 6px;
        font-weight: 500;
    }

    .time-cell {
        font-size: 12px;
        color: var(--text-muted);
        white-space: nowrap;
        font-family: 'Space Mono', monospace;
    }

    /* ─── Quick Actions ───────────────────────────────── */
    .quick-action-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        cursor: pointer;
        text-decoration: none;
        transition: var(--transition);
        box-shadow: var(--shadow-sm);
    }

    .quick-action-card:hover {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(74,144,217,.1), var(--shadow-md);
        transform: translateY(-1px);
    }

    .qa-icon {
        width: 42px; height: 42px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
        transition: var(--transition);
    }

    .quick-action-card:hover .qa-icon {
        transform: scale(1.1);
    }

    .qa-text { flex: 1; min-width: 0; }

    .qa-label {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .qa-desc {
        font-size: 11.5px;
        color: var(--text-muted);
        margin-top: 1px;
    }

    /* ─── Chart Placeholder ───────────────────────────── */
    .chart-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 22px 24px;
        box-shadow: var(--shadow-sm);
    }

    .chart-bars {
        display: flex;
        align-items: flex-end;
        gap: 10px;
        height: 100px;
        padding-top: 8px;
    }

    .chart-bar-group {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
    }

    .chart-bars-inner {
        display: flex;
        gap: 3px;
        align-items: flex-end;
        width: 100%;
    }

    .c-bar {
        flex: 1;
        border-radius: 4px 4px 0 0;
        transition: opacity .2s;
    }

    .c-bar:hover { opacity: .75; }

    .c-bar.navy  { background: var(--navy); }
    .c-bar.blue  { background: var(--accent); }

    .chart-label {
        font-size: 10px;
        color: var(--text-muted);
        font-family: 'Space Mono', monospace;
    }

    .chart-legend {
        display: flex;
        gap: 16px;
        margin-top: 14px;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        color: var(--text-secondary);
    }

    .legend-dot {
        width: 8px; height: 8px;
        border-radius: 2px;
    }

    /* ─── Fade-up stagger ─────────────────────────────── */
    .stagger-1 { animation-delay: .05s; }
    .stagger-2 { animation-delay: .10s; }
    .stagger-3 { animation-delay: .15s; }
    .stagger-4 { animation-delay: .20s; }
    .stagger-5 { animation-delay: .25s; }
    .stagger-6 { animation-delay: .30s; }

    /* ─── Responsive ──────────────────────────────────── */
    @@media (max-width: 575.98px) {
        .stat-value { font-size: 24px; }
        .gmt-table thead { display: none; }
        .gmt-table tbody tr { display: block; padding: 10px 0; border-bottom: 1px solid var(--border); }
        .gmt-table tbody td { display: flex; padding: 5px 16px; }
        .gmt-table tbody td::before {
            content: attr(data-label);
            font-weight: 700;
            color: var(--text-muted);
            font-size: 11px;
            min-width: 90px;
            text-transform: uppercase;
        }
    }
</style>
}

