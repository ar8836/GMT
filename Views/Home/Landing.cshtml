<!-- ══════════════════════════════════════════════════
     PARA ESTUDIANTES
══════════════════════════════════════════════════ -->
<section class="features-section" id="para-estudiantes">
    <div class="container">
        <div class="row align-items-center g-5">

            <div class="col-12 col-lg-5 reveal">
                <span class="actor-pill pill-student">
                    <i class="fas fa-user-graduate fa-sm"></i> Para Estudiantes
                </span>
                <!--
                <div class="section-label">Módulo Alumno</div>
                -->
                <h2 class="section-title">
                    Menos ventanillas,<br/>
                    <span class="gradient-text">más oportunidades.</span>
                </h2>
                <p style="color:var(--text-muted); font-size:.95rem; line-height:1.75; margin-bottom:2rem;">
                    Desde tu cuenta GMT puedes gestionar toda tu documentación de
                    residencias y servicio social, subir archivos a la nube y postularte
                    a vacantes de empresas verificadas — sin salir de casa.
                </p>
                <a href="/Account/Index?perfil=alumno&modo=register" class="btn-grad">
                    <i class="fas fa-arrow-right"></i> Crear cuenta de alumno
                </a>
            </div>

            <div class="col-12 col-lg-7">
                <div class="row g-3">
                    @{
                        var featAlumno = new[] {
                            new { Icon="fas fa-file-circle-check", IconClass="icon-cyan",   Title="Documentos en la nube",       Desc="Sube tu carta de presentación, kardex y demás documentos al sistema. Sin fotocopias." },
                            new { Icon="fas fa-magnifying-glass",  IconClass="icon-violet",  Title="Encuentra tu empresa ideal",  Desc="Explora vacantes de residencia y servicio social filtradas por carrera y créditos." },
                            new { Icon="fas fa-circle-check",      IconClass="icon-green",   Title="Validación automática",       Desc="El sistema verifica si cumples el 70% de créditos sin que tengas que ir a Servicios Escolares." },
                            new { Icon="fas fa-bell",              IconClass="icon-amber",   Title="Seguimiento en tiempo real",  Desc="Recibe notificaciones por correo en cada paso de tu proceso de titulación o residencia." },
                        };
                    }
                    @foreach (var (f, i) in featAlumno.Select((f, i) => (f, i))) {
                        <div class="col-12 col-sm-6 reveal reveal-delay-@(i+1)">
                            <div class="feature-card">
                                <div class="feature-icon @f.IconClass">
                                    <i class="@f.Icon"></i>
                                </div>
                                <div class="feature-title">@f.Title</div>
                                <div class="feature-text">@f.Desc</div>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</section>

<div class="glow-divider"></div>

<!-- ══════════════════════════════════════════════════
     PARA EMPRESAS
══════════════════════════════════════════════════ -->
