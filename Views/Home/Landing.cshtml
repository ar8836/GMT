                        var featEmpresa = new[] {
                            new { Icon="fas fa-bullhorn",          IconClass="icon-violet", Title="Publica vacantes fácilmente",  Desc="Crea una convocatoria de prácticas o servicio social en minutos con toda la información relevante." },
                            new { Icon="fas fa-filter",            IconClass="icon-cyan",   Title="Candidatos pre-filtrados",     Desc="Solo alumnos con los créditos requeridos pueden postularse. Olvídate de la preselección." },
                            new { Icon="fas fa-file-contract",     IconClass="icon-green",  Title="Convenios digitales",          Desc="Gestiona la documentación del convenio empresa-TecNM sin trámites en papel." },
                            new { Icon="fas fa-chart-pie",         IconClass="icon-amber",  Title="Métricas e informes",          Desc="Accede a estadísticas de postulaciones, perfiles y resultados de cada convocatoria." },
