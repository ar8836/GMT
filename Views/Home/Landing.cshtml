</section>

<div class="glow-divider"></div>

<!-- ══════════════════════════════════════════════════
     CÓMO FUNCIONA
══════════════════════════════════════════════════ -->
<section class="how-section" id="como-funciona">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <!--
            <div class="section-label">Proceso simplificado</div>
            -->
            <h2 class="section-title">Cómo funciona GMT</h2>
            <p style="color:var(--text-muted); max-width:520px; margin:0 auto; font-size:.95rem;">
                Tres pasos simples para digitalizar tu trámite académico y olvidarte del papeleo.
            </p>
        </div>

        <div class="row g-4">
            <!-- Columna Alumnos -->
            <div class="col-12 col-lg-6 reveal">
                <div class="actor-pill pill-student mb-3">
                    <i class="fas fa-user-graduate fa-sm"></i> Ruta del Alumno
                </div>
                <div class="d-flex flex-column gap-3">
                    @{
                        var stepsAlumno = new[] {
                            new { N="1", Title="Crea tu cuenta institucional", Desc="Regístrate con tu correo @acapulco.tecnm.mx. El sistema verifica automáticamente que seas alumno activo del TecNM." },
                            new { N="2", Title="Sube tus documentos",          Desc="Carga tu carta de presentación, kardex y seguro social. Todo queda almacenado de forma segura en AWS S3." },
                            new { N="3", Title="Postúlate y da seguimiento",   Desc="Explora vacantes que coincidan con tu perfil y créditos. Recibe actualizaciones por correo en cada etapa." },
                        };
                    }
                    @foreach (var s in stepsAlumno) {
                        <div class="step-card reveal">
                            <div class="step-number">@s.N</div>
                            <div class="step-content">
                                <h4>@s.Title</h4>
                                <p>@s.Desc</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Columna Empresas -->
            <div class="col-12 col-lg-6 reveal reveal-delay-2">
                <div class="actor-pill pill-company mb-3">
                    <i class="fas fa-building fa-sm"></i> Ruta de la Empresa
                </div>
                <div class="d-flex flex-column gap-3">
                    @{
                        var stepsEmpresa = new[] {
                            new { N="1", Title="Registra tu empresa",       Desc="Crea una cuenta empresarial y adjunta tu Constancia de Situación Fiscal (RFC). El administrador valida tu registro." },
                            new { N="2", Title="Publica tu vacante",        Desc="Describe el perfil que necesitas, la carrera requerida, el apoyo económico y la duración de la práctica." },
                            new { N="3", Title="Selecciona a tu practicante", Desc="Recibe solicitudes de alumnos pre-validados. Revisa perfiles, toma tu decisión y firma el convenio digital." },
                        };
                    }
                    @foreach (var s in stepsEmpresa) {
                        <div class="step-card reveal">
                            <div class="step-number">@s.N</div>
                            <div class="step-content">
                                <h4>@s.Title</h4>
                                <p>@s.Desc</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<div class="glow-divider"></div>

<!-- ══════════════════════════════════════════════════
     TECH STACK
══════════════════════════════════════════════════ -->
<section class="tech-section">
    <div class="container text-center">
        <p class="section-label reveal">Tecnología de respaldo</p>
        <h3 class="mb-4 reveal" style="font-size:1.3rem; font-weight:600; color:var(--text-muted);">
            Construido con infraestructura empresarial de primer nivel
        </h3>
        <div class="d-flex flex-wrap justify-content-center gap-3 reveal">
            @{
                var techs = new[] {
                    new { Icon="fab fa-microsoft", Label=".NET 9 / ASP.NET MVC" },
                    new { Icon="fas fa-database",  Label="PostgreSQL en AWS RDS" },
                    new { Icon="fab fa-aws",        Label="Amazon S3 (archivos)" },
                    new { Icon="fas fa-envelope",   Label="Amazon SES (email)" },
                    new { Icon="fas fa-server",     Label="AWS EC2 (Arch Linux)" },
                    new { Icon="fas fa-lock",       Label="BCrypt + HTTPS / SSL" },
                    new { Icon="fab fa-cloudflare", Label="Cloudflare CDN" },
                    new { Icon="fab fa-git-alt",    Label="Git / GitHub" },
                };
            }
            @foreach (var t in techs) {
                <span class="tech-badge">
                    <i class="@t.Icon" style="color:var(--cyan);"></i>
                    @t.Label
                </span>
            }
        </div>
    </div>
</section>

<div class="glow-divider"></div>

<!-- ══════════════════════════════════════════════════
     SOBRE NOSOTROS
══════════════════════════════════════════════════ -->
<section class="about-section" id="nosotros">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <!--
            <div class="section-label">Sobre el proyecto</div>
            -->
            <h2 class="section-title">Hechos por estudiantes,<br/><span class="gradient-text">para estudiantes.</span></h2>
        </div>

        <div class="row g-4 align-items-start">

            <div class="col-12 col-lg-7 reveal">
                <div class="about-card">
                    <h3 style="font-size:1.3rem; margin-bottom:1rem;">
                        <i class="fas fa-bullseye text-cyan me-2"></i>Nuestra misión
                    </h3>
                    <p style="color:var(--text-muted); font-size:.93rem; line-height:1.8; margin-bottom:1.5rem;">
                        GMT nació en el <strong style="color:var(--text-primary);">Instituto Tecnológico de Acapulco (TecNM Campus Acapulco)</strong>
                        como proyecto de Ingeniería de Software para resolver una problemática real:
                        los procesos de residencias profesionales, servicio social y titulación
                        dependían de trámites físicos, grupos de WhatsApp y revisiones manuales que
                        tardaban semanas.
                    </p>
                    <p style="color:var(--text-muted); font-size:.93rem; line-height:1.8; margin-bottom:1.5rem;">
                        Nuestra solución es una plataforma web que actúa como complemento digital del
                        sistema Ámbar del TecNM, automatizando la validación de elegibilidad académica
                        (70% de créditos y 5 complementarios), centralizando documentos en la nube y
                        conectando estudiantes con empresas aliadas de manera transparente y eficiente.
                    </p>

                    <!-- Equipo -->
                    <div style="margin-top:1.75rem;">
                        <p style="font-size:.78rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--text-faint); margin-bottom:.75rem;">
                            Equipo de desarrollo — ISC TecNM Acapulco
                        </p>
                        <div>
                            @{
                                var team = new[] {
                                    new { Name="Alex B. Ramírez Arizmendi",   Init="AB" },
                                    new { Name="Amilcar Magdaleno Muñoz",     Init="AM" },
                                    new { Name="Ariel Rubio Morales",        Init="AR" },
                                    new { Name="Kenya A. Pacheco García",    Init="KA" },
                                    new { Name="Naomi Pacheco Chavez",       Init="NP" },
                                };
                            }
                            @foreach (var m in team) {
                                <span class="team-chip">
                                    <div class="avatar">@m.Init</div>
                                    @m.Name
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="d-flex flex-column gap-3">
                    @{
                        var values = new[] {
                            new { Icon="fas fa-people-group", Color="var(--cyan)",          Title="Inclusión",     Desc="Diseñado para que todos los alumnos del TecNM puedan acceder a sus oportunidades de práctica sin barreras burocráticas." },
                            new { Icon="fas fa-shield-halved",Color="var(--violet-light)",  Title="Seguridad",     Desc="Toda la información personal y académica es cifrada y almacenada con estándares de seguridad de nivel empresarial." },
                            new { Icon="fas fa-leaf",          Color="#4ade80",              Title="Sostenibilidad",Desc="Reducción del uso de papel y desplazamientos innecesarios, contribuyendo al campus más verde del TecNM." },
                        };
                    }
                    @foreach (var (v, i) in values.Select((v, i) => (v, i))) {
                        <div class="feature-card reveal reveal-delay-@(i+1)">
                            <div style="display:flex; align-items:center; gap:.75rem; margin-bottom:.75rem;">
                                <i class="@v.Icon" style="color:@v.Color; font-size:1.1rem;"></i>
                                <strong style="font-size:.95rem;">@v.Title</strong>
                            </div>
                            <p class="feature-text">@v.Desc</p>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</section>

<div class="glow-divider"></div>

<!-- ══════════════════════════════════════════════════
     FAQ
══════════════════════════════════════════════════ -->
<section class="faq-section" id="faq">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <!--
            <div class="section-label">Preguntas frecuentes</div>
            -->
            <h2 class="section-title">Todo lo que necesitas saber</h2>
        </div>

        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                @{
                    var faqs = new[] {
                        new { Q="¿Quién puede usar GMT?",
                              A="Cualquier alumno activo del Instituto Tecnológico de Acapulco (TecNM Campus Acapulco) con correo institucional @acapulco.tecnm.mx, así como empresas registradas con RFC válido que deseen publicar vacantes de prácticas." },
                        new { Q="¿Necesito ir a la escuela para tramitar mis residencias?",
                              A="No. GMT digitaliza todo el flujo: desde subir documentos hasta postularte a una empresa. En algunos casos el departamento de Vinculación puede requerir tu presencia para firmar convenios físicos, pero la mayoría del proceso se puede gestionar en línea." },
                        new { Q="¿Cómo sabe GMT si ya cuento con los créditos suficientes?",
                              A="Nuestro sistema consulta automáticamente la base de datos académica (Ámbar 2, réplica del sistema institucional Ámbar) y verifica que tengas al menos el 70% de créditos cursados y 5 créditos complementarios antes de mostrarte vacantes disponibles." },
                        new { Q="¿Mis documentos están seguros en la plataforma?",
                              A="Sí. Todos los archivos se almacenan en Amazon S3 con políticas de acceso controlado. Los documentos personales son privados y solo accesibles por ti y por los administradores autorizados. Las comunicaciones van cifradas con HTTPS/SSL." },
                        new { Q="¿Cómo se verifica que una empresa es legítima?",
                              A="Las empresas deben adjuntar su Constancia de Situación Fiscal (RFC) al registrarse. Un administrador del sistema revisa y aprueba manualmente cada cuenta empresarial antes de que puedan publicar vacantes. Solo empresas verificadas aparecen en el portal." },
                        new { Q="¿GMT reemplaza a Ámbar o al departamento de Vinculación?",
                              A="No. GMT es un complemento que automatiza y digitaliza el proceso de vinculación, pero sigue trabajando junto al sistema Ámbar y al departamento de Vinculación del TecNM. No modifica ni sustituye los sistemas institucionales existentes." },
                        new { Q="¿Es gratuito para los estudiantes?",
                              A="Sí, totalmente. GMT es una plataforma institucional sin costo para alumnos del TecNM Campus Acapulco. Las empresas tampoco pagan comisión por publicar vacantes durante la fase actual del proyecto." },
                        new { Q="¿Qué hago si tengo problemas para registrarme o acceder?",
                              A="Puedes contactar al equipo de soporte escribiendo a la dirección de correo institucional del Departamento de TI del Campus. También puedes reportar incidencias directamente desde la sección de Soporte en tu perfil una vez dentro de la plataforma." },
                    };
                }
                @foreach (var (faq, idx) in faqs.Select((f, i) => (f, i))) {
                    <div class="faq-item reveal" data-faq="@idx">
                        <div class="faq-question" onclick="toggleFaq(@idx)">
                            <span>@faq.Q</span>
                            <div class="faq-icon" id="faq-icon-@idx">
                                <i class="fas fa-plus"></i>
                            </div>
                        </div>
                        <div class="faq-answer" id="faq-answer-@idx">
                            @faq.A
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

