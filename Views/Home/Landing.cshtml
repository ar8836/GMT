@{
    ViewData["Title"] = "GMT — Gestor Modular Tecnológico | TecNM Acapulco";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="GMT digitaliza los trámites de servicio social, residencias profesionales y titulación del TecNM Campus Acapulco. Conecta estudiantes con empresas en minutos." />
    <meta name="keywords" content="residencias profesionales, servicio social, titulación, TecNM, Acapulco, prácticas profesionales" />
    <title>@ViewData["Title"]</title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700;800&family=DM+Sans:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <style>
        /* ════════════════════════════════════════════════
           CSS VARIABLES — mismo sistema que el login
        ════════════════════════════════════════════════ */
        :root {
            --navy-900:     #040d1a;
            --navy-800:     #071428;
            --navy-700:     #0a1e3d;
            --navy-600:     #0f2d5a;
            --navy-500:     #1a3f73;
            --cyan:         #06b6d4;
            --cyan-light:   #22d3ee;
            --cyan-glow:    rgba(6,182,212,.25);
            --violet:       #7c3aed;
            --violet-light: #a78bfa;
            --violet-glow:  rgba(124,58,237,.2);
            --glass-bg:     rgba(255,255,255,.06);
            --glass-border: rgba(255,255,255,.1);
            --glass-hover:  rgba(255,255,255,.1);
            --text-primary: #f1f5f9;
            --text-muted:   rgba(241,245,249,.55);
            --text-faint:   rgba(241,245,249,.35);
            --section-alt:  rgba(6,182,212,.04);
            --radius-lg:    1.5rem;
            --radius-md:    1rem;
            --radius-sm:    .75rem;
        }

        /* ════════════════════════════════════════════════
           BASE
        ════════════════════════════════════════════════ */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html { scroll-behavior: smooth; }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--navy-800);
            color: var(--text-primary);
            line-height: 1.7;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5 { font-family: 'Sora', sans-serif; }

        /* Background global con gradiente navy (NO negro) */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse 120% 80% at 10% 0%, rgba(6,182,212,.12) 0%, transparent 55%),
                radial-gradient(ellipse 80%  60% at 90% 100%, rgba(124,58,237,.12) 0%, transparent 55%),
                linear-gradient(160deg, var(--navy-900) 0%, var(--navy-700) 45%, var(--navy-600) 100%);
            z-index: -1;
        }

        /* Dot grid texture */
        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.04) 1px, transparent 1px);
            background-size: 32px 32px;
            z-index: -1;
        }

        /* ════════════════════════════════════════════════
           UTILITIES
        ════════════════════════════════════════════════ */
        .text-cyan   { color: var(--cyan) !important; }
        .text-violet { color: var(--violet-light) !important; }
        .text-muted-custom { color: var(--text-muted); }

        .gradient-text {
            background: linear-gradient(90deg, var(--cyan), var(--violet-light));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .glass {
            background: var(--glass-bg);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid var(--glass-border);
        }

        .btn-grad {
            background: linear-gradient(90deg, var(--cyan), var(--violet));
            border: none;
            border-radius: var(--radius-sm);
            color: #fff;
            font-family: 'Sora', sans-serif;
            font-weight: 600;
            padding: .75rem 1.75rem;
            transition: all .3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: .5rem;
        }

        .btn-grad:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(6,182,212,.35);
            color: #fff;
        }

        /* Empresa: degradado invertido (violet → cyan, derecha a izquierda) */
        .btn-grad-empresa {
            background: linear-gradient(90deg, var(--violet), var(--cyan));
            border: none;
            border-radius: var(--radius-sm);
            color: #fff;
            font-family: 'Sora', sans-serif;
            font-weight: 600;
            padding: .75rem 1.75rem;
            transition: all .3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: .5rem;
        }

        .btn-grad-empresa:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(124,58,237,.4);
            color: #fff;
        }

        .btn-outline-glass {
            background: transparent;
            border: 1.5px solid var(--glass-border);
            border-radius: var(--radius-sm);
            color: var(--text-primary);
            font-family: 'Sora', sans-serif;
            font-weight: 500;
            padding: .75rem 1.75rem;
            transition: all .3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: .5rem;
        }

        .btn-outline-glass:hover {
            border-color: var(--cyan);
            color: var(--cyan);
            background: var(--cyan-glow);
        }

        .section-label {
            font-family: 'Space Mono', monospace;
            font-size: .72rem;
            letter-spacing: .2em;
            text-transform: uppercase;
            color: var(--cyan);
            margin-bottom: .75rem;
        }

        .section-title {
            font-size: clamp(1.8rem, 4vw, 2.8rem);
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 1rem;
        }

        /* Divider glow */
        .glow-divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--cyan), var(--violet), transparent);
            opacity: .35;
            margin: 0;
        }

        /* ════════════════════════════════════════════════
           NAVBAR
        ════════════════════════════════════════════════ */
        .gmt-nav {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 1000;
            padding: 1rem 2rem;
            background: rgba(4,13,26,.75);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--glass-border);
            transition: background .3s ease;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: .75rem;
            text-decoration: none;
        }

        .nav-logo-box {
            width: 38px; height: 38px;
            background: linear-gradient(135deg, var(--cyan), var(--violet));
            border-radius: .65rem;
            display: flex; align-items: center; justify-content: center;
            font-family: 'Sora', sans-serif;
            font-weight: 800;
            font-size: .8rem;
            color: #fff;
            letter-spacing: .05em;
        }

        .nav-brand-text { font-family: 'Sora', sans-serif; font-weight: 700; font-size: 1.1rem; color: #fff; }
        .nav-brand-sub  { font-size: .65rem; color: var(--text-muted); letter-spacing: .05em; display: block; line-height: 1; }

        .nav-links {
            display: flex;
            align-items: center;
            gap: .25rem;
            list-style: none;
        }

        .nav-links a {
            padding: .4rem .9rem;
            border-radius: var(--radius-sm);
            color: var(--text-muted);
            text-decoration: none;
            font-size: .88rem;
            font-weight: 500;
            transition: all .25s;
        }

        .nav-links a:hover { color: var(--cyan); background: var(--glass-bg); }

        .nav-cta {
            display: flex;
            align-items: center;
            gap: .75rem;
        }

        .hamburger { display: none; background: none; border: none; color: #fff; font-size: 1.4rem; cursor: pointer; }

        @@media (max-width: 768px) {
            .nav-links, .nav-cta .btn-outline-glass { display: none; }
            .hamburger { display: block; }
        }

        /* ════════════════════════════════════════════════
           HERO
        ════════════════════════════════════════════════ */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 7rem 0 5rem;
            position: relative;
        }

        /* Orb animado detrás del hero */
        .hero-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            animation: orbFloat 8s ease-in-out infinite;
            pointer-events: none;
        }

        .orb-1 {
            width: 520px; height: 520px;
            background: radial-gradient(circle, var(--cyan-glow) 0%, transparent 65%);
            top: -100px; right: -150px;
        }

        .orb-2 {
            width: 380px; height: 380px;
            background: radial-gradient(circle, var(--violet-glow) 0%, transparent 65%);
            bottom: 0; left: -100px;
            animation-delay: -4s;
        }

        @@keyframes orbFloat {
            0%, 100% { transform: translateY(0) scale(1); }
            50%       { transform: translateY(-30px) scale(1.05); }
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            background: rgba(6,182,212,.1);
            border: 1px solid rgba(6,182,212,.25);
            border-radius: 2rem;
            padding: .35rem 1rem;
            font-size: .8rem;
            font-weight: 600;
            color: var(--cyan-light);
            margin-bottom: 1.75rem;
        }

        .hero-badge .dot {
            width: 6px; height: 6px;
            border-radius: 50%;
            background: var(--cyan);
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50%       { opacity: .4; transform: scale(.7); }
        }

        .hero-title {
            font-size: clamp(2.5rem, 6vw, 4.5rem);
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 1.5rem;
        }

        .hero-subtitle {
            font-size: 1.1rem;
            color: var(--text-muted);
            max-width: 520px;
            margin-bottom: 2.5rem;
            line-height: 1.75;
        }

        .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 3.5rem; }

        /* Social proof bar */
        .social-proof {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .proof-item {
            display: flex;
            align-items: center;
            gap: .5rem;
            font-size: .82rem;
            color: var(--text-muted);
        }

        .proof-item i { color: var(--cyan); }

        /* Mockup card */
        .hero-mockup {
            position: relative;
        }

        .mockup-card {
            background: linear-gradient(145deg, rgba(10,30,61,.9), rgba(7,20,40,.95));
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-lg);
            padding: 1.75rem;
            box-shadow:
                0 0 0 1px rgba(255,255,255,.05),
                0 24px 64px rgba(0,0,0,.5),
                0 0 80px rgba(6,182,212,.1);
            animation: cardFloat 6s ease-in-out infinite;
        }

        @@keyframes cardFloat {
            0%, 100% { transform: translateY(0) rotate3d(0,1,0,0deg); }
            50%       { transform: translateY(-10px) rotate3d(0,1,0,1deg); }
        }

        .mockup-header {
            display: flex; align-items: center;
            gap: .5rem; margin-bottom: 1.25rem;
        }

        .mockup-dot { width: 10px; height: 10px; border-radius: 50%; }

        .mockup-stat {
            background: rgba(6,182,212,.08);
            border: 1px solid rgba(6,182,212,.15);
            border-radius: .75rem;
            padding: .75rem 1rem;
            margin-bottom: .75rem;
            display: flex; align-items: center; gap: .75rem;
        }

        .mockup-stat-icon {
            width: 36px; height: 36px;
            background: linear-gradient(135deg, var(--cyan), var(--violet));
            border-radius: .5rem;
            display: flex; align-items: center; justify-content: center;
            font-size: .85rem;
            color: #fff;
            flex-shrink: 0;
        }

        .mockup-stat-label { font-size: .72rem; color: var(--text-faint); }
        .mockup-stat-value { font-family: 'Sora', sans-serif; font-weight: 700; font-size: 1.1rem; color: #fff; }

        .mockup-badge-row {
            display: flex; gap: .5rem; flex-wrap: wrap; margin-top: 1rem;
        }

        .mockup-badge {
            font-size: .68rem; font-weight: 600;
            padding: .25rem .6rem;
            border-radius: 20px;
        }

        .badge-cyan   { background: rgba(6,182,212,.15); color: var(--cyan-light); }
        .badge-violet { background: rgba(124,58,237,.15); color: var(--violet-light); }
        .badge-green  { background: rgba(34,197,94,.12); color: #4ade80; }

        /* ════════════════════════════════════════════════
           STATS BAR
        ════════════════════════════════════════════════ */
        .stats-bar {
            padding: 2.5rem 0;
            border-top: 1px solid var(--glass-border);
            border-bottom: 1px solid var(--glass-border);
            background: rgba(6,182,212,.03);
        }

        .stat-item { text-align: center; }

        .stat-number {
            font-family: 'Sora', sans-serif;
            font-size: 2.2rem;
            font-weight: 800;
            background: linear-gradient(90deg, var(--cyan), var(--violet-light));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: block;
        }

        .stat-desc { font-size: .82rem; color: var(--text-muted); margin-top: .15rem; }

        /* ════════════════════════════════════════════════
           FEATURE SECTIONS
        ════════════════════════════════════════════════ */
        .features-section { padding: 6rem 0; }

        .feature-card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-lg);
            padding: 2rem;
            transition: all .35s ease;
            height: 100%;
        }

        .feature-card:hover {
            border-color: rgba(6,182,212,.35);
            transform: translateY(-4px);
            box-shadow: 0 16px 48px rgba(0,0,0,.3), 0 0 32px rgba(6,182,212,.07);
        }

        .feature-icon {
            width: 52px; height: 52px;
            border-radius: .9rem;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.3rem;
            margin-bottom: 1.25rem;
        }

        .icon-cyan   { background: rgba(6,182,212,.12); color: var(--cyan); }
        .icon-violet { background: rgba(124,58,237,.12); color: var(--violet-light); }
        .icon-green  { background: rgba(34,197,94,.1);  color: #4ade80; }
        .icon-amber  { background: rgba(251,191,36,.1); color: #fbbf24; }

        .feature-title {
            font-size: 1.05rem;
            font-weight: 700;
            margin-bottom: .5rem;
            color: var(--text-primary);
        }

        .feature-text { font-size: .88rem; color: var(--text-muted); line-height: 1.65; }

        /* Actor pill */
        .actor-pill {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            padding: .3rem .9rem;
            border-radius: 2rem;
            font-size: .78rem;
            font-weight: 700;
            letter-spacing: .03em;
            margin-bottom: 1.5rem;
        }

        .pill-student { background: rgba(6,182,212,.1); border: 1px solid rgba(6,182,212,.25); color: var(--cyan-light); }
        .pill-company { background: rgba(124,58,237,.1); border: 1px solid rgba(124,58,237,.25); color: var(--violet-light); }

        /* ════════════════════════════════════════════════
           HOW IT WORKS
        ════════════════════════════════════════════════ */
        .how-section { padding: 6rem 0; background: rgba(6,182,212,.025); }

        .step-card {
            display: flex;
            gap: 1.25rem;
            align-items: flex-start;
            padding: 1.75rem;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-md);
            transition: all .3s ease;
        }

        .step-card:hover { border-color: rgba(6,182,212,.3); transform: translateX(4px); }

        .step-number {
            font-family: 'Space Mono', monospace;
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .1em;
            color: var(--cyan);
            background: rgba(6,182,212,.1);
            border: 1px solid rgba(6,182,212,.25);
            border-radius: .5rem;
            padding: .35rem .65rem;
            flex-shrink: 0;
        }

        .step-content h4 { font-size: 1rem; font-weight: 700; margin-bottom: .4rem; }
        .step-content p  { font-size: .87rem; color: var(--text-muted); margin: 0; line-height: 1.65; }

        /* ════════════════════════════════════════════════
           TECH STACK
        ════════════════════════════════════════════════ */
        .tech-section { padding: 4rem 0; }

        .tech-badge {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-sm);
            padding: .6rem 1.1rem;
            font-size: .85rem;
            font-weight: 600;
            color: var(--text-muted);
            transition: all .25s;
        }

        .tech-badge:hover { border-color: var(--cyan); color: var(--cyan); background: rgba(6,182,212,.07); }
        .tech-badge i { font-size: .95rem; }

        /* ════════════════════════════════════════════════
           ABOUT
        ════════════════════════════════════════════════ */
        .about-section { padding: 6rem 0; }

        .about-card {
            background: linear-gradient(145deg, rgba(10,30,61,.6), rgba(7,20,40,.7));
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-lg);
            padding: 3rem;
        }

        .team-chip {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 2rem;
            padding: .35rem .9rem;
            font-size: .8rem;
            color: var(--text-muted);
            margin: .25rem;
        }

        .team-chip .avatar {
            width: 22px; height: 22px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--cyan), var(--violet));
            display: flex; align-items: center; justify-content: center;
            font-size: .58rem; font-weight: 700; color: #fff;
        }

        /* ════════════════════════════════════════════════
           FAQ
        ════════════════════════════════════════════════ */
        .faq-section { padding: 6rem 0; background: rgba(124,58,237,.03); }

        .faq-item {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-md);
            margin-bottom: .75rem;
            overflow: hidden;
            transition: border-color .25s;
        }

        .faq-item.open { border-color: rgba(6,182,212,.3); }

        .faq-question {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.1rem 1.5rem;
            cursor: pointer;
            font-weight: 600;
            font-size: .95rem;
            color: var(--text-primary);
            user-select: none;
        }

        .faq-question:hover { color: var(--cyan); }

        .faq-icon {
            width: 24px; height: 24px;
            border-radius: 50%;
            background: rgba(6,182,212,.1);
            border: 1px solid rgba(6,182,212,.2);
            display: flex; align-items: center; justify-content: center;
            font-size: .7rem;
            color: var(--cyan);
            flex-shrink: 0;
            transition: transform .3s ease;
        }

        .faq-item.open .faq-icon { transform: rotate(45deg); }

        .faq-answer {
            display: none;
            padding: 0 1.5rem 1.25rem;
            font-size: .88rem;
            color: var(--text-muted);
            line-height: 1.7;
        }

        /* ════════════════════════════════════════════════
           PRIVACY / LEGAL
        ════════════════════════════════════════════════ */
        .legal-section { padding: 6rem 0; }

        .legal-card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-lg);
            padding: 2.5rem;
        }

        .legal-card h3 {
            font-size: 1.2rem;
            margin-bottom: 1rem;
            color: var(--text-primary);
        }

        .legal-card p, .legal-card li {
            font-size: .87rem;
            color: var(--text-muted);
            line-height: 1.7;
        }

        .legal-card ul { padding-left: 1.25rem; margin-bottom: 0; }
        .legal-card ul li { margin-bottom: .4rem; }

        /* ════════════════════════════════════════════════
           CTA FINAL
        ════════════════════════════════════════════════ */
        .cta-section {
            padding: 6rem 0;
            text-align: center;
            position: relative;
        }

        .cta-card {
            background: linear-gradient(135deg, rgba(6,182,212,.1), rgba(124,58,237,.1));
            border: 1px solid var(--glass-border);
            border-radius: 2rem;
            padding: 4rem 2rem;
            position: relative;
            overflow: hidden;
        }

        .cta-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 60% 80% at 50% 100%, rgba(6,182,212,.08) 0%, transparent 65%);
        }

        /* ════════════════════════════════════════════════
           FOOTER
        ════════════════════════════════════════════════ */
        .gmt-footer {
            background: rgba(4,13,26,.8);
            border-top: 1px solid var(--glass-border);
            padding: 3.5rem 0 2rem;
        }

        .footer-brand { margin-bottom: 1rem; }

        .footer-desc {
            font-size: .85rem;
            color: var(--text-muted);
            max-width: 260px;
            line-height: 1.65;
        }

        .footer-col-title {
            font-family: 'Sora', sans-serif;
            font-size: .8rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--text-faint);
            margin-bottom: 1rem;
        }

        .footer-links { list-style: none; padding: 0; }

        .footer-links li { margin-bottom: .5rem; }

        .footer-links a {
            font-size: .87rem;
            color: var(--text-muted);
            text-decoration: none;
            transition: color .2s;
        }

        .footer-links a:hover { color: var(--cyan); }

        .footer-bottom {
            margin-top: 3rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--glass-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: .75rem;
        }

        .footer-bottom p { font-size: .8rem; color: var(--text-faint); margin: 0; }

        .footer-legal { display: flex; gap: 1.25rem; }

        .footer-legal a {
            font-size: .78rem;
            color: var(--text-faint);
            text-decoration: none;
            transition: color .2s;
        }

        .footer-legal a:hover { color: var(--cyan); }

        /* ════════════════════════════════════════════════
           SCROLL REVEAL
        ════════════════════════════════════════════════ */
        .reveal {
            opacity: 0;
            transform: translateY(28px);
            transition: opacity .65s ease, transform .65s ease;
        }

        .reveal.visible { opacity: 1; transform: translateY(0); }

        .reveal-delay-1 { transition-delay: .1s; }
        .reveal-delay-2 { transition-delay: .2s; }
        .reveal-delay-3 { transition-delay: .3s; }
        .reveal-delay-4 { transition-delay: .4s; }

        /* ════════════════════════════════════════════════
           RESPONSIVE
        ════════════════════════════════════════════════ */
        @@media (max-width: 991.98px) {
            .hero { padding: 6rem 0 4rem; }
            .hero-mockup { margin-top: 3rem; }
            .gmt-nav { padding: .9rem 1.25rem; }
        }

        @@media (max-width: 575.98px) {
            .about-card { padding: 2rem 1.5rem; }
            .cta-card { padding: 3rem 1.5rem; }
            .footer-bottom { justify-content: center; text-align: center; }
            .footer-legal { flex-wrap: wrap; justify-content: center; }
        }
    </style>
</head>
